+// Keeps one .excalidraw file and one Plenary board in step (drawh --server). The pane and drawh already
+// meet at the file, so this is the only network code herdr-draw needs: file changes become protocol ops,
+// the room's entries are written back. No I/O here: the runner (plenary.js) hands in read/write and a
+// socket, tests hand in a string and an in-process Room.
+//
+// Syncs the `board` stream only. Pictures' bytes never travel (the protocol refuses `files` in ops).
+
+import { Replica } from "../protocol/replica.js";
+import { STREAMS, ELEMENT_STREAMS, canWrite, appStateProblem, utf8Bytes, MAX_OP_BYTES, MAX_VERSION_JUMP } from "../protocol/envelope.js";
+import { wins } from "../core/doc.js";
+
+const STREAM = "board";
+const CHUNK = MAX_OP_BYTES / 2;          // one op's elements, in UTF-8 bytes: well under the room's limit
+const MAX_SPLITS = 24;                   // refused ops taken apart to find the element at fault, per run (each costs a resync)
+const MAX_MERGES = 8;                    // saves by others folded in during one sync() before it yields
+const MARK = "plenaryBase";              // appState.herdr key: what this file's board settings were based on (never sent)
+const SETTINGS = ["layers", "grid", "snap", "timeline"];   // the board settings the protocol knows (envelope's APP_KEYS)
+const MAX_HIST = 256;                    // entries remembered per settings key (older ones: "can't tell", so loud)
+const MAX_CLIENTS = 8;                   // this bridge's earlier client ids kept across restarts
+// Settings compared canonically (object keys sorted), so a writer that reorders keys changes nothing.
+const canon = v => JSON.stringify(v, (k, x) => isObj(x) ? Object.fromEntries(Object.keys(x).sort().map(n => [n, x[n]])) : x);
+const same = (a, b) => canon(a) === canon(b);
+const own = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
+const copy = v => JSON.parse(JSON.stringify(v));
+const vn = el => `${el.version}:${el.versionNonce}`;
+const isObj = v => !!v && typeof v === "object" && !Array.isArray(v);
+const seqOk = n => Number.isSafeInteger(n) && n >= 0;
+const nonce = () => Math.floor(Math.random() * 2 ** 31);
+const randomId = () => Math.floor(Math.random() * 2 ** 31).toString(36) + Math.floor(Math.random() * 2 ** 31).toString(36);
+// The marker's "the file was written with this": the value's canonical JSON itself, compared exactly. (A short hash
+// was here; a collision would take the quiet path and drop a real change unsaid. Settings are small.)
+const printOf = v => canon(v);
+const EMPTY = () => ({ type: "excalidraw", version: 2, source: "herdr-draw", elements: [], appState: { viewBackgroundColor: "#ffffff" }, files: {} });
+const short = t => t.length > 80 ? `${t.slice(0, 77)}...` : t;
+const list = keys => keys.length === 1 ? keys[0] : `${keys.slice(0, -1).join(", ")} and ${keys[keys.length - 1]}`;
+
+/** What's wrong with a decoded frame from the server, or null. The Replica trusts its input; this doesn't. */
+export function frameProblem(msg) {
+  if (!isObj(msg) || typeof msg.t !== "string") return "something that isn't a message";
+  const elementsOk = v => Array.isArray(v) && v.every(el => isObj(el) && typeof el.id === "string");
+  if (msg.t === "welcome") {
+    if (!seqOk(msg.seq)) return "a welcome without a seq";
+    if (msg.room !== undefined && !(isObj(msg.room) && typeof msg.room.board === "string" && seqOk(msg.room.epoch))) return "a welcome with a malformed room";
+    return null;
+  }
+  if (msg.t === "ack") return typeof msg.id === "string" && seqOk(msg.seq) ? null : "a malformed ack";
+  if (msg.t === "error") return typeof msg.code === "string" ? null : "an error without a code";
+  if (msg.t === "transient") return isObj(msg.op) && (msg.op.elements === undefined || elementsOk(msg.op.elements)) ? null : "a malformed preview";
+  if (msg.t === "entries") {
+    if (!Array.isArray(msg.entries)) return "entries without a list";
+    for (const e of msg.entries) {
+      if (!isObj(e) || !seqOk(e.seq) || e.seq < 1 || !STREAMS.includes(e.stream) || !isObj(e.op)) return "a malformed entry";
+      if (e.op.elements !== undefined && !elementsOk(e.op.elements)) return "an entry with malformed elements";
+      if (e.op.appState !== undefined && !isObj(e.op.appState)) return "an entry with malformed settings";
+    }
+  }
+  if (msg.t === "snapshot") {
+    if (!seqOk(msg.seq) || !isObj(msg.streams) || (msg.appSeq !== undefined && !isObj(msg.appSeq))) return "a malformed snapshot";
+    for (const s of ELEMENT_STREAMS) if (!isObj(msg.streams[s]) || !elementsOk(msg.streams[s].elements) || !isObj(msg.streams[s].appState)) return "a malformed snapshot";
+  }
+  return null;   // kinds this client doesn't know are the Replica's to ignore
+}
+
+// Two copies of the file, neither built on the other (a save by someone else landed while ours was on its
+// way): every element at its winning version, pictures from both, everything else as `theirs` has it,
+// board settings and their marker included: push() then judges theirs by the base it was built on.
+function union(ours, theirs) {
+  if (!isObj(theirs)) return ours;
+  const els = (Array.isArray(ours.elements) ? ours.elements : []).slice(), at = new Map(els.map((e, i) => [e?.id, i]));
+  for (const el of Array.isArray(theirs.elements) ? theirs.elements : []) {
+    if (!isObj(el) || typeof el.id !== "string") continue;
+    const i = at.get(el.id);
+    if (i === undefined) { at.set(el.id, els.length); els.push(el); } else if (wins(el, els[i])) els[i] = el;
+  }
+  const a = isObj(ours.appState) ? ours.appState : {}, b = isObj(theirs.appState) ? theirs.appState : {};
+  const ha = isObj(a.herdr) ? a.herdr : {}, hb = isObj(b.herdr) ? b.herdr : {};
+  const herdr = { ...ha, ...hb };
+  if (!own(hb, MARK)) delete herdr[MARK];   // their settings were not built on our marker
+  return { ...ours, ...theirs, elements: els, files: { ...(isObj(ours.files) ? ours.files : {}), ...(isObj(theirs.files) ? theirs.files : {}) },
+    appState: { ...a, ...b, herdr } };
+}
+
+export class Bridge {
+  /**
+   * @param {{ board: string, client?: string, read: () => string | null,
+   *           write: (text: string, expected: string | null) => void | { replaced: string },
+   *           warn?: (line: string) => void, saved?: object | null, now?: () => number }} o
+   * `read` gives the file's text (null: no file yet). `write(text, expected)` puts `text` in place, always;
+   * when the file held something other than `expected` (someone else saved meanwhile) it returns that text
+   * as `{ replaced }`, and sync() folds it back in. `saved` is an earlier state() for this file and board:
+   * with it the hello asks only for what came after.
+   */
+  constructor({ board, client = "drawh", read, write, stamp = () => null, warn = () => {}, saved = null, now = Date.now }) {
+    // stamp(): an identity of the file's current save (the runner: inode, mtime, size; every writer replaces the file
+    // by rename), or null when unknown. Only used to tell a save made after a refusal from the file it refused.
+    this.stamp = stamp; this.lastStamp = null;
+    this.board = board; this.read = read; this.write = write; this.warn = warn; this.clientName = client; this.now = now;
+    this.send = null;
+    this.welcome = null;                 // the room's seq at hello; null while not connected
+    this.role = null; this.user = null;
+    this.refused = new Map();            // element id → version:nonce the room refused: never sent again
+    this.refusedSettings = new Map();    // key → canon of a value the room refused for its value (not stale-setting): not sent again
+    this.limit = new Map();              // element id → how many may share an op with it (after a refusal: to find the one at fault)
+    this.splits = 0;
+    this.held = 0;                       // changes in the file that did not go to the board, as of the last sync()
+    this.lost = 0;                       // settings changes refused (stale-setting) or kept from the board this run: --once exits 2
+    this.tip = null;                     // { seq, id, by } of the entry at replica.applied: how this room is recognised again
+    this.check = null;                   // the tip to find in the first answer after a hello
+    this.seenEntries = new Map();        // seq → { id, by } of entries not yet applied
+    this.carry = null;                   // someone's save, taken off the disk but not folded in yet
+    this.again = false;                  // sync() gave up for now with work left: call it again soon
+    this.said = new Set();
+    this.fatal = null;                   // set when retrying can't help (bad token, unknown board)
+    this.reconnect = false;              // set when the caller should drop the socket and open() again
+    this.later = false;                  // ...but not at once (the room is unavailable, or sent nonsense)
+    this.epoch = 0;                      // the highest epoch seen in a writer's welcome from this room (v1.1; 0: none yet)
+    this.clients = [];                   // this bridge's earlier client ids (an entry by one of them is ours)
+    this.fresh(null);
+    if (saved) this.restore(saved);
+  }
+
+  // A new copy for a room: a new Replica (a reset one keeps bases and gates from the old room, which would be
+  // refused there forever), a new lineage (markers written for the old room read as no marker), no history.
+  fresh(lineage) {
+    this.replica = new Replica({ client: this.clientName, now: this.now });
+    this.lineage = lineage ?? randomId();
+    this.hist = {};                      // settings key → [{ seq, mine }]: entries applied since `histFrom`
+    this.histFrom = {};                  // settings key → the appSeq history starts after (older: unknown)
+    this.unmarked = {};                  // key → [base, value]: an unmarked file last found in step (its implied marker)
+    this.gates = new Map();              // key → "writeback" | "wait": refused stale-setting, until retryReady
+    this.deferred = new Set();           // keys pull() leaves alone this pass (a change waiting on its gate)
+    this.looked = null;                  // the file's settings and marker as the bridge last read or wrote them (canon)
+    this.landed = {};                    // op id → seq of my recent settings entries (a marker may name one; kept across restarts)
+    this.refusedOps = new Set();         // my settings ops refused stale-setting (said, so the file's value of theirs is no news)
+    this.refusedVals = new Map();        // key → Set of canon values a stale-setting dropped (until its gate opens)
+    this.refusedAt = new Map();          // key → the file's stamp when its refusal came (null: unknown)
+    this.attempts = new Set();           // keys held after a refusal as a fresh attempt: judged without the quiet path
+  }
+
+  once(key, line) { if (!this.said.has(key)) { this.said.add(key); this.warn(line); } }
+
+  // Start from a saved state instead of seq 0. The file must still hold everything that state had seen;
+  // if it doesn't (restored from a backup, another file), start over from 0. An element the file has moved
+  // past goes into the replica under the version the room had (all that was saved of it), so the first
+  // sync sees the file's as newer and sends it, as an edit: not as a shape the board never had.
+  restore(saved) {
+    if (!isObj(saved) || saved.board !== this.board || !(saved.applied > 0) || saved.tip?.seq !== saved.applied) return false;
+    let scene;
+    try { scene = JSON.parse(this.read() ?? "null"); } catch { return false; }
+    const have = new Map((scene?.elements ?? []).map(e => [e?.id, e]));
+    const elements = [];
+    for (const [id, key] of Object.entries(saved.seen ?? {})) {
+      const el = have.get(id), [version, versionNonce] = String(key).split(":").map(Number);
+      if (!el || wins({ version, versionNonce }, el)) return false;
+      elements.push(vn(el) === key ? el : { ...el, version, versionNonce });
+    }
+    const appSeq = isObj(saved.appSeq) ? saved.appSeq : {};
+    const snap = { t: "snapshot", seq: saved.applied, appSeq: { [STREAM]: appSeq },
+      streams: { board: { elements, appState: { herdr: saved.confirmed ?? {} } }, notes: { elements: [], appState: {} } } };
+    if (frameProblem(snap)) return false;
+    if (typeof saved.lineage === "string") this.lineage = saved.lineage;
+    this.replica.receive(snap);
+    this.startHistory();
+    if (seqOk(saved.epoch)) this.epoch = saved.epoch;
+    if (Array.isArray(saved.clients)) this.clients = saved.clients.filter(c => typeof c === "string").slice(-MAX_CLIENTS);
+    if (isObj(saved.unmarked)) this.unmarked = saved.unmarked;
+    if (isObj(saved.landed)) this.landed = saved.landed;
+    this.tip = { seq: saved.tip.seq, id: saved.tip.id, by: saved.tip.by };
+    return true;
+  }
+
+  /** What to keep between runs (never the token): where the file and the room last agreed. */
+  state() {
+    const r = this.replica, mine = new Set();
+    for (const p of r.pending.values()) for (const el of p.op.elements ?? []) mine.add(`${el.id}|${vn(el)}`);
+    const seen = {};
+    for (const el of r.streams[STREAM].toScene().elements) if (!mine.has(`${el.id}|${vn(el)}`)) seen[el.id] = vn(el);
+    return { board: this.board, applied: r.applied, tip: this.tip, appSeq: r.appSeq[STREAM], confirmed: r.confirmed[STREAM], seen,
+      epoch: this.epoch, lineage: this.lineage, clients: [...this.clients, r.client].filter((c, i, a) => a.indexOf(c) === i).slice(-MAX_CLIENTS), unmarked: this.unmarked, landed: this.landed };
+  }
+
+  // Settings history starts at the copy's appSeq (a snapshot or a restore says nothing about who wrote before).
+  startHistory() { this.hist = {}; this.histFrom = { ...this.replica.appSeq[STREAM] }; }
+
+  // An entry on a settings key: remember who wrote it, so "nobody else changed it since" can be answered.
+  record(e) {
+    if (e.stream !== STREAM || !isObj(e.op.appState)) return;
+    const mine = e.by === this.replica.user && typeof e.id === "string" && [...this.clients, this.replica.client].includes(e.id.slice(0, e.id.lastIndexOf(":")));
+    for (const k of Object.keys(e.op.appState)) {
+      const h = this.hist[k] ??= [];
+      h.push({ seq: e.seq, mine, id: e.id });
+      if (mine) { this.landed[e.id] = e.seq; const ids = Object.keys(this.landed); if (ids.length > 64) delete this.landed[ids[0]]; }
+      if (h.length > MAX_HIST) this.histFrom[k] = h.shift().seq;
+    }
+  }
+
+  /** Who changed k after appSeq `base`: { others, mine } (did anyone else; did this bridge). null: can't tell (history doesn't reach back). */
+  since(k, base) {
+    if (base < (this.histFrom[k] ?? 0)) return null;
+    const after = (this.hist[k] ?? []).filter(e => e.seq > base);
+    return { others: after.some(e => !e.mine), mine: after.some(e => e.mine) };
+  }
+
+  /** The file's marker for k: [base, value (canonical JSON)], from the file's own marker, else the unmarked file's, else [0, null]. */
+  markOf(herdr, k) {
+    const m = herdr[MARK], ok = v => Array.isArray(v) && seqOk(v[0]) && typeof v[1] === "string";
+    const v = isObj(m) && m.room === this.lineage && isObj(m.keys) ? m.keys[k] : this.unmarked[k];
+    if (!ok(v)) return [0, null];
+    // Written while my op on k was in flight: the file's value stands on that op's entry, once it has one.
+    if (typeof v[2] !== "string") return [v[0], v[1], false];
+    if (seqOk(this.landed[v[2]])) return [this.landed[v[2]], v[1], false];
+    // The op neither landed, nor is in flight, nor was refused out loud (dropped by a stale, a restart, a lost
+    // connection): the value in the file is a change the board never got. It never takes a quiet path.
+    return [v[0], v[1], !this.replica.pending.has(v[2]) && !this.refusedOps.has(v[2])];
+  }
+  lookOf(herdr) { const o = {}; for (const k of [...SETTINGS, MARK]) if (own(herdr, k)) o[k] = herdr[k]; return canon(o); }
+  marked(herdr) { return isObj(herdr[MARK]) && herdr[MARK].room === this.lineage; }
+
+  /**
+   * Board settings in the file, judged by the base the file was built on (its marker). Per key whose value
+   * differs from the board's: nobody else changed it since that base → sent (the room's compare-and-set checks
+   * the rest); someone else did and the file still holds what it was written with → an old copy, the board's
+   * value is written back quietly; otherwise (a change made on an old copy, or the base can't be told) the
+   * board's value is written back and said. Returns { patch, kept }.
+   */
+  settingsFrom(herdr) {
+    const r = this.replica, ordered = r.appSeq[STREAM], shown = r.streams[STREAM].appState.herdr;
+    const patch = {}, kept = [], invalid = [];
+    this.deferred = new Set();
