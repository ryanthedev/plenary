+  if (mode === "wait") b.sync();                                                  // the write-back lands first: gate "wait"
+  r.hold();
+  if (mode === "race") f.races.push(t => built(t, s => { s.appState.herdr.grid = 40; }));   // the 40 lands during the bridge's write
+  edit(f, s => { if (mode !== "race") s.appState.herdr.grid = 40; s.appState.herdr.snap = true; }); b.sync();   // snap sent: the stamp write
