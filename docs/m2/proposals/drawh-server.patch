+      const why = el.id.length > 64 ? "its id is longer than 64 characters"
+        : !Number.isSafeInteger(el.version) || el.version < 0 || !Number.isSafeInteger(el.versionNonce) ? "it has no integer version and versionNonce"
+        : cur && el.version > cur.version + MAX_VERSION_JUMP ? `its version (${el.version}) is more than ${MAX_VERSION_JUMP} past the board's (${cur.version}), so the board would refuse it; it stays in this file only (a pane that had the file open while its shapes were first sent writes their old version numbers back)`
+        : JSON.stringify(el).length > CHUNK ? "it is too large for one op" : null;
+      if (why) { held++; this.once(`skip ${el.id} ${vn(el)}`, `element ${el.id} isn't sent: ${why}`); continue; }
+      out.push(el);
+    }
+    if (renumberedIds.length) this.warn(`${renumberedIds.length} shape${renumberedIds.length === 1 ? " was" : "s were"} past version ${MAX_VERSION_JUMP} and new to the board, so ${renumberedIds.length === 1 ? "it was" : "they were"} renumbered to version 1 to be sent (${renumberedIds.slice(0, 5).join(", ")}${renumberedIds.length > 5 ? ", …" : ""}): reopen any pane that has this file open, or its next save can bring the old numbers back and undo other people's edits to ${renumberedIds.length === 1 ? "it" : "them"}`);
+    // Board settings (layers, grid, snap, timeline): room → file only, except seeding a key the board has
+    // never set (settingsFrom). A change made here to a key the board has is held and put back by pull().
+    const { seed: patch, kept } = this.settingsFrom(herdr);
+    if (may) held += kept.length;
+    const settings = Object.keys(patch).length > 0;
+    if (settings && !may) held++;
+    this.held = held;
+    if (held && !may) this.once("role", `signed in as ${this.role}: changes made in this file are not sent`);
+    if (may) this.said.delete("role");
+    if (!may || (!out.length && !settings)) return { renumbered, settings: false };
+    const sendOp = op => { const msg = r.local(STREAM, op); this.send?.(msg); };
+    let attach = settings && !this.settingsAlone && out.length > 0;
+    if (settings && !attach) sendOp({ appState: patch });
+    let batch = [], size = 0, room = Infinity;
+    const flush = () => { if (!batch.length) return; sendOp({ elements: batch, ...(attach ? { appState: patch } : {}) }); attach = false; batch = []; size = 0; room = Infinity; };
+    for (const el of out) {
+      const n = JSON.stringify(el).length, cap = this.limit.get(el.id) ?? Infinity;
+      if (batch.length && (size + n > CHUNK || batch.length >= Math.min(room, cap))) flush();
+      batch.push(el); size += n; room = Math.min(room, cap);
+    }
+    flush();
+    return { renumbered, settings };
+  }
+
+  // Room → file. Returns true when `els` or `herdr` changed.
+  pull(els, herdr) {
+    const r = this.replica, doc = r.streams[STREAM];
+    const at = new Map(els.map((e, i) => [e?.id, i]));
+    let dirty = false;
+    for (const el of doc.toScene().elements) {
+      const i = at.get(el.id);
+      if (i === undefined) { els.push(copy(el)); dirty = true; }
+      else if (wins(el, els[i])) { els[i] = copy(el); dirty = true; }
+    }
+    // Only keys the room has ordered (a board whose settings no one has set keeps the file's), and only
+    // keys and values the protocol knows: nothing else a server sends becomes a key in the file.
+    const shown = doc.appState.herdr;
+    for (const k of Object.keys(r.appSeq[STREAM])) {
+      if (!own(shown, k) || appStateProblem({ [k]: shown[k] }) !== null || same(shown[k], herdr[k])) continue;
+      herdr[k] = copy(shown[k]); dirty = true;
+    }
+    return dirty;
+  }
+}
