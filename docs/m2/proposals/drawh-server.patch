+test("two saves landing during one write: nothing is lost, not even what the board never gets (a viewer's shapes, pictures)", () => {
+  const room = newRoom(), bob = peer(room);
+  const v = rig(room, { text: sceneText([rect("mine")]), token: "tok-view" });   // a viewer: the replica never holds its shapes
