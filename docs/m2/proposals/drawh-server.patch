+++ b/protocol/envelope.js
@@ -0,0 +1,220 @@
+// The rules every message obeys (PROTOCOL.md v1.1): streams, roles, what an op may hold, the limits.
+// Pure: imports nothing, so a room, a browser, a phone and a Herdr pane all check the same way.
+
+export const PROTOCOL_VERSION = 1;
+export const RULES_VERSION = 1;
+
+// `board` and `notes` hold elements (one Doc each); `records` holds comment threads and reactions.
+export const ELEMENT_STREAMS = ["board", "notes"];
+export const STREAMS = [...ELEMENT_STREAMS, "records"];
+export const ROLES = ["owner", "editor", "annotator", "commenter", "viewer"];
+const WRITERS = {
+  board: ["owner", "editor"],
+  notes: ["owner", "editor", "annotator"],
+  records: ["owner", "editor", "annotator", "commenter"],
+};
+
+/** May a person with `role` write to `stream`? */
+export const canWrite = (role, stream) => (WRITERS[stream] ?? []).includes(role);
+/** Owners and editors change or delete anyone's work, and set a stream's settings. */
+export const canModerate = role => canWrite(role, "board");
+
+// One op, as UTF-8 bytes of its JSON; bigger ones are refused ("too-large"). Bytes, not chars: 1M CJK chars
+// are 3 MB, which no 2 MB bus message carries (§ Limits). Counted by hand (utf8Bytes): no TextEncoder here.
+export const MAX_OP_BYTES = 1_000_000;
+// How far one op may raise an element's version past the room's copy (an absent element counts as 0).
+// Unbounded, one client could send version 2^53 and no one could ever change that element again.
+export const MAX_VERSION_JUMP = 1000;
+export const MAX_CLIENT_CHARS = 128;
+export const MAX_ID_CHARS = 64;
+
+// Op-id table (§ Op ids), fixed per rules version: a room replays old entries under the rules they were
+// accepted with. W = pairs kept per client, H = entries a client may stay silent before it is forgotten,
+// `every` = the seq period of an eviction tick.
+export const RULES = { 1: { W: 256, H: 100_000, every: 1024 } };
+export const W = RULES[1].W, H = RULES[1].H, EVICT_EVERY = RULES[1].every;
+
+// Content caps (§ Limits, § Records). Over one → "limit".
+export const CAPS = {
+  board: { ids: 100_000, chars: 50_000_000 },
+  notes: { ids: 200_000, chars: 50_000_000 },
+  records: { chars: 20_000_000, threads: 10_000, comments: 500, emoji: 20, emojiChars: 32, text: 10_000 },
+};
+// The op rate (§ Limits): a client paces every send to it; over-rate is backpressure, never a refusal.
+export const OP_RATE = { perSecond: 20, burst: 100 };
+export const OP_TIMEOUT_MS = 10_000;     // rule 2: an op with no answer this long makes the connection suspect
+export const CONNECT_TIMEOUT_MS = 10_000; // rule 12: no welcome, or no catch-up progress, for this long
+export const BACKOFF = { baseMs: 500, maxMs: 30_000 };   // rule 12: min(max, base × 2^k) × a random factor in [0.5, 1)
+export const APPEND_TIMEOUT_MS = 4000;   // § Recovery: two appends (8 s) fit inside the client's 10 s
+export const MAX_WRITER_CONNS = 8;       // § Pacing: writer connections per (user, board) per gateway; a ninth gets "limit"
+export const PING_IDLE_MS = 10_000;      // § Pacing: a gateway pings a connection that sent nothing this long
+export const CONN_SILENCE_MS = 30_000;   // § Pacing: and closes one it heard nothing from (no frame, no pong) this long
+export const GATEWAY_SILENCE_MS = 30_000; // rule 6: a gateway not heard from this long has lost its connections
+export const MAX_NAME_CHARS = 200;
+export const CHECKPOINT_EVERY = 1000;    // § Recovery, "When"
+
+/** A blob's key and an image's `fileId`: a SHA-1 as exactly 40 lowercase hex characters (§ Blobs). */
+export const isSha1 = v => typeof v === "string" && /^[0-9a-f]{40}$/.test(v);
+
+/** `client:counter` → { client, counter }, or null. The counter is a positive safe integer in plain digits. */
+export function parseOpId(id) {
+  if (typeof id !== "string") return null;
+  const at = id.lastIndexOf(":");
+  if (at < 1 || id.indexOf(":") !== at) return null;
+  const digits = id.slice(at + 1);
+  if (!/^[1-9][0-9]{0,15}$/.test(digits)) return null;
+  const counter = Number(digits);
+  if (!Number.isSafeInteger(counter)) return null;
+  return { client: id.slice(0, at), counter };
+}
+
+const bad = message => ({ code: "bad-op", message });
+const isObj = v => !!v && typeof v === "object" && !Array.isArray(v);
+const isId = v => typeof v === "string" && v.length > 0 && v.length <= MAX_ID_CHARS;
+const isNum = v => typeof v === "number" && Number.isFinite(v);
+
+// Objects and arrays inside one op (the op object is level 1); deeper is refused ("bad-op"). A client →
+// server frame may be 64 deep (the gateway checks it), so an op fits in its frame (+1) and a bus message (+2).
+export const MAX_OP_DEPTH = 62;
+export const MAX_FRAME_DEPTH = 64;
+
+/**
+ * The UTF-8 length of a string, counted by hand (the pure package can't use TextEncoder). A surrogate pair
+ * is one 4-byte character; a lone surrogate counts 3 (what an encoder writes for it, U+FFFD).
+ */
+export function utf8Bytes(str) {
+  let n = 0;
+  for (let i = 0; i < str.length; i++) {
+    const c = str.charCodeAt(i);
+    if (c < 0x80) n += 1;
+    else if (c < 0x800) n += 2;
+    else if (c >= 0xd800 && c <= 0xdbff && i + 1 < str.length) {
+      const d = str.charCodeAt(i + 1);
+      if (d >= 0xdc00 && d <= 0xdfff) { n += 4; i++; } else n += 3;
+    } else n += 3;
+  }
+  return n;
+}
+
+/** Is `value` nested deeper than `max` levels (the value itself is level 1)? A loop, never recursion. */
+export function deeperThan(value, max) {
+  const values = [value], depths = [1];
+  while (values.length) {
+    const v = values.pop(), d = depths.pop();
+    if (!v || typeof v !== "object") continue;
+    if (d > max) return true;
+    for (const k in v) { const inner = v[k]; if (inner && typeof inner === "object") { values.push(inner); depths.push(d + 1); } }
+  }
+  return false;
+}
+
+/**
+ * What's wrong with an op message, or null. Shape first (`bad-op`, `no-files`, `too-large`), then the id
+ * and `sentAt` (§ Limits, order of checks), so a bad id never hides a shape error. Roles are the room's job.
+ * @param {object} msg
+ * @param {number} [bytes] the op's JSON size in UTF-8 bytes, when the caller already has it (v1.1: bytes, no longer chars)
+ * @returns {null | { code: string, message: string }}
+ */
+export function opProblem(msg, bytes) {
+  if (!STREAMS.includes(msg.stream)) return bad(`unknown stream ${JSON.stringify(msg.stream)}`);
+  const op = msg.op;
+  if (!isObj(op)) return bad("op must be an object");
+  // Before anything walks or encodes the op: a very deep one would overflow the stack of whatever does.
+  if (deeperThan(op, MAX_OP_DEPTH)) return bad(`an op nests at most ${MAX_OP_DEPTH} levels deep`);
+  if (op.files) return { code: "no-files", message: "pictures go through the blob port, not in ops" };
+  if (msg.stream === "records") { const why = recordProblem(op); if (why) return why; }
+  else {
+    if (op.elements !== undefined) {
+      if (!Array.isArray(op.elements)) return bad("elements must be an array");
+      for (const el of op.elements) {
+        if (!el || !isId(el.id)) return bad("every element needs a string id (at most 64 characters)");
+        // A tie on version is broken by versionNonce on every copy alike; without one, copies disagree.
+        if (!Number.isSafeInteger(el.version) || el.version < 0 || !Number.isSafeInteger(el.versionNonce)) return bad("every element needs integer version and versionNonce");
+        if (el.type === "image" && el.fileId != null && !isSha1(el.fileId)) return bad("an image's fileId is 40 lowercase hex characters");
+      }
+    }
+    if (op.appState !== undefined) { const why = appStateProblem(op.appState); if (why) return bad(why); }
+    // § Settings: a settings op stands alone and names the appSeq each key was based on.
+    if (op.appState !== undefined && op.elements !== undefined) return bad("a settings op carries no elements: send them as two ops");
+    if (op.appState !== undefined || op.appBase !== undefined) { const why = appBaseProblem(op.appState, op.appBase); if (why) return bad(why); }
+    if (!op.elements?.length && !op.appState) return bad("empty op");
+  }
+  if ((bytes ?? utf8Bytes(JSON.stringify(op))) > MAX_OP_BYTES) return { code: "too-large", message: `an op is limited to ${MAX_OP_BYTES} bytes of UTF-8 JSON` };
+  if (!parseOpId(msg.id)) return bad("op ids are client:counter, the counter a positive integer");
+  if (!Number.isSafeInteger(msg.sentAt) || msg.sentAt < 0) return bad("op needs sentAt (the seq you had applied when you first sent it)");
+  return null;
+}
+
+const RECORD_ACTIONS = ["thread", "reply", "edit", "delete", "resolve", "reopen", "move", "react"];
+
+function anchorProblem(a) {
+  if (!isObj(a)) return "anchor must be an object";
+  if (a.point !== undefined) return isObj(a.point) && isNum(a.point.x) && isNum(a.point.y) && Object.keys(a).length === 1 ? null : "a point anchor is { point: { x, y } }";
+  if (!ELEMENT_STREAMS.includes(a.stream) || !isId(a.element) || !isNum(a.x) || !isNum(a.y)) return "an element anchor is { stream, element, x, y }";
+  return null;
+}
+
+/**
+ * What's wrong with the shape of one `records` action, or null. Whether its target exists and who may do
+ * it depend on the board, so the room checks those (records.js).
+ * @returns {null | { code: string, message: string }}
+ */
+export function recordProblem(op) {
+  if (!isObj(op) || !RECORD_ACTIONS.includes(op.do)) return bad(`unknown record action ${JSON.stringify(op?.do)}`);
+  if (!isId(op.id)) return bad("a record action needs an id (at most 64 characters)");
+  if (op.do === "thread" || op.do === "reply" || op.do === "edit") {
+    if (typeof op.text !== "string" || !op.text.length) return bad("a comment needs text");
+    if (op.text.length > CAPS.records.text) return { code: "limit", message: `a comment is limited to ${CAPS.records.text} characters` };
+  }
+  if (op.do === "reply" && !isId(op.thread)) return bad("a reply names its thread");
+  if (op.do === "thread" || op.do === "move") { const why = anchorProblem(op.anchor); if (why) return bad(why); }
+  if (op.do === "react") {
+    if (typeof op.emoji !== "string" || !op.emoji.length || op.emoji.length > CAPS.records.emojiChars) return bad(`an emoji is 1 to ${CAPS.records.emojiChars} characters`);
+    if (typeof op.on !== "boolean") return bad("react needs on: true or false");
+  }
+  return null;
+}
+
+// Board settings a patch may set (appState.herdr), each checked, so a patch can't put junk in front of
+// every client. Unknown keys are refused.
+const APP_KEYS = {
+  layers: v => Array.isArray(v) && v.length >= 1 && v.length <= 100 && v.every(l => isObj(l) && typeof l.id === "string" && l.id.length <= 64 &&
+    typeof l.name === "string" && l.name.length <= 200 && typeof l.visible === "boolean" && typeof l.locked === "boolean" &&
+    typeof l.opacity === "number" && l.opacity >= 0 && l.opacity <= 100),
+  grid: v => typeof v === "number" && Number.isFinite(v) && v >= 0 && v <= 1000,
+  snap: v => typeof v === "boolean",
+  timeline: v => isObj(v) && typeof v.duration === "number" && Number.isFinite(v.duration) && v.duration >= 0 && v.duration <= 3_600_000,
+};
+export function appStateProblem(patch) {
+  if (!isObj(patch)) return "appState must be an object";
+  for (const [k, v] of Object.entries(patch)) {
+    // Own keys only: "__proto__" or "constructor" would otherwise find Object.prototype's members.
+    if (!Object.prototype.hasOwnProperty.call(APP_KEYS, k)) return `unknown board setting ${JSON.stringify(k)}`;
+    if (!APP_KEYS[k](v)) return `bad value for ${k}`;
+  }
+  return null;
+}
+
+/**
+ * § Settings (compare-and-set): `appBase` has exactly the keys of `appState`, each an integer ≥ 0 (the
+ * appSeq that key's value was based on). Missing, extra or non-integer keys, or a base with no settings → a reason.
+ */
+export function appBaseProblem(appState, appBase) {
+  if (appState === undefined) return "appBase goes only with appState";
+  if (!isObj(appBase)) return "a settings op names its base: appBase { key: appSeq }";
+  const keys = Object.keys(appState), bases = Object.keys(appBase);
+  if (bases.length !== keys.length) return "appBase names exactly the keys appState sets";
+  for (const k of keys) {
+    if (!Object.prototype.hasOwnProperty.call(appBase, k)) return `appBase is missing ${k}`;
+    if (!Number.isSafeInteger(appBase[k]) || appBase[k] < 0) return `appBase.${k} must be an integer ≥ 0`;
+  }
+  return null;
+}
+
+/** appState patch keys win by seq: the value from the highest-seq op that set each key. */
+export function mergeAppState(state, seqs, patch, seq) {
+  for (const [k, v] of Object.entries(patch)) {
+    if (!Object.prototype.hasOwnProperty.call(APP_KEYS, k)) continue;   // never a prototype key, whoever sent it
+    if (seq > (seqs[k] ?? 0)) { state[k] = v; seqs[k] = seq; }
+  }
+}
diff --git a/protocol/ports.js b/protocol/ports.js
new file mode 100644
index 0000000..d64dfca
--- /dev/null
+++ b/protocol/ports.js
@@ -0,0 +1,88 @@
+// What a room needs from the outside world, as interfaces, plus in-memory versions for tests and
+// single-process use. A deployment swaps these (SQLite, Postgres, a bus) without touching the room.
+// The server's ports are async (PROTOCOL.md § Ports); the ones here are synchronous, and a room takes both.
+
+/**
+ * The durable log of one board, as a room sees it (the server binds tenant and board).
+ * `append` writes every entry or none, and only if the log ends at `expectSeq`; else it throws an error
+ * with `code: "conflict"`. It returns (or resolves) only once the entries are durable: a room acks after it.
+ * @typedef {{
+ *   append(entries: object[], expectSeq: number): void | Promise<void>,
+ *   putCheckpoint?(cp: object): void | Promise<void>,
+ *   openEpoch?(): number,
+ * }} Log
+ */
+
+/**
+ * The server's ports (PROTOCOL.md § Ports), all async. A room is handed none of them: the server gives it a
+ * per-board Log (above) made from the Store, and the verified identity with each hello.
+ * @typedef {{ verify(token: string): Promise<null | { user: string, name: string, email: string, domain: string }>,
+ *             role(identity: object, board: string): Promise<null | string> }} Auth  null = refused; a throw = unavailable
+ * @typedef {{ append(tenant: string, board: string, entries: object[], expectSeq: number): Promise<void>,
+ *             read(tenant: string, board: string, fromSeq: number, limit: number): Promise<object[]>,
+ *             putCheckpoint(tenant: string, board: string, cp: object): Promise<void>,
+ *             getCheckpoint(tenant: string, board: string, beforeSeq?: number): Promise<null | object>,
+ *             openEpoch(tenant: string, board: string): Promise<number>,
+ *             epoch(tenant: string, board: string): Promise<number> }} Store
+ *   openEpoch: a durable atomic increment of the board's epoch (1 on the first call), kept with its lease
+ *   record; every room build calls it before its first welcome. epoch: reads it, 0 = no room was ever built.
+ * @typedef {{ publish(subject: string, msg: object): void, subscribe(subject: string, fn: (msg: object) => void): () => void }} Bus  at-most-once
+ * @typedef {{ put(tenant: string, sha1: string, bytes: Uint8Array): Promise<void>, get(tenant: string, sha1: string): Promise<null | Uint8Array> }} Blobs
+ */
+
+const copy = v => JSON.parse(JSON.stringify(v));
+const fail = (code, message) => Object.assign(new Error(message), { code });
+
+/**
+ * Who is this token on this board? For tests: token → { user, role } (any board), or
+ * { user, boards: { [board]: role } }. null = refused. The room never calls it; a gateway does (rule 8).
+ */
+export function tableAuth(table) {
+  return {
+    check(token, board) {
+      const who = Object.prototype.hasOwnProperty.call(table, token) ? table[token] : null;
+      const role = who && (who.boards ? who.boards[board] : who.role);
+      return role ? { user: who.user, role, ...(who.name ? { name: who.name } : {}) } : null;
+    },
+  };
+}
+
+/** A Log in memory, with the Store's contract for one board: conditional append, read, checkpoints. */
+export class MemoryLog {
+  constructor() { this.entries = []; this.checkpoints = []; this.epochN = 0; }
+
+  /** A room is being built: the board's next epoch (1 on the first call), kept apart from the checkpoints (§ Recovery, Room identity). */
+  openEpoch() { return ++this.epochN; }
+  /** The latest epoch handed out; 0 = no room was ever built. */
+  epoch() { return this.epochN; }
+
+  /** The last seq in the log (0 when empty). */
+  get end() { return this.entries.length ? this.entries[this.entries.length - 1].seq : 0; }
+
+  append(entries, expectSeq) {
+    if (!Array.isArray(entries) || !entries.length) throw fail("bad-append", "append takes a list of entries");
+    if (expectSeq !== this.end) throw fail("conflict", `the log ends at ${this.end}, not ${expectSeq}`);
+    for (let i = 0; i < entries.length; i++) if (entries[i].seq !== expectSeq + 1 + i) throw fail("bad-append", "entries must follow the log's end, one seq each");
+    this.entries.push(...entries);
+  }
+
+  /** Entries with seq ≥ fromSeq, ascending. */
+  read(fromSeq = 1, limit = Infinity) {
+    const first = this.entries.length ? this.entries[0].seq : 1, at = Math.max(0, fromSeq - first);
+    return this.entries.slice(at, limit === Infinity ? undefined : at + limit);
+  }
+
+  /** The highest seq wins, never the last write. */
+  putCheckpoint(cp) {
+    const mine = copy(cp), at = this.checkpoints.findIndex(c => c.seq >= mine.seq);
+    if (at < 0) this.checkpoints.push(mine);
+    else if (this.checkpoints[at].seq === mine.seq) this.checkpoints[at] = mine;
+    else this.checkpoints.splice(at, 0, mine);
+  }
+
+  /** The latest checkpoint, or the latest below `beforeSeq` (to step back from a bad one). null if none. */
+  getCheckpoint(beforeSeq = Infinity) {
+    for (let i = this.checkpoints.length - 1; i >= 0; i--) if (this.checkpoints[i].seq < beforeSeq) return copy(this.checkpoints[i]);
+    return null;
+  }
+}
diff --git a/protocol/presence.js b/protocol/presence.js
new file mode 100644
index 0000000..93d8200
--- /dev/null
+++ b/protocol/presence.js
@@ -0,0 +1,95 @@
+// Presence (PROTOCOL.md § Presence): cursors, selections, laser, previews, emotes. Never sequenced, never
+// logged, may drop at any hop. A room never sees it; gateways check, rate-limit, coalesce and relay it.
+// Pure, with the clock passed in.
+
+import { ELEMENT_STREAMS, ROLES, canWrite, deeperThan, MAX_ID_CHARS, MAX_OP_DEPTH } from "./envelope.js";
+
+const WRITERS = ["owner", "editor", "annotator", "commenter"];
+/** Per kind: who may send it, and how many per second per connection. */
+export const PRESENCE = {
+  cursor: { roles: WRITERS, rate: 20 },
+  select: { roles: WRITERS, rate: 5 },
+  laser: { roles: ["owner", "editor"], rate: 30 },
+  preview: { roles: WRITERS, rate: 20 },   // and only by a writer of that stream
+  emote: { roles: ROLES, rate: 4 },
+};
+export const EMOTES = ["👍", "❤️", "😂", "🎉", "👏", "😮", "🙏", "🔥"];
+export const MAX_SELECT_IDS = 500, MAX_LASER_POINTS = 64, MAX_PREVIEW_ELEMENTS = 50, MAX_PREVIEW_CHARS = 64_000;
+export const PREVIEW_TTL_MS = 5000;
+
+const isNum = v => typeof v === "number" && Number.isFinite(v);
+const isId = v => typeof v === "string" && v.length > 0 && v.length <= MAX_ID_CHARS;
+
+/**
+ * What's wrong with a presence message from someone with `role`, or null. A bad one is dropped silently:
+ * presence never gets an error.
+ * @returns {null | string}
+ */
+export function presenceProblem(msg, role) {
+  if (!msg || typeof msg !== "object" || !Object.prototype.hasOwnProperty.call(PRESENCE, msg.k)) return "unknown presence kind";
+  if (!PRESENCE[msg.k].roles.includes(role)) return `${role} can't send ${msg.k}`;
+  if (msg.k === "cursor") return isNum(msg.x) && isNum(msg.y) ? null : "cursor needs x and y";
+  if (msg.k === "select") {
+    if (!ELEMENT_STREAMS.includes(msg.stream)) return "select names a stream";
+    return Array.isArray(msg.ids) && msg.ids.length <= MAX_SELECT_IDS && msg.ids.every(isId) ? null : `select holds at most ${MAX_SELECT_IDS} ids`;
+  }
+  if (msg.k === "laser") {
+    const ok = Array.isArray(msg.pts) && msg.pts.length >= 1 && msg.pts.length <= MAX_LASER_POINTS && msg.pts.every(p => Array.isArray(p) && p.length === 3 && p.every(isNum));
+    return ok ? null : `laser holds 1 to ${MAX_LASER_POINTS} points of [x, y, t]`;
+  }
+  if (msg.k === "preview") {
+    if (!ELEMENT_STREAMS.includes(msg.stream) || !canWrite(role, msg.stream)) return "preview needs a stream you can write";
+    if (!Array.isArray(msg.elements) || !msg.elements.length || msg.elements.length > MAX_PREVIEW_ELEMENTS) return `preview holds 1 to ${MAX_PREVIEW_ELEMENTS} elements`;
+    if (!msg.elements.every(el => el && typeof el === "object" && isId(el.id))) return "every preview element needs an id";
+    if (deeperThan(msg.elements, MAX_OP_DEPTH)) return "preview nests too deep";
+    return JSON.stringify(msg.elements).length <= MAX_PREVIEW_CHARS ? null : "preview is too large";
+  }
+  return EMOTES.includes(msg.e) ? null : "unknown emote";
+}
+
+/**
+ * One connection's presence rates: a bucket per kind, `rate` a second, at most one second's worth saved up.
+ * @param {() => number} now a clock in ms
+ * @returns {{ allow(k: string): boolean }} false = over the rate: drop it, no error
+ */
+export function presenceLimiter(now) {
+  const buckets = {};
+  return {
+    allow(k) {
+      if (!Object.prototype.hasOwnProperty.call(PRESENCE, k)) return false;
+      const rate = PRESENCE[k].rate, t = now();
+      const b = buckets[k] ?? (buckets[k] = { tokens: rate, at: t });
+      b.tokens = Math.min(rate, b.tokens + Math.max(0, t - b.at) * rate / 1000); b.at = t;
+      if (b.tokens < 1) return false;
+      b.tokens -= 1;
+      return true;
+    },
+  };
+}
+
+/**
+ * Gathers presence between two sends and gives back one batch: the latest cursor and selection per
+ * (user, client), the latest preview per element, every laser batch and emote, and `leave`.
+ * @returns {{ add(user: string, client: string, msg: object): void, leave(user: string, client: string): void, flush(): object[], size: number }}
+ */
+export function presenceCoalescer() {
+  let latest = new Map(), each = [];
+  const key = (user, client, rest) => JSON.stringify([user, client, rest]);
+  return {
+    add(user, client, msg) {
+      if (msg.k === "cursor") latest.set(key(user, client, "cursor"), { user, client, k: "cursor", x: msg.x, y: msg.y });
+      else if (msg.k === "select") latest.set(key(user, client, "select"), { user, client, k: "select", stream: msg.stream, ids: msg.ids });
+      else if (msg.k === "preview") for (const el of msg.elements) latest.set(key(user, client, ["preview", msg.stream, el.id]), { user, client, k: "preview", stream: msg.stream, elements: [el] });
+      else if (msg.k === "laser") each.push({ user, client, k: "laser", pts: msg.pts });
+      else if (msg.k === "emote") each.push({ user, client, k: "emote", e: msg.e });
+    },
+    /** The connection is gone: what it had waiting goes with it, and the others are told. */
+    leave(user, client) {
+      for (const [k, m] of latest) if (m.user === user && m.client === client) latest.delete(k);
+      each = each.filter(m => !(m.user === user && m.client === client));
+      each.push({ user, client, k: "leave" });
+    },
+    flush() { const batch = [...latest.values(), ...each]; latest = new Map(); each = []; return batch; },
+    get size() { return latest.size + each.length; },
+  };
+}
diff --git a/protocol/records.js b/protocol/records.js
new file mode 100644
index 0000000..248cbd1
--- /dev/null
+++ b/protocol/records.js
@@ -0,0 +1,156 @@
+// Comment threads and reactions (PROTOCOL.md § Records): the state behind the `records` stream.
+// Records don't merge by version: every copy applies the same actions in seq order. The room checks an
+// action before logging it (`check`), so `apply` never meets a forbidden one; an action on a deleted
+// comment or a hidden thread is accepted and changes nothing (a no-op, the same on every copy).
+// Pure: a room and a replica both use it.
+
+import { CAPS, canModerate } from "./envelope.js";
+
+const bad = message => ({ code: "bad-op", message });
+const limit = message => ({ code: "limit", message });
+const forbidden = message => ({ code: "forbidden", message });
+const copy = v => JSON.parse(JSON.stringify(v));
+
+// Size is a function of the state alone (not of how it was reached), so a rebuilt room counts the same.
+const THREAD_CHARS = 64, COMMENT_CHARS = 64, REACTION_CHARS = 8;
+const threadChars = t => THREAD_CHARS + JSON.stringify(t.anchor).length;
+const reactionChars = (emoji, user) => REACTION_CHARS + emoji.length + String(user).length;
+
+export class Records {
+  /** @param {{ threads: object[] }} [data] the snapshot shape (§ Records, "Shape in snapshots") */
+  constructor(data) { this.load(data); }
+
+  load(data) {
+    this.threads = new Map();    // thread id → { id, anchor, by, at, resolved?, comments: [] }, in creation order
+    this.comments = new Map();   // comment id → { thread, comment }; a thread's first comment has the thread's id
+    this.chars = 0;
+    this.rev = (this.rev ?? 0) + 1;
+    for (const raw of data?.threads ?? []) {
+      const t = { id: raw.id, anchor: copy(raw.anchor), by: raw.by, name: raw.name ?? null, at: raw.at, ...(raw.resolved ? { resolved: copy(raw.resolved) } : {}), comments: [] };
