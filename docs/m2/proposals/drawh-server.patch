+  bob.send("board", { elements: [rect("theirs")] });
+  const { b, f, sent, els } = rig(room, { text: sceneText([rect("mine")]) });
+  expect(b.sync()).toBe(true);
+  expect(room.streams.board.get("mine")).toBeTruthy();
+  expect(els().map(e => e.id).sort()).toEqual(["mine", "theirs"]);
+  expect(b.settled()).toBe(true);
+  const ops = sent.length, writes = f.writes;
+  b.sync(); b.sync();                                                 // no echo: nothing new either way
+  expect([sent.length, f.writes]).toEqual([ops, writes]);
+  // an agent edits the file (drawh bumps the version); bob moves his own
+  edit(f, s => { const mine = s.elements.find(e => e.id === "mine"); mine.x = 40; touch(mine); });
+  const moved = { ...bob.r.streams.board.get("theirs"), y: 99 }; touch(moved); bob.send("board", { elements: [moved] });
+  b.sync();
