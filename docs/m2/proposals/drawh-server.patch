+// "seen": a pass ran between the two saves (the live 0.35 s timing); "fast": both landed between two passes (0.15 s),
+// told apart only by the file's stamp; "fast, no stamp": the runner can't stat, so the 20 is taken as the refused file.
+for (const mode of ["seen", "seen, no stamp", "fast", "fast, no stamp"]) test(`v1.1 settings, V5: back to the dropped value after a newer one (${mode})`, () => {
