+test("v1.1 settings: a change whose op never landed (lost with a restart) is never taken for an old copy: sent, or said", () => {
+  for (const peerMoves of [false, true]) {
+    const room = newRoom(), bob = peer(room), real = room.op.bind(room);
+    const a = rig(room, { text: sceneText([], { grid: 10 }) });
+    a.b.sync(); a.b.sync();
+    room.op = (c, msg) => msg.op.appState ? undefined : real(c, msg);           // the room never answers it (a lost connection)
+    edit(a.f, s => { s.appState.herdr.grid = 20; }); a.b.sync();                 // sent, and the file stamped with it
+    expect(a.herdr().plenaryBase.keys.grid[2]).toBe([...a.b.replica.pending.keys()][0]);
+    const saved = wire(a.b.state());
+    room.op = real;
+    if (peerMoves) bob.send("board", { appState: { grid: 30 } });
+    const two = rig(room, { text: a.f.text, saved }); two.run();                // the next run: that op is gone
+    expect([peerMoves, grid(room), two.herdr().grid, said(two.warned, `grid in this file ${OLD}`)]).toEqual(peerMoves ? [true, 30, 30, 1] : [false, 20, 20, 0]);
+  }
+});
