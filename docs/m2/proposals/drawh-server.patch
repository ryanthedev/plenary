+// drawh --server: a board file kept in step with a Plenary board. The room here is the protocol's own
+// reference Room (protocol/room.js), in process or behind a local WebSocket: there is no Plenary server yet.
+import { test, expect } from "bun:test";
+import { mkdtempSync, readFileSync, writeFileSync, readdirSync, existsSync, rmSync, chmodSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { createHash } from "node:crypto";
+import { Bridge, frameProblem } from "../cli/bridge.js";
+import { BoardFile, LINK_WARNING, NO_SAFE_WRITE } from "../cli/files.js";
+import { Room } from "../protocol/room.js";
+import { Replica } from "../protocol/replica.js";
+import { tableAuth, MemoryLog } from "../protocol/ports.js";
+import { jsonCodec } from "../protocol/codec.js";
+import { makeElement, touch } from "../core/model.js";
+
+const ROOT = new URL("..", import.meta.url).pathname;
+const TOKEN = "s3cret-token-do-not-print";
+const TABLE = { [TOKEN]: { user: "ada", role: "editor" }, "tok-view": { user: "vic", role: "viewer" }, "tok-bob": { user: "bob", role: "editor" } };
+const wire = m => jsonCodec.decode(jsonCodec.encode(m));
+const rect = (id, fields = {}) => ({ ...makeElement("rectangle", { x: 0, y: 0, width: 100, height: 60, ...fields }), id });
+const sceneText = (elements, herdr) => JSON.stringify({ type: "excalidraw", version: 2, source: "herdr-draw", elements, appState: { viewBackgroundColor: "#ffffff", ...(herdr ? { herdr } : {}) }, files: {} });
+const edit = (f, fn) => { const s = JSON.parse(f.text); fn(s); f.text = JSON.stringify(s); };
+// A folder for one test, removed when the test is done (by its own path).
+const scratch = () => mkdtempSync(`${tmpdir()}/drawh-plenary-`);
+const done = dir => rmSync(dir, { recursive: true, force: true });
+
+// A file (a string), a bridge on it, and a direct line to the room. `sent` keeps every message as sent.
+// `f.races`: saves by someone else, each landing just before the bridge's next write (as on a real disk,
+// the bridge's text goes in regardless and the other save comes back as { replaced }).
+// Messages from the room wait while the bridge is inside sync(), as they do on a real socket.
+function rig(room, { text = null, token = TOKEN, saved = null } = {}) {
+  const f = { text, writes: 0, races: [] }, sent = [], warned = [], queue = [];
+  let busy = false;
+  const b = new Bridge({ board: "b1", saved, read: () => f.text, warn: l => warned.push(l),
+    write: (t, expected) => { if (f.fail > 0) { f.fail--; throw new Error("the disk says no"); } const race = f.races.shift(); if (race) f.text = race(f.text); const was = f.text; f.text = t; f.writes++; if (was !== expected) return { replaced: was }; } });
+  const raw = b.sync.bind(b);
+  b.sync = () => {
+    let ok = false;
+    for (let i = 0; i < 50; i++) { busy = true; ok = raw(); busy = false; if (!queue.length) break; while (queue.length) b.receive(queue.shift()); if (b.reconnect) break; }
+    return ok;
+  };
+  const connect = () => { const c = room.connect(m => { const w = wire(m); if (busy) queue.push(w); else b.receive(w); }); b.open(token, m => { sent.push(m); room.receive(c, wire(m)); }); return c; };
+  const conn = connect();
+  // sync until quiet, reconnecting when the bridge asks to
+  const run = () => { for (let i = 0; i < 40; i++) { if (b.reconnect) connect(); b.sync(); if (!b.reconnect && !b.again) break; } };
+  return { b, f, sent, warned, conn, connect, run, els: () => JSON.parse(f.text).elements, herdr: () => JSON.parse(f.text).appState.herdr };
+}
+const newRoom = () => new Room({ board: "b1", tenant: "t1", auth: tableAuth(TABLE), log: new MemoryLog() });
+// Another person on the board, straight on the room.
+function peer(room, token = "tok-bob") {
+  const r = new Replica({ client: "peer" }), c = room.connect(m => r.receive(wire(m)));
+  for (const m of r.connectMessages(token, "b1")) room.receive(c, wire(m));
+  return { r, send: (stream, op) => room.receive(c, wire(r.local(stream, op))) };
+}
+const settingsOps = sent => sent.filter(m => m.t === "op" && m.op.appState).map(m => m.op.appState);
+
+test("protocol/ is plenary's packages/protocol, byte for byte (SOURCE.json); change it there, then re-copy", () => {
+  const dir = `${ROOT}protocol/`, src = JSON.parse(readFileSync(dir + "SOURCE.json", "utf8"));
+  expect(src.commit).toMatch(/^[0-9a-f]{7,40}$/);
+  expect(Object.keys(src.files).sort()).toEqual(readdirSync(dir).filter(f => f.endsWith(".js")).sort());
+  for (const [f, h] of Object.entries(src.files)) expect([f, createHash("sha256").update(readFileSync(dir + f)).digest("hex")]).toEqual([f, h]);
+});
+
+test("the first message is the hello, and the token is in it and nowhere else", () => {
+  const room = newRoom(), { b, sent, f } = rig(room, { text: sceneText([rect("a")]) });
+  expect(sent[0]).toEqual({ t: "hello", token: TOKEN, board: "b1", since: 0, client: b.replica.client });
+  expect(sent[0].client).toMatch(/^drawh\.[0-9a-z]+$/);            // no colon: op ids are client:counter
+  b.sync();
+  expect(sent.length).toBe(2);
+  expect(JSON.stringify(sent.slice(1))).not.toContain(TOKEN);
+  expect(JSON.stringify(b.state())).not.toContain(TOKEN);
+  expect(f.text).not.toContain(TOKEN);
+});
