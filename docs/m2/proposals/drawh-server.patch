+// drawh --server: a board file kept in step with a Plenary board. The room here is the protocol's own
+// reference Room (protocol/room.js), in process or behind a local WebSocket: there is no Plenary server yet.
+import { test, expect } from "bun:test";
+import { mkdtempSync, readFileSync, writeFileSync, readdirSync, existsSync, rmSync, chmodSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { createHash } from "node:crypto";
+import { Bridge, frameProblem } from "../cli/bridge.js";
