+// Keeps one .excalidraw file and one Plenary board in step (drawh --server). The pane and drawh already
+// meet at the file, so this is the only network code herdr-draw needs: file changes become protocol ops,
+// the room's entries are written back. No I/O here: the runner (plenary.js) hands in read/write and a
+// socket, tests hand in a string and an in-process Room.
+//
+// Syncs the `board` stream only. Pictures' bytes never travel (the protocol refuses `files` in ops).
+
+import { Replica } from "../protocol/replica.js";
+import { STREAMS, canWrite, appStateProblem, MAX_OP_CHARS, MAX_VERSION_JUMP } from "../protocol/envelope.js";
+import { wins } from "../core/doc.js";
+
+const STREAM = "board";
+const CHUNK = MAX_OP_CHARS / 2;          // one op's elements, in JSON chars: well under the room's limit
+const MAX_SPLITS = 24;                   // refused ops taken apart to find the element at fault, per run (each costs a resync)
+const MAX_MERGES = 8;                    // saves by others folded in during one sync() before it yields
+// Settings compared canonically (object keys sorted), so a writer that reorders keys changes nothing.
+const canon = v => JSON.stringify(v, (k, x) => isObj(x) ? Object.fromEntries(Object.keys(x).sort().map(n => [n, x[n]])) : x);
+const same = (a, b) => canon(a) === canon(b);
+const own = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
+const copy = v => JSON.parse(JSON.stringify(v));
+const vn = el => `${el.version}:${el.versionNonce}`;
+const isObj = v => !!v && typeof v === "object" && !Array.isArray(v);
+const seqOk = n => Number.isSafeInteger(n) && n >= 0;
+const nonce = () => Math.floor(Math.random() * 2 ** 31);
+const EMPTY = () => ({ type: "excalidraw", version: 2, source: "herdr-draw", elements: [], appState: { viewBackgroundColor: "#ffffff" }, files: {} });
+
+/** What's wrong with a decoded frame from the server, or null. The Replica trusts its input; this doesn't. */
+export function frameProblem(msg) {
+  if (!isObj(msg) || typeof msg.t !== "string") return "something that isn't a message";
+  const elementsOk = v => Array.isArray(v) && v.every(el => isObj(el) && typeof el.id === "string");
+  if (msg.t === "welcome") return seqOk(msg.seq) ? null : "a welcome without a seq";
+  if (msg.t === "ack") return typeof msg.id === "string" && seqOk(msg.seq) ? null : "a malformed ack";
+  if (msg.t === "error") return typeof msg.code === "string" ? null : "an error without a code";
+  if (msg.t === "transient") return isObj(msg.op) && (msg.op.elements === undefined || elementsOk(msg.op.elements)) ? null : "a malformed preview";
+  if (msg.t === "entries") {
+    if (!Array.isArray(msg.entries)) return "entries without a list";
+    for (const e of msg.entries) {
+      if (!isObj(e) || !seqOk(e.seq) || e.seq < 1 || !STREAMS.includes(e.stream) || !isObj(e.op)) return "a malformed entry";
+      if (e.op.elements !== undefined && !elementsOk(e.op.elements)) return "an entry with malformed elements";
+      if (e.op.appState !== undefined && !isObj(e.op.appState)) return "an entry with malformed settings";
+    }
+  }
+  if (msg.t === "snapshot") {
+    if (!seqOk(msg.seq) || !isObj(msg.streams) || (msg.appSeq !== undefined && !isObj(msg.appSeq))) return "a malformed snapshot";
+    for (const s of STREAMS) if (!isObj(msg.streams[s]) || !elementsOk(msg.streams[s].elements) || !isObj(msg.streams[s].appState)) return "a malformed snapshot";
+  }
+  return null;   // kinds this client doesn't know are the Replica's to ignore
+}
+
+// Two copies of the file, neither built on the other (a save by someone else landed while ours was on its
+// way): every element at its winning version, pictures from both, everything else as `theirs` has it,
+// board settings included: push() and pull() then treat theirs as any file's (the board's value is kept).
+function union(ours, theirs) {
+  if (!isObj(theirs)) return ours;
+  const els = (Array.isArray(ours.elements) ? ours.elements : []).slice(), at = new Map(els.map((e, i) => [e?.id, i]));
+  for (const el of Array.isArray(theirs.elements) ? theirs.elements : []) {
+    if (!isObj(el) || typeof el.id !== "string") continue;
+    const i = at.get(el.id);
+    if (i === undefined) { at.set(el.id, els.length); els.push(el); } else if (wins(el, els[i])) els[i] = el;
+  }
+  const a = isObj(ours.appState) ? ours.appState : {}, b = isObj(theirs.appState) ? theirs.appState : {};
+  return { ...ours, ...theirs, elements: els, files: { ...(isObj(ours.files) ? ours.files : {}), ...(isObj(theirs.files) ? theirs.files : {}) },
+    appState: { ...a, ...b, herdr: { ...(isObj(a.herdr) ? a.herdr : {}), ...(isObj(b.herdr) ? b.herdr : {}) } } };
+}
+
+export class Bridge {
+  /**
+   * @param {{ board: string, client?: string, read: () => string | null,
+   *           write: (text: string, expected: string | null) => void | { replaced: string },
+   *           warn?: (line: string) => void, saved?: object | null }} o
+   * `read` gives the file's text (null: no file yet). `write(text, expected)` puts `text` in place, always;
+   * when the file held something other than `expected` (someone else saved meanwhile) it returns that text
+   * as `{ replaced }`, and sync() folds it back in. `saved` is an earlier state() for this file and board:
+   * with it the hello asks only for what came after.
+   */
+  constructor({ board, client = "drawh", read, write, warn = () => {}, saved = null }) {
+    this.board = board; this.read = read; this.write = write; this.warn = warn;
+    // Board settings flow room → file only while connected (protocol v0 can't tell a stale save from a
+    // change: settings carry no versions). The file seeds a key the board has never set, nothing more.
+    this.refusedSettings = new Map();    // key → canon of a seed value the room refused: not sent again
+    this.written = {};                   // the settings in the last file the bridge wrote: a file still holding them
+                                         // just hasn't been given the board's newer value yet (no change made here)
+    this.replica = new Replica({ client });
+    this.send = null;
+    this.welcome = null;                 // the room's seq at hello; null while not connected
+    this.role = null; this.user = null;
+    this.refused = new Map();            // element id → version:nonce the room refused: never sent again
+    this.limit = new Map();              // element id → how many may share an op with it (after a refusal: to find the one at fault)
+    this.splits = 0; this.settingsAlone = false;
+    this.held = 0;                       // changes in the file that did not go to the board, as of the last sync()
+    this.tip = null;                     // { seq, id, by } of the entry at replica.applied: how this room is recognised again
+    this.check = null;                   // the tip to find in the first answer after a hello
+    this.seenEntries = new Map();        // seq → { id, by } of entries not yet applied
+    this.carry = null;                   // someone's save, taken off the disk but not folded in yet
+    this.again = false;                  // sync() gave up for now with work left: call it again soon
+    this.said = new Set();
+    this.fatal = null;                   // set when retrying can't help (bad token, unknown board)
+    this.reconnect = false;              // set when the caller should drop the socket and open() again
+    this.later = false;                  // ...but not at once (the room is unavailable, or sent nonsense)
+    if (saved) this.restore(saved);
+  }
+
+  once(key, line) { if (!this.said.has(key)) { this.said.add(key); this.warn(line); } }
+
+  // Start from a saved state instead of seq 0. The file must still hold everything that state had seen;
+  // if it doesn't (restored from a backup, another file), start over from 0. An element the file has moved
+  // past goes into the replica under the version the room had (all that was saved of it), so the first
+  // sync sees the file's as newer and sends it, as an edit: not as a shape the board never had.
+  restore(saved) {
+    if (!isObj(saved) || saved.board !== this.board || !(saved.applied > 0) || saved.tip?.seq !== saved.applied) return false;
+    let scene;
+    try { scene = JSON.parse(this.read() ?? "null"); } catch { return false; }
+    const have = new Map((scene?.elements ?? []).map(e => [e?.id, e]));
+    const elements = [];
+    for (const [id, key] of Object.entries(saved.seen ?? {})) {
+      const el = have.get(id), [version, versionNonce] = String(key).split(":").map(Number);
+      if (!el || wins({ version, versionNonce }, el)) return false;
+      elements.push(vn(el) === key ? el : { ...el, version, versionNonce });
+    }
+    const snap = { t: "snapshot", seq: saved.applied, appSeq: { [STREAM]: saved.appSeq ?? {} },
+      streams: { board: { elements, appState: { herdr: saved.confirmed ?? {} } }, notes: { elements: [], appState: {} } } };
+    if (frameProblem(snap)) return false;
+    this.replica.receive(snap);
+    this.written = copy(saved.confirmed ?? {});                   // what the file held when that state was saved
+    this.tip = { seq: saved.tip.seq, id: saved.tip.id, by: saved.tip.by };
+    return true;
+  }
+
+  /** What to keep between runs (never the token): where the file and the room last agreed. */
+  state() {
+    const r = this.replica, mine = new Set();
+    for (const p of r.pending.values()) for (const el of p.op.elements ?? []) mine.add(`${el.id}|${vn(el)}`);
+    const seen = {};
+    for (const el of r.streams[STREAM].toScene().elements) if (!mine.has(`${el.id}|${vn(el)}`)) seen[el.id] = vn(el);
+    return { board: this.board, applied: r.applied, tip: this.tip, appSeq: r.appSeq[STREAM], confirmed: r.confirmed[STREAM], seen };
+  }
+
+  /**
+   * Board settings in the file, room's way: a key the board has set is the board's; a different value here is
+   * not sent (pull() writes the board's back) and is said, each time. A key the board has never set is sent
+   * (seeding), once. Returns { seed, kept }.
+   */
+  settingsFrom(herdr) {
+    const ordered = this.replica.appSeq[STREAM], shown = this.replica.streams[STREAM].appState.herdr;
+    const seed = {}, kept = [];
+    for (const [k, v] of Object.entries(isObj(herdr) ? herdr : {})) {
+      // (judged before validity: a value the room would refuse, in a key the board has, is put back too, and said)
+      if (own(ordered, k)) { if (!same(v, shown[k]) && !(own(this.written, k) && same(v, this.written[k]))) kept.push(appStateProblem({ [k]: v }) === null ? k : `${k} (not a valid value)`); continue; }
+      if (appStateProblem({ [k]: v }) !== null) continue;
+      if (same(v, shown[k]) || this.refusedSettings.get(k) === canon(v)) continue;   // (shown holds a seed of ours until it is acknowledged)
+      seed[k] = v;
+    }
+    if (kept.length) this.once(`boardset ${canon(kept.map(k => [k, herdr[k.split(" ")[0]]]))}`, `board settings are set on the board, not from this file: ${kept.join(", ")} in this file ${kept.length === 1 ? "differs" : "differ"} from the board's (a change made here, or an older copy of the file saved over it) and ${kept.length === 1 ? "is" : "are"} put back to the board's value; to change ${kept.length === 1 ? "it" : "them"}, use the board (the web app)`);
+    return { seed, kept };
+  }
+
+  /** A socket opened: say hello (the token goes in this first message, never in a header or the URL),
+   *  then every op the room hasn't acknowledged, again. */
+  open(token, send) {
+    const r = this.replica;
+    this.send = send; this.welcome = null; this.reconnect = this.later = false; this.check = null;
+    // Protocol v0 gives a room no name. So the hello asks for one entry more than it needs, the last one
+    // applied here, and the answer must hold that very entry (same op id, same author): then this is the
+    // room this copy came from. Without such an entry to look for, take the whole board again.
+    if (r.applied > 0 && this.tip?.seq !== r.applied) r.reset();
+    const msgs = r.connectMessages(token, this.board);
+    if (r.applied > 0) { msgs[0] = { ...msgs[0], since: r.applied - 1 }; this.check = this.tip; }
+    for (const m of msgs) send(m);
+  }
+
+  closed() { this.send = null; this.welcome = null; }
+
+  /** A decoded message from the room. Never throws. Check `fatal` and `reconnect` after it, then sync(). */
+  receive(msg) {
+    const bad = frameProblem(msg);
+    if (bad) return this.nonsense(`the server sent ${bad}`);
+    try { this.take(msg); }
+    // A throw may have left the replica half-way through a message: nothing in it can be trusted now.
+    catch (e) { this.nonsense(`a message from the server could not be applied (${e?.message ?? e})`); }
+  }
+
+  nonsense(line) {
+    this.once("frame", `${line}; starting over from the board's copy`);
+    this.replica.reset(); this.tip = null; this.check = null; this.seenEntries.clear();
+    this.reconnect = this.later = true;
+  }
+
+  otherRoom() {
+    this.warn("this is not the board this file was last in step with (another server, or one that was reset): starting over from its copy");
+    this.replica.reset(); this.tip = null; this.check = null; this.seenEntries.clear();
+    this.reconnect = true;
+  }
+
+  take(msg) {
+    const r = this.replica;
+    if (msg.t === "welcome") {
+      this.welcome = msg.seq; this.role = msg.role; this.user = msg.user;
+      if (msg.seq < r.applied) return this.otherRoom();           // behind what this file saw
+    } else if (this.check && !(msg.t === "error" && !msg.id)) {   // (a refusal or "unavailable" says nothing about which room this is)
+      const c = this.check; this.check = null;
+      const e = msg.t === "entries" ? msg.entries.find(e => e.seq === c.seq) : null;
+      if (!e || e.id !== c.id || e.by !== c.by) return this.otherRoom();
+    }
+    if (msg.t === "error") {
+      const p = msg.id ? r.pending.get(msg.id) : null;
+      if (p) this.refusal(p, msg);
+      else if (!msg.id) {
+        if (msg.code === "unavailable") this.reconnect = this.later = true;
+        else this.fatal = `the server said no (${msg.code}: ${msg.message})`;
+      }
+    }
+    if (msg.t === "entries") for (const e of msg.entries) if (e.seq > r.applied) this.seenEntries.set(e.seq, { id: e.id, by: e.by });
+    const before = r.applied;
+    r.receive(msg);
+    if (r.applied !== before) {
+      const t = this.seenEntries.get(r.applied);
+      this.tip = t ? { seq: r.applied, id: t.id, by: t.by } : null;   // null after a snapshot: no entry to show next time
+      for (const k of [...this.seenEntries.keys()]) if (k <= r.applied) this.seenEntries.delete(k);
+    }
+    if (r.resync) this.reconnect = true;
+  }
+
+  // The room refused an op of ours. The replica drops it and starts over from the room's copy; the file
+  // still has the change, so it must be remembered or it would be sent, and refused, forever. An op that
+  // carried several things is taken apart first (halves, then halves of those), so one bad element doesn't
+  // keep its neighbours from the board and the warning can name it.
+  refusal(p, msg) {
+    const els = p.op.elements ?? [], keys = Object.keys(p.op.appState ?? {}), why = `${msg.code}: ${msg.message}`;
+    if (els.length + (keys.length ? 1 : 0) > 1 && this.splits < MAX_SPLITS) {
+      this.splits++;
+      if (keys.length) this.settingsAlone = true;   // (sent again next pass, alone: the replica dropped them)
+      const cap = keys.length ? els.length : Math.ceil(els.length / 2);
+      for (const el of els) this.limit.set(el.id, cap);
+      return;
+    }
+    for (const el of els) this.refused.set(el.id, vn(el));
+    for (const k of keys) this.refusedSettings.set(k, canon(p.op.appState[k]));
+    const what = [els.length === 1 ? `element ${els[0].id}` : els.length ? `${els.length} elements (${els.slice(0, 5).map(e => e.id).join(", ")}${els.length > 5 ? ", …" : ""})` : null,
+      keys.length ? `the board settings (${keys.join(", ")})` : null].filter(Boolean).join(" and ");
+    this.warn(`the server refused ${what} (${why}); ${els.length ? `${els.length + keys.length > 1 ? "they stay" : "it stays"} in this file only` : "the board's value is written back to this file"}`);
+  }
+
+  caughtUp() { return this.welcome !== null && !this.reconnect && !this.check && this.replica.applied >= this.welcome; }
+  /** Caught up, and every change sent has been acknowledged and come back. */
+  settled() { return this.caughtUp() && this.replica.pending.size === 0; }
+
+  /**
+   * One pass: what the file has that the room hasn't goes out as ops; what the room has that the file
+   * hasn't is written to the file. Returns true when the file and the replica agree afterwards.
+   * Waits for catch-up, so a change is never sent against a board this client hasn't seen yet.
+   */
+  sync() {
+    this.again = false;
+    if (!this.caughtUp() || this.fatal) return false;
+    const text = this.read();
+    let scene;
+    try { scene = text === null ? EMPTY() : JSON.parse(text); }
+    catch { this.once("json", "the file isn't valid JSON right now; waiting for the next change"); return false; }
+    if (!isObj(scene)) return false;
+    this.said.delete("json");
+    let onDisk = text, must = text === null;
+    if (this.carry) { scene = union(scene, this.carry); this.carry = null; must = true; }
+    for (let n = 0; ; n++) {
+      const els = Array.isArray(scene.elements) ? scene.elements.slice() : [];
+      const herdr = { ...(isObj(scene.appState?.herdr) ? scene.appState.herdr : {}) };
+      const { renumbered } = this.push(els, herdr);
+      const pulled = this.pull(els, herdr);
+      // Nothing to write: the file is in step with the board, key for key, so what it holds now counts as what the
+      // bridge last gave it (a peer's change arriving before the bridge's first write is then not taken for one made here).
+      if (!must && !renumbered && !pulled) { this.written = copy(herdr); break; }
