+test("a reconnect already decided (a refused op, the wrong room) is spent by closed(): the next socket isn't aborted by a pass", () => {
+  const room = newRoom(), { b } = rig(room, { text: sceneText([rect("a")]) });
+  b.sync();
+  b.reconnect = true;                                                            // as after a refused op: reconnect at once
+  b.closed(); b.sync();
+  expect(b.reconnect).toBe(false);
