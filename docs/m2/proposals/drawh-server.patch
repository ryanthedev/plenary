@@ -0,0 +1,11 @@
+// How messages become bytes. JSON in v0; a binary codec (MessagePack, CBOR) can replace it later
+// without touching rooms or replicas: they only ever see decoded objects.
+
+/** @typedef {{ encode(msg: object): string | Uint8Array, decode(data: string | Uint8Array): object }} Codec */
+
+/** @type {Codec} */
+export const jsonCodec = {
+  encode: msg => JSON.stringify(msg),
+  // Text frames only: a binary codec takes binary frames (Herdr's runtime has no TextDecoder to turn bytes into text).
+  decode: data => { if (typeof data !== "string") throw new Error("the JSON codec takes text frames"); return JSON.parse(data); },
+};
diff --git a/protocol/envelope.js b/protocol/envelope.js
new file mode 100644
index 0000000..67b79c7
--- /dev/null
+++ b/protocol/envelope.js
@@ -0,0 +1,69 @@
+// The rules every message obeys (PROTOCOL.md): streams, roles, what an op may hold.
+// Pure: imports nothing, so a room, a browser, a phone and a Herdr pane all check the same way.
+
+export const STREAMS = ["board", "notes"];
+export const ROLES = ["owner", "editor", "annotator", "commenter", "viewer"];
+const WRITERS = { board: ["owner", "editor"], notes: ["owner", "editor", "annotator", "commenter"] };
+
+/** May a person with `role` write to `stream`? */
+export const canWrite = (role, stream) => (WRITERS[stream] ?? []).includes(role);
+
+export const MAX_OP_CHARS = 1_000_000;   // one op, JSON-encoded; bigger ones are refused ("too-large")
+// How far one op may raise an element's version past the room's copy. Unbounded, one client could send
+// version 2^53 and no one could ever change that element again.
+export const MAX_VERSION_JUMP = 1000;
+export const MAX_CLIENT_CHARS = 128;
+
+/**
+ * What's wrong with an op message, or null. Checks shape only; roles are the room's job.
+ * @returns {null | { code: string, message: string }}
+ */
+export function opProblem(msg) {
+  const bad = message => ({ code: "bad-op", message });
+  if (typeof msg.id !== "string" || !msg.id) return bad("op needs an id");
+  if (!STREAMS.includes(msg.stream)) return bad(`unknown stream ${JSON.stringify(msg.stream)}`);
+  const op = msg.op;
+  if (!op || typeof op !== "object" || Array.isArray(op)) return bad("op must be an object");
+  if (op.files) return { code: "no-files", message: "pictures go through the blob port, not in ops" };
+  if (op.elements !== undefined) {
+    if (!Array.isArray(op.elements)) return bad("elements must be an array");
+    for (const el of op.elements) {
+      if (!el || typeof el.id !== "string" || !el.id || el.id.length > 64) return bad("every element needs a string id (at most 64 characters)");
+      // A tie on version is broken by versionNonce on every copy alike; without one, copies disagree.
+      if (!Number.isSafeInteger(el.version) || el.version < 0 || !Number.isSafeInteger(el.versionNonce)) return bad("every element needs integer version and versionNonce");
+    }
+  }
+  if (op.appState !== undefined) { const why = appStateProblem(op.appState); if (why) return bad(why); }
+  if (!op.elements?.length && !op.appState) return bad("empty op");
+  if (JSON.stringify(op).length > MAX_OP_CHARS) return { code: "too-large", message: `an op is limited to ${MAX_OP_CHARS} characters` };
+  return null;
+}
+
+// Board settings a patch may set (appState.herdr), each checked, so a patch can't put junk in front of
+// every client. Unknown keys are refused.
+const isObj = v => !!v && typeof v === "object" && !Array.isArray(v);
+const APP_KEYS = {
+  layers: v => Array.isArray(v) && v.length >= 1 && v.length <= 100 && v.every(l => isObj(l) && typeof l.id === "string" && l.id.length <= 64 &&
+    typeof l.name === "string" && l.name.length <= 200 && typeof l.visible === "boolean" && typeof l.locked === "boolean" &&
+    typeof l.opacity === "number" && l.opacity >= 0 && l.opacity <= 100),
+  grid: v => typeof v === "number" && Number.isFinite(v) && v >= 0 && v <= 1000,
+  snap: v => typeof v === "boolean",
+  timeline: v => isObj(v) && typeof v.duration === "number" && Number.isFinite(v.duration) && v.duration >= 0 && v.duration <= 3_600_000,
+};
+export function appStateProblem(patch) {
+  if (!isObj(patch)) return "appState must be an object";
+  for (const [k, v] of Object.entries(patch)) {
+    // Own keys only: "__proto__" or "constructor" would otherwise find Object.prototype's members.
+    if (!Object.prototype.hasOwnProperty.call(APP_KEYS, k)) return `unknown board setting ${JSON.stringify(k)}`;
+    if (!APP_KEYS[k](v)) return `bad value for ${k}`;
+  }
+  return null;
+}
+
+/** appState patch keys win by seq: the value from the highest-seq op that set each key. */
+export function mergeAppState(state, seqs, patch, seq) {
+  for (const [k, v] of Object.entries(patch)) {
+    if (!Object.prototype.hasOwnProperty.call(APP_KEYS, k)) continue;   // never a prototype key, whoever sent it
+    if (seq > (seqs[k] ?? 0)) { state[k] = v; seqs[k] = seq; }
+  }
+}
diff --git a/protocol/ports.js b/protocol/ports.js
new file mode 100644
index 0000000..ccdd76c
--- /dev/null
+++ b/protocol/ports.js
@@ -0,0 +1,24 @@
+// What a room needs from the outside world, as interfaces, plus in-memory versions for tests and M2's
+// first server. A deployment swaps these (Postgres, S3, a bus) without touching the room.
+
+/**
+ * Who is this token, and what may they do on this board? null = refused.
+ * The tenant comes from the board, on the server; a client never names it.
+ * @typedef {{ check(token: string, board: string): null | { user: string, role: string, tenant: string } }} Auth
+ */
+
+/**
+ * The durable op log. append() returns only once the entry is stored: a room acks after it (PROTOCOL rule 1).
+ * @typedef {{ append(entry: object): void }} Log
+ */
+
+/** An Auth from a fixed table: token → { user, role }, one tenant. */
+export function tableAuth(table, tenant = "t1") {
+  return { check: token => (table[token] ? { ...table[token], tenant } : null) };
+}
+
+/** A Log in memory (tests, single-process dev). */
+export class MemoryLog {
+  constructor() { this.entries = []; }
+  append(entry) { this.entries.push(entry); }
+}
diff --git a/protocol/replica.js b/protocol/replica.js
new file mode 100644
index 0000000..f13809f
--- /dev/null
+++ b/protocol/replica.js
@@ -0,0 +1,106 @@
+// A client's copy of a board (PROTOCOL.md): applies the room's entries in seq order, whatever order they
+// arrive in, and shows its own ops at once (optimistic) until the room acknowledges them.
+// Runs in a browser, a phone, Node or a Herdr pane: imports only the core's model and merge rules.
+
+import { Doc } from "../core/doc.js";
+import { emptyScene, clone } from "../core/model.js";
+import { STREAMS, mergeAppState } from "./envelope.js";
+
+export class Replica {
+  /** @param {{ client: string }} o — a name for this client; each Replica adds its own session part, so a
+   *  reloaded page reusing the name never collides with its old op ids (`client.session:counter`). */
+  constructor({ client }) {
+    this.client = `${client}.${Math.floor(Math.random() * 2 ** 31).toString(36)}`; this.counter = 0;
+    this.reset();
+  }
+
+  reset() {
+    this.applied = 0;                    // the highest seq applied; everything up to it is in
+    this.streams = {}; this.confirmed = {}; this.appSeq = {};
+    for (const s of STREAMS) {
+      this.streams[s] = new Doc(emptyScene());
+      this.confirmed[s] = { ...this.streams[s].appState.herdr };   // appState as the room ordered it
+      this.appSeq[s] = {};
+    }
+    this.buffer = new Map();             // seq → entry, arrived ahead of a gap
+    this.previews = new Map();           // element id → others' in-flight preview (display only)
+    this.pending = this.pending ?? new Map();   // op id → { stream, op, msg, ackSeq? }: kept across a reset, resent on hello
+    this.role = null;
+  }
+
+  /** The hello to send on (re)connect, then every unacknowledged op again (same ids: the room dedupes). */
+  connectMessages(token, board) {
+    this.resync = false;
+    return [{ t: "hello", token, board, since: this.applied, client: this.client }, ...[...this.pending.values()].map(p => p.msg)];
+  }
+
+  /** A local change: shown now, sent to the room. Elements must already carry their new versions. */
+  local(stream, op, { transient = false } = {}) {
+    const msg = { t: "op", id: `${this.client}:${++this.counter}`, stream, op: clone(op), ...(transient ? { transient: true } : {}) };
+    if (transient) return msg;
+    if (op.elements) this.streams[stream].apply({ elements: op.elements });
+    { this.pending.set(msg.id, { stream, op: msg.op, msg }); this.showAppState(stream); }
+    return msg;
+  }
+
+  receive(msg) {
+    if (msg.t === "welcome") { this.role = msg.role; return; }
+    if (msg.t === "snapshot") return this.snapshot(msg);
+    if (msg.t === "entries") { for (const e of msg.entries) if (e.seq > this.applied && !this.buffer.has(e.seq)) this.buffer.set(e.seq, e); return this.drain(); }
+    if (msg.t === "ack") { const p = this.pending.get(msg.id); if (p) { p.ackSeq = msg.seq; this.settle(); } return; }
+    // Previews (drags, cursors) are shown over the board, never merged into it: a preview may tie with the
+    // final op on version and win on the tie-break, and the room never applies previews.
+    if (msg.t === "transient") { for (const el of msg.op.elements ?? []) this.previews.set(el.id, el); return; }
+    // A refused op was already shown here: drop it and start over from the room's copy (PROTOCOL rule 7).
+    // The caller reconnects when `resync` is set; the other pending ops are resent then.
+    if (msg.t === "error" && msg.id && this.pending.has(msg.id)) { this.pending.delete(msg.id); this.reset(); this.resync = true; }
+  }
+
+  snapshot(msg) {
+    if (msg.seq <= this.applied) return;
+    for (const s of STREAMS) {
+      const sc = msg.streams[s];
+      const doc = this.streams[s];
+      doc.load({ elements: clone(sc.elements), appState: clone(sc.appState) });
+      this.confirmed[s] = { ...doc.appState.herdr };
+      this.appSeq[s] = { ...(msg.appSeq?.[s] ?? {}) };
+    }
+    this.applied = msg.seq;
+    for (const k of [...this.buffer.keys()]) if (k <= this.applied) this.buffer.delete(k);
+    for (const p of this.pending.values()) if (p.op.elements) this.streams[p.stream].apply({ elements: p.op.elements });
+    for (const s of STREAMS) this.showAppState(s);
+    this.drain();
+  }
+
+  drain() {
+    while (this.buffer.has(this.applied + 1)) {
+      const e = this.buffer.get(this.applied + 1); this.buffer.delete(e.seq);
+      if (e.op.elements) { this.streams[e.stream].apply({ elements: e.op.elements }); for (const el of e.op.elements) this.previews.delete(el.id); }
+      if (e.op.appState) mergeAppState(this.confirmed[e.stream], this.appSeq[e.stream], e.op.appState, e.seq);
+      this.applied = e.seq;
+      this.showAppState(e.stream);
+    }
+    this.settle();
+  }
+
+  // An acknowledged op whose entry is applied is no longer pending.
+  settle() {
+    let any = false;
+    for (const [id, p] of this.pending) if (p.ackSeq && p.ackSeq <= this.applied) { this.pending.delete(id); any = true; }
+    if (any) for (const s of STREAMS) this.showAppState(s);
+  }
+
+  // Shown appState = the room's order, with this client's unacknowledged patches on top.
+  showAppState(stream) {
+    const doc = this.streams[stream], next = { ...this.confirmed[stream] };
+    for (const p of this.pending.values()) if (p.stream === stream && p.op.appState) Object.assign(next, p.op.appState);
+    doc.appState.herdr = next; doc.rev++; doc._sorted = null;
+  }
+
+  /** The board as data, for comparing copies: elements by id, appState, the seq it's at. */
+  state() {
+    const out = { applied: this.applied };
+    for (const s of STREAMS) { const d = this.streams[s]; out[s] = { elements: [...d.byId.values()].sort((a, b) => (a.id < b.id ? -1 : 1)), appState: d.appState.herdr }; }
+    return out;
+  }
+}
diff --git a/protocol/room.js b/protocol/room.js
new file mode 100644
index 0000000..644d378
--- /dev/null
+++ b/protocol/room.js
@@ -0,0 +1,105 @@
+// The reference room: the one sequencer for a board (PROTOCOL.md). In memory; storage and auth come in
+// through ports. It never runs layout. M2's server hosts these behind a transport; M4 splits the fan-out
+// into gateways, but what a room decides stays here.
+
+import { Doc } from "../core/doc.js";
+import { emptyScene, clone } from "../core/model.js";
+import { STREAMS, canWrite, opProblem, mergeAppState, MAX_VERSION_JUMP, MAX_CLIENT_CHARS } from "./envelope.js";
+
+export class Room {
+  /** @param {{ board: string, tenant: string, auth: import("./ports.js").Auth, log: import("./ports.js").Log }} o */
+  constructor({ board, tenant, auth, log }) {
+    this.board = board; this.tenant = tenant; this.auth = auth; this.log = log;
+    this.seq = 0;
+    this.streams = {};
+    this.appSeq = {};
+    for (const s of STREAMS) { this.streams[s] = new Doc(emptyScene()); this.appSeq[s] = {}; }
+    this.tail = [];                     // entries after `base` (the log kept for catch-up)
+    this.base = { seq: 0, snapshot: this.snapshot() };
+    this.opSeq = new Map();             // "user|op id" → seq it got (repeats get the same ack). TODO: bound per client.
+    this.noteAuthor = new Map();        // notes element id → the user who made it
+    this.conns = new Set();
+  }
+
+  /** A client connects; `send` delivers a message to it. Returns the connection to pass to receive(). */
+  connect(send) { const c = { send, user: null, role: null }; this.conns.add(c); return c; }
+  disconnect(c) { this.conns.delete(c); }
+
+  receive(c, msg) {
+    if (msg.t === "hello") return this.hello(c, msg);
+    if (!c.user) return c.send({ t: "error", code: "auth", message: "say hello first" });
+    if (msg.t === "op") return this.op(c, msg);
+    c.send({ t: "error", code: "bad-op", message: `unknown message ${JSON.stringify(msg.t)}` });
+  }
+
+  hello(c, msg) {
+    if (msg.board !== this.board) return c.send({ t: "error", code: "auth", message: "this is another board" });
+    if (typeof msg.client !== "string" || !msg.client || msg.client.length > MAX_CLIENT_CHARS || msg.client.includes(":"))
+      return c.send({ t: "error", code: "bad-op", message: "hello needs a client id (no colon)" });
+    const who = this.auth.check(msg.token, this.board);
+    // The tenant comes from the board, on the server: a token from another tenant gets nothing here.
+    if (!who || who.tenant !== this.tenant) return c.send({ t: "error", code: "auth", message: "token refused" });
+    Object.assign(c, { user: who.user, role: who.role, client: msg.client });
+    c.send({ t: "welcome", seq: this.seq, role: who.role, user: who.user });
+    const since = Number(msg.since) || 0;
+    if (since < this.base.seq) {   // the log no longer reaches back that far: the snapshot, then what came after
+      c.send({ t: "snapshot", seq: this.base.seq, ...clone(this.base.snapshot) });
+      if (this.tail.length) c.send({ t: "entries", entries: this.tail });
+    } else {
+      const after = this.tail.filter(e => e.seq > since);
+      if (after.length) c.send({ t: "entries", entries: after });
+    }
+  }
+
+  op(c, msg) {
+    const problem = opProblem(msg);
+    if (problem) return c.send({ t: "error", id: msg.id, ...problem });
+    // Op ids are "client:counter" under this connection's own client id, and dedupe is per user, so no one
+    // can suppress another person's op by sending its id first.
+    if (!msg.id.startsWith(c.client + ":")) return c.send({ t: "error", id: msg.id, code: "bad-op", message: "op ids start with your client id" });
+    if (!canWrite(c.role, msg.stream)) return c.send({ t: "error", id: msg.id, code: "forbidden", message: `${c.role} can't write to ${msg.stream}` });
+    const key = `${c.user}|${msg.id}`;
+    if (this.opSeq.has(key)) return c.send({ t: "ack", id: msg.id, seq: this.opSeq.get(key) });   // a resend
+    // The notes stream's settings (its layers) are the moderators': annotators and commenters add notes only.
+    if (msg.op.appState && !canWrite(c.role, "board")) return c.send({ t: "error", id: msg.id, code: "forbidden", message: "only owners and editors change settings" });
+    const doc = this.streams[msg.stream];
+    for (const el of msg.op.elements ?? []) {
+      if (el.version > (doc.getAny(el.id)?.version ?? 0) + MAX_VERSION_JUMP) return c.send({ t: "error", id: msg.id, code: "bad-op", message: `version of ${el.id} jumps too far` });
+      // Annotators and commenters change only their own notes; owners and editors moderate everyone's.
+      const author = msg.stream === "notes" && this.noteAuthor.get(el.id);
+      if (author && author !== c.user && !canWrite(c.role, "board")) return c.send({ t: "error", id: msg.id, code: "forbidden", message: "that note is someone else's" });
+    }
+    if (msg.transient) {   // relayed, never logged or applied
+      for (const o of this.conns) if (o !== c && o.user) o.send({ t: "transient", stream: msg.stream, op: msg.op, by: c.user });
+      return;
+    }
+    const entry = { seq: this.seq + 1, board: this.board, tenant: this.tenant, stream: msg.stream, op: msg.op, by: c.user, id: msg.id };
+    this.log.append(entry);   // durable before anything else (rule 1)
+    this.seq = entry.seq;
+    this.apply(entry);
+    this.tail.push(entry);
+    this.opSeq.set(key, entry.seq);
+    if (msg.stream === "notes") for (const el of msg.op.elements ?? []) if (!this.noteAuthor.has(el.id)) this.noteAuthor.set(el.id, c.user);
+    c.send({ t: "ack", id: msg.id, seq: entry.seq });
+    for (const o of this.conns) if (o.user) o.send({ t: "entries", entries: [entry] });
+  }
+
+  apply(entry) {
+    const doc = this.streams[entry.stream];
+    if (entry.op.elements) doc.apply({ elements: entry.op.elements });
+    if (entry.op.appState) {
+      const next = { ...doc.appState.herdr };
+      mergeAppState(next, this.appSeq[entry.stream], entry.op.appState, entry.seq);
+      doc.appState.herdr = next; doc.rev++; doc._sorted = null;
+    }
+  }
+
+  snapshot() {
+    const streams = {};
+    for (const s of STREAMS) { const sc = this.streams[s].toScene(); streams[s] = { elements: sc.elements, appState: sc.appState }; }
+    return { streams, appSeq: clone(this.appSeq) };
+  }
+
+  /** Fold the log into a snapshot: clients older than now get the snapshot instead of every entry. */
+  compact() { this.base = { seq: this.seq, snapshot: this.snapshot() }; this.tail = []; }
+}
