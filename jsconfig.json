{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "packages/**/*.js",
    "server/**/*.js",
    "web/**/*.js",
    "scripts/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "docs"
  ]
}
