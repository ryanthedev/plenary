+import { Room } from "../protocol/room.js";
+import { Replica } from "../protocol/replica.js";
+import { tableAuth, MemoryLog } from "../protocol/ports.js";
+import { jsonCodec } from "../protocol/codec.js";
+import { makeElement, touch } from "../core/model.js";
+
+const ROOT = new URL("..", import.meta.url).pathname;
+const TOKEN = "s3cret-token-do-not-print";
+const TABLE = { [TOKEN]: { user: "ada", role: "editor" }, "tok-view": { user: "vic", role: "viewer" }, "tok-bob": { user: "bob", role: "editor" } };
+// The gateway's part (v1.1: the room never sees a token): a hello reaches the room with who signed in.
+const AUTH = tableAuth(TABLE);
+// A clock 60 ms on at every look: the Replica's pace (20 ops a second) never holds an in-process test back,
+// and nothing here waits long enough for its 10 s answer timeout.
+const fast = () => { let t = 0; return () => (t += 60); };
+const deliver = (room, c, m) => room.receive(c, m, m && m.t === "hello" ? (AUTH.check(m.token, m.board) ?? {}) : {});
+const wire = m => jsonCodec.decode(jsonCodec.encode(m));
+const rect = (id, fields = {}) => ({ ...makeElement("rectangle", { x: 0, y: 0, width: 100, height: 60, ...fields }), id });
+const sceneText = (elements, herdr) => JSON.stringify({ type: "excalidraw", version: 2, source: "herdr-draw", elements, appState: { viewBackgroundColor: "#ffffff", ...(herdr ? { herdr } : {}) }, files: {} });
+// Every save bumps the file's stamp (as a rename does on disk: a new inode); `f.n` is that stamp here.
+const edit = (f, fn) => { const s = JSON.parse(f.text); fn(s); f.text = JSON.stringify(s); f.n = (f.n ?? 0) + 1; };
+// A folder for one test, removed when the test is done (by its own path).
+const scratch = () => mkdtempSync(`${tmpdir()}/drawh-plenary-`);
+const done = dir => rmSync(dir, { recursive: true, force: true });
+
+// A file (a string), a bridge on it, and a direct line to the room. `sent` keeps every message as sent.
+// `f.races`: saves by someone else, each landing just before the bridge's next write (as on a real disk,
+// the bridge's text goes in regardless and the other save comes back as { replaced }).
+// Messages from the room wait while the bridge is inside sync(), as they do on a real socket.
+function rig(room, { text = null, token = TOKEN, saved = null } = {}) {
+  const f = { text, writes: 0, races: [] }, sent = [], warned = [], queue = [];
+  let busy = false;
+  const b = new Bridge({ board: "b1", saved, now: fast(), read: () => f.text, stamp: () => (f.nostamp ? null : String(f.n ?? 0)), warn: l => warned.push(l),
+    write: (t, expected) => { if (f.fail > 0) { f.fail--; throw new Error("the disk says no"); } const race = f.races.shift(); if (race) f.text = race(f.text); const was = f.text; f.text = t; f.writes++; f.n = (f.n ?? 0) + 1; if (was !== expected) return { replaced: was }; } });
+  const raw = b.sync.bind(b);
+  b.sync = () => {
+    let ok = false;
+    for (let i = 0; i < 50; i++) { busy = true; ok = raw(); busy = false; if (!queue.length || f.hold) break; while (queue.length) b.receive(queue.shift()); if (b.reconnect) break; }
+    return ok;
+  };
+  const connect = () => { const c = room.connect(m => { const w = wire(m); if (busy || f.hold) queue.push(w); else b.receive(w); }); b.open(token, m => { sent.push(m); deliver(room, c, wire(m)); }); return c; };
+  const conn = connect();
+  // sync until quiet, reconnecting when the bridge asks to
+  const run = () => { for (let i = 0; i < 40; i++) { if (b.reconnect) connect(); b.sync(); if (!b.reconnect && !b.again) break; } };
+  // hold(): the room's messages to the bridge wait (in flight on the network); release(keep?) delivers them, or only those `keep` passes
+  const hold = () => { f.hold = true; };
+  const withheld = [], release = (keep = null) => { f.hold = false; const all = [...withheld.splice(0), ...queue.splice(0)]; for (const m of all) if (!keep || keep(m)) b.receive(m); else withheld.push(m); };
+  return { b, f, sent, warned, conn, connect, run, hold, release, els: () => JSON.parse(f.text).elements, herdr: () => JSON.parse(f.text).appState.herdr };
+}
+const newRoom = () => new Room({ board: "b1", tenant: "t1", log: new MemoryLog() });
+// Another person on the board, straight on the room.
+function peer(room, token = "tok-bob") {
+  const r = new Replica({ client: "peer", now: fast() }), out = () => { for (const m of r.outgoing()) deliver(room, c, wire(m)); };
+  const c = room.connect(m => { const did = r.receive(wire(m)); p.did.push(did); out(); });
+  const p = { r, c, did: [], send: (stream, op) => { r.local(stream, op); out(); } };
+  for (const m of r.connectMessages(token, "b1")) deliver(room, c, wire(m));
+  return p;
+}
+const settingsOps = sent => sent.filter(m => m.t === "op" && m.op.appState).map(m => m.op.appState);
+
+test("protocol/ is plenary's packages/protocol, byte for byte (SOURCE.json); change it there, then re-copy", () => {
