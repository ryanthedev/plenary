+    const r2 = await drawh(["--server", s.url, "--board", "b1", "--once", "--token", TOKEN, f], { DRAWH_STATE_DIR: state, DRAWH_WRITE: write });   // the flag works too
+    expect(r2.code).toBe(0);
+    expect(s.hellos[1].since).toBe(before - 1);
+    expect([s.room.streams.board.get("mine").x, s.room.streams.board.get("mine").version]).toEqual([50, 3]);
+    expect(s.room.seq).toBe(before + 1);
+    expect(r2.out + r2.err).not.toContain(TOKEN);
+  } finally { s.stop(); done(dir); }
+}, 30000);
