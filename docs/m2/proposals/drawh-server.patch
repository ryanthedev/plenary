@@ -0,0 +1,141 @@
+// How drawh --server writes the board file without losing someone else's save.
+//
+// drawh and the pane both save by read, change, write a temp file, rename over the board. Nobody locks.
+// If the bridge did the same, a save landing between its read and its rename would be overwritten and gone.
+// So the bridge never throws the old file away unseen: it takes the old file in the same step that puts the
+// new one in place, reads it, and hands back anything it didn't expect, for the bridge to merge.
+//
+//   swap  (macOS, APFS): renamex_np(RENAME_SWAP) exchanges the new file and the board atomically. What
+//         was the board, whatever it was at that instant, is now under our temp name. No window at all.
+//         Node and bun have no call for it, so one short python (the one running drawh) makes it.
+//         Not every disk that accepts the call swaps: on FAT it returns success and just renames (one file
+//         is gone). So before the first write the swap is tried on two scratch files in the board's folder,
+//         and trusted only if both come out exchanged. HFS+ refuses the call; that is the link case too.
+//   link  (anywhere else, or DRAWH_WRITE=link): hard-link the board aside, rename the new file over it,
+//         read the linked copy. A save that landed before the link is in that copy. A save landing while
+//         the link and the rename run (two system calls, about a quarter of a millisecond on APFS: they
+//         queue on the folder with the other writer's rename) is not, and nothing can tell: it is lost.
+//         drawh's saves can be seen coming (its temp file, `<board>.drawh.tmp`), so the bridge waits for
+//         one to land before it starts; the pane's can't. The runner warns once when it has to use this mode.
+//
+//   none  (a disk with neither, exFAT): the bridge cannot replace the board without risking someone's
+//         save, so it doesn't: replace() throws NO_SAFE_WRITE. What the file has still goes to the board.
+//
+// Both rely on other writers replacing the file by rename (drawh, the pane's writeTextFile and its big-file
+// path all do). Someone writing the board in place can still lose a save.
+
+import { readFileSync, writeFileSync, renameSync, linkSync, unlinkSync, statSync } from "node:fs";
+import { spawnSync } from "node:child_process";
+
+const SWAP = `import ctypes, ctypes.util, os, sys
+if sys.platform != "darwin": sys.exit(3)
+libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
+if libc.renamex_np(os.fsencode(sys.argv[1]), os.fsencode(sys.argv[2]), 2) != 0:   # 2 = RENAME_SWAP
+    sys.exit(4 if ctypes.get_errno() == 2 else 3)
+`;
+const gone = path => { try { unlinkSync(path); } catch {} };
+const pause = ms => { try { Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms); } catch {} };
+const parses = text => { try { JSON.parse(text); return true; } catch { return false; } };
+
+export class BoardFile {
+  /** @param {string} path @param {{ python?: string, mode?: "swap" | "link", warn?: (line: string) => void, patience?: number }} [o]
+   *  `patience`: how long (ms) link mode waits for a drawh save that is on its way. */
+  constructor(path, { python = "python3", mode = "swap", warn = () => {}, patience = 300, link = linkSync } = {}) {
+    this.path = path; this.python = python; this.mode = mode === "link" ? "link" : "swap"; this.warn = warn;
+    this.link = link; this.probed = false;                  // (`link`: for tests of a disk without hard links)
+    this.patience = patience; this.theirTmp = `${path}.drawh.tmp`; this.stale = null;
+    this.tmp = `${path}.plenary-${process.pid}.tmp`;       // our own names: drawh's saves use `.drawh.tmp`
+    this.aside = `${path}.plenary-${process.pid}.old`;
+    this.kept = 0;
+  }
+
+  /** The board's text, or null when there is no file. */
+  read() { try { return readFileSync(this.path, "utf8"); } catch (e) { if (e.code === "ENOENT") return null; throw e; } }
+
+  /**
+   * Put `text` in place. Returns nothing when the file held `expected` (null: no file). When it held
+   * something else, `text` is in place all the same and the other text comes back as `{ replaced }`.
+   */
+  replace(text, expected) {
+    this.probe();
+    if (this.mode === "none") {
+      // Creating a board is safe anywhere (it fails if one appeared meanwhile); replacing one is not.
+      if (expected === null && this.read() === null) { try { writeFileSync(this.path, text, { flag: "wx" }); return; } catch (e) { if (e.code !== "EEXIST") throw e; } }
+      throw new Error(NO_SAFE_WRITE);
+    }
+    writeFileSync(this.tmp, text);
+    try { return this.exchange(expected); }
+    finally { gone(this.tmp); gone(this.aside); }
+  }
+
+  // Once, before the first write: does this disk really do what the mode needs? Tried on two scratch
+  // files beside the board, never on the board.
+  probe() {
+    if (this.probed) return;
+    this.probed = true;
+    const a = `${this.path}.plenary-${process.pid}.probe1`, b = `${this.path}.plenary-${process.pid}.probe2`, c = `${this.path}.plenary-${process.pid}.probe3`;
+    const text = p => { try { return readFileSync(p, "utf8"); } catch { return null; } };
+    try {
+      if (this.mode === "swap") {
+        writeFileSync(a, "1"); writeFileSync(b, "2");
+        const r = spawnSync(this.python, ["-c", SWAP, a, b], { stdio: "ignore" });
+        if (!(r.status === 0 && text(a) === "2" && text(b) === "1")) { this.mode = "link"; this.fellBack = true; }
+      }
+      if (this.mode === "link") {
+        writeFileSync(a, "1"); gone(c);
+        try { this.link(a, c); if (text(c) !== "1") throw new Error("no link"); } catch { this.mode = "none"; }
+      }
+    } finally { gone(a); gone(b); gone(c); }
+    if (this.mode === "none") this.warn(NO_SAFE_WRITE);
+    else if (this.fellBack) this.warn(LINK_WARNING);
+  }
+
+  // Link mode only. A drawh save shows before it lands: its temp file exists from the moment it starts
+  // writing until its rename. Wait for that rename, so the save is in the copy we link aside instead of
+  // in the window we can't see. One left behind by a drawh that died is waited for once, then ignored.
+  letDrawhLand() {
+    const stamp = () => { try { const s = statSync(this.theirTmp); return `${s.ino}:${s.mtimeMs}`; } catch { return null; } };
+    let seen = stamp();
+    if (seen === null || seen === this.stale) return;
+    for (const t0 = Date.now(); Date.now() - t0 < this.patience; ) { pause(1); seen = stamp(); if (seen === null) return; }
+    this.stale = seen;
+  }
+
+  exchange(expected) {
+    for (let tries = 0; tries < 4; tries++) {
+      let old = null, at = null;                           // what we replaced, and the name it is under now
+      if (this.read() === null) {                          // no board: create it, but never over one that just appeared
+        try { this.link(this.tmp, this.path); return; }    // (expected or not: there was nothing here to merge)
+        catch (e) { if (e.code !== "EEXIST") throw e; continue; }
+      }
+      if (this.mode === "swap") {
+        const r = spawnSync(this.python, ["-c", SWAP, this.tmp, this.path], { stdio: "ignore" });
+        if (r.status === 0) { at = this.tmp; }
+        else if (r.status === 4) continue;                 // the board vanished under us: start again
+        else { this.mode = "link"; this.warn(LINK_WARNING); }   // (it passed the probe, and fails now: python gone?)
+      }
+      if (this.mode === "link") {
+        this.letDrawhLand();
+        gone(this.aside);
+        try { this.link(this.path, this.aside); } catch (e) { if (e.code === "ENOENT") continue; throw e; }
+        renameSync(this.tmp, this.path);
+        at = this.aside;
+      }
+      old = readFileSync(at, "utf8");
+      if (old === expected) return;
+      // Someone else's save. Rename-writers leave it whole; give an in-place writer a moment to finish.
+      for (let i = 0; i < 6 && !parses(old); i++) { pause(50); old = readFileSync(at, "utf8"); }
+      if (!parses(old)) {
+        const keep = `${this.path}.plenary-unmerged-${Date.now()}-${++this.kept}`;
+        renameSync(at, keep);
+        this.warn(`a save by someone else was not valid JSON when the bridge replaced it; kept as ${keep}, not merged`);
+        return;
+      }
+      return { replaced: old };
+    }
+    throw new Error(`${this.path} keeps appearing and disappearing`);
+  }
+}
+
+export const NO_SAFE_WRITE = "this disk can neither swap two files nor hard-link one (FAT or exFAT?), so the bridge can't replace the board file without risking someone else's save, and won't: what the board has is NOT written to this file; changes made in the file still go to the board";
+export const LINK_WARNING = "replacing the board file in two steps (this disk can't swap files in one, or DRAWH_WRITE=link asked for it): a save by the pane, or by drawh, that lands in exactly that instant can be lost";
