+/** Is `value` nested deeper than `max` levels (the value itself is level 1)? A loop, never recursion. */
+export function deeperThan(value, max) {
+  const values = [value], depths = [1];
+  while (values.length) {
+    const v = values.pop(), d = depths.pop();
+    if (!v || typeof v !== "object") continue;
+    if (d > max) return true;
+    for (const k in v) { const inner = v[k]; if (inner && typeof inner === "object") { values.push(inner); depths.push(d + 1); } }
+  }
+  return false;
+}
+
+/**
+ * What's wrong with an op message, or null. Shape first (`bad-op`, `no-files`, `too-large`), then the id
+ * and `sentAt` (§ Limits, order of checks), so a bad id never hides a shape error. Roles are the room's job.
+ * @param {object} msg
+ * @param {number} [bytes] the op's JSON size in UTF-8 bytes, when the caller already has it (v1.1: bytes, no longer chars)
+ * @returns {null | { code: string, message: string }}
+ */
+export function opProblem(msg, bytes) {
+  if (!STREAMS.includes(msg.stream)) return bad(`unknown stream ${JSON.stringify(msg.stream)}`);
+  const op = msg.op;
+  if (!isObj(op)) return bad("op must be an object");
+  // Before anything walks or encodes the op: a very deep one would overflow the stack of whatever does.
+  if (deeperThan(op, MAX_OP_DEPTH)) return bad(`an op nests at most ${MAX_OP_DEPTH} levels deep`);
+  if (op.files) return { code: "no-files", message: "pictures go through the blob port, not in ops" };
+  if (msg.stream === "records") { const why = recordProblem(op); if (why) return why; }
+  else {
+    if (op.elements !== undefined) {
+      if (!Array.isArray(op.elements)) return bad("elements must be an array");
+      for (const el of op.elements) {
+        if (!el || !isId(el.id)) return bad("every element needs a string id (at most 64 characters)");
+        // A tie on version is broken by versionNonce on every copy alike; without one, copies disagree.
+        if (!Number.isSafeInteger(el.version) || el.version < 0 || !Number.isSafeInteger(el.versionNonce)) return bad("every element needs integer version and versionNonce");
+        if (el.type === "image" && el.fileId != null && !isSha1(el.fileId)) return bad("an image's fileId is 40 lowercase hex characters");
+      }
+    }
+    if (op.appState !== undefined) { const why = appStateProblem(op.appState); if (why) return bad(why); }
+    // § Settings: a settings op stands alone and names the appSeq each key was based on.
+    if (op.appState !== undefined && op.elements !== undefined) return bad("a settings op carries no elements: send them as two ops");
+    if (op.appState !== undefined || op.appBase !== undefined) { const why = appBaseProblem(op.appState, op.appBase); if (why) return bad(why); }
+    if (!op.elements?.length && !op.appState) return bad("empty op");
+  }
+  if ((bytes ?? utf8Bytes(JSON.stringify(op))) > MAX_OP_BYTES) return { code: "too-large", message: `an op is limited to ${MAX_OP_BYTES} bytes of UTF-8 JSON` };
+  if (!parseOpId(msg.id)) return bad("op ids are client:counter, the counter a positive integer");
+  if (!Number.isSafeInteger(msg.sentAt) || msg.sentAt < 0) return bad("op needs sentAt (the seq you had applied when you first sent it)");
+  return null;
+}
+
+const RECORD_ACTIONS = ["thread", "reply", "edit", "delete", "resolve", "reopen", "move", "react"];
+
+function anchorProblem(a) {
+  if (!isObj(a)) return "anchor must be an object";
+  if (a.point !== undefined) return isObj(a.point) && isNum(a.point.x) && isNum(a.point.y) && Object.keys(a).length === 1 ? null : "a point anchor is { point: { x, y } }";
+  if (!ELEMENT_STREAMS.includes(a.stream) || !isId(a.element) || !isNum(a.x) || !isNum(a.y)) return "an element anchor is { stream, element, x, y }";
+  return null;
+}
+
+/**
+ * What's wrong with the shape of one `records` action, or null. Whether its target exists and who may do
+ * it depend on the board, so the room checks those (records.js).
+ * @returns {null | { code: string, message: string }}
+ */
+export function recordProblem(op) {
+  if (!isObj(op) || !RECORD_ACTIONS.includes(op.do)) return bad(`unknown record action ${JSON.stringify(op?.do)}`);
+  if (!isId(op.id)) return bad("a record action needs an id (at most 64 characters)");
+  if (op.do === "thread" || op.do === "reply" || op.do === "edit") {
+    if (typeof op.text !== "string" || !op.text.length) return bad("a comment needs text");
+    if (op.text.length > CAPS.records.text) return { code: "limit", message: `a comment is limited to ${CAPS.records.text} characters` };
+  }
+  if (op.do === "reply" && !isId(op.thread)) return bad("a reply names its thread");
+  if (op.do === "thread" || op.do === "move") { const why = anchorProblem(op.anchor); if (why) return bad(why); }
+  if (op.do === "react") {
+    if (typeof op.emoji !== "string" || !op.emoji.length || op.emoji.length > CAPS.records.emojiChars) return bad(`an emoji is 1 to ${CAPS.records.emojiChars} characters`);
+    if (typeof op.on !== "boolean") return bad("react needs on: true or false");
+  }
+  return null;
+}
+
+// Board settings a patch may set (appState.herdr), each checked, so a patch can't put junk in front of
+// every client. Unknown keys are refused.
+const APP_KEYS = {
+  layers: v => Array.isArray(v) && v.length >= 1 && v.length <= 100 && v.every(l => isObj(l) && typeof l.id === "string" && l.id.length <= 64 &&
+    typeof l.name === "string" && l.name.length <= 200 && typeof l.visible === "boolean" && typeof l.locked === "boolean" &&
+    typeof l.opacity === "number" && l.opacity >= 0 && l.opacity <= 100),
+  grid: v => typeof v === "number" && Number.isFinite(v) && v >= 0 && v <= 1000,
+  snap: v => typeof v === "boolean",
+  timeline: v => isObj(v) && typeof v.duration === "number" && Number.isFinite(v.duration) && v.duration >= 0 && v.duration <= 3_600_000,
+};
+export function appStateProblem(patch) {
+  if (!isObj(patch)) return "appState must be an object";
+  for (const [k, v] of Object.entries(patch)) {
+    // Own keys only: "__proto__" or "constructor" would otherwise find Object.prototype's members.
+    if (!Object.prototype.hasOwnProperty.call(APP_KEYS, k)) return `unknown board setting ${JSON.stringify(k)}`;
+    if (!APP_KEYS[k](v)) return `bad value for ${k}`;
+  }
+  return null;
+}
+
+/**
+ * § Settings (compare-and-set): `appBase` has exactly the keys of `appState`, each an integer ≥ 0 (the
+ * appSeq that key's value was based on). Missing, extra or non-integer keys, or a base with no settings → a reason.
+ */
+export function appBaseProblem(appState, appBase) {
+  if (appState === undefined) return "appBase goes only with appState";
+  if (!isObj(appBase)) return "a settings op names its base: appBase { key: appSeq }";
+  const keys = Object.keys(appState), bases = Object.keys(appBase);
+  if (bases.length !== keys.length) return "appBase names exactly the keys appState sets";
+  for (const k of keys) {
+    if (!Object.prototype.hasOwnProperty.call(appBase, k)) return `appBase is missing ${k}`;
+    if (!Number.isSafeInteger(appBase[k]) || appBase[k] < 0) return `appBase.${k} must be an integer ≥ 0`;
+  }
+  return null;
+}
+
+/** appState patch keys win by seq: the value from the highest-seq op that set each key. */
+export function mergeAppState(state, seqs, patch, seq) {
+  for (const [k, v] of Object.entries(patch)) {
+    if (!Object.prototype.hasOwnProperty.call(APP_KEYS, k)) continue;   // never a prototype key, whoever sent it
+    if (seq > (seqs[k] ?? 0)) { state[k] = v; seqs[k] = seq; }
+  }
+}
diff --git a/mods/herdr-draw/protocol/ports.js b/mods/herdr-draw/protocol/ports.js
new file mode 100644
index 0000000..d64dfca
--- /dev/null
+++ b/mods/herdr-draw/protocol/ports.js
@@ -0,0 +1,88 @@
+// What a room needs from the outside world, as interfaces, plus in-memory versions for tests and
+// single-process use. A deployment swaps these (SQLite, Postgres, a bus) without touching the room.
+// The server's ports are async (PROTOCOL.md § Ports); the ones here are synchronous, and a room takes both.
+
+/**
+ * The durable log of one board, as a room sees it (the server binds tenant and board).
+ * `append` writes every entry or none, and only if the log ends at `expectSeq`; else it throws an error
+ * with `code: "conflict"`. It returns (or resolves) only once the entries are durable: a room acks after it.
+ * @typedef {{
+ *   append(entries: object[], expectSeq: number): void | Promise<void>,
+ *   putCheckpoint?(cp: object): void | Promise<void>,
+ *   openEpoch?(): number,
+ * }} Log
+ */
+
+/**
+ * The server's ports (PROTOCOL.md § Ports), all async. A room is handed none of them: the server gives it a
+ * per-board Log (above) made from the Store, and the verified identity with each hello.
+ * @typedef {{ verify(token: string): Promise<null | { user: string, name: string, email: string, domain: string }>,
+ *             role(identity: object, board: string): Promise<null | string> }} Auth  null = refused; a throw = unavailable
+ * @typedef {{ append(tenant: string, board: string, entries: object[], expectSeq: number): Promise<void>,
+ *             read(tenant: string, board: string, fromSeq: number, limit: number): Promise<object[]>,
+ *             putCheckpoint(tenant: string, board: string, cp: object): Promise<void>,
+ *             getCheckpoint(tenant: string, board: string, beforeSeq?: number): Promise<null | object>,
+ *             openEpoch(tenant: string, board: string): Promise<number>,
+ *             epoch(tenant: string, board: string): Promise<number> }} Store
+ *   openEpoch: a durable atomic increment of the board's epoch (1 on the first call), kept with its lease
+ *   record; every room build calls it before its first welcome. epoch: reads it, 0 = no room was ever built.
+ * @typedef {{ publish(subject: string, msg: object): void, subscribe(subject: string, fn: (msg: object) => void): () => void }} Bus  at-most-once
+ * @typedef {{ put(tenant: string, sha1: string, bytes: Uint8Array): Promise<void>, get(tenant: string, sha1: string): Promise<null | Uint8Array> }} Blobs
+ */
+
+const copy = v => JSON.parse(JSON.stringify(v));
+const fail = (code, message) => Object.assign(new Error(message), { code });
+
+/**
+ * Who is this token on this board? For tests: token → { user, role } (any board), or
+ * { user, boards: { [board]: role } }. null = refused. The room never calls it; a gateway does (rule 8).
+ */
+export function tableAuth(table) {
+  return {
+    check(token, board) {
+      const who = Object.prototype.hasOwnProperty.call(table, token) ? table[token] : null;
+      const role = who && (who.boards ? who.boards[board] : who.role);
+      return role ? { user: who.user, role, ...(who.name ? { name: who.name } : {}) } : null;
+    },
+  };
+}
+
+/** A Log in memory, with the Store's contract for one board: conditional append, read, checkpoints. */
+export class MemoryLog {
+  constructor() { this.entries = []; this.checkpoints = []; this.epochN = 0; }
+
+  /** A room is being built: the board's next epoch (1 on the first call), kept apart from the checkpoints (§ Recovery, Room identity). */
+  openEpoch() { return ++this.epochN; }
+  /** The latest epoch handed out; 0 = no room was ever built. */
+  epoch() { return this.epochN; }
+
+  /** The last seq in the log (0 when empty). */
+  get end() { return this.entries.length ? this.entries[this.entries.length - 1].seq : 0; }
+
+  append(entries, expectSeq) {
+    if (!Array.isArray(entries) || !entries.length) throw fail("bad-append", "append takes a list of entries");
+    if (expectSeq !== this.end) throw fail("conflict", `the log ends at ${this.end}, not ${expectSeq}`);
+    for (let i = 0; i < entries.length; i++) if (entries[i].seq !== expectSeq + 1 + i) throw fail("bad-append", "entries must follow the log's end, one seq each");
+    this.entries.push(...entries);
+  }
+
+  /** Entries with seq ≥ fromSeq, ascending. */
+  read(fromSeq = 1, limit = Infinity) {
+    const first = this.entries.length ? this.entries[0].seq : 1, at = Math.max(0, fromSeq - first);
+    return this.entries.slice(at, limit === Infinity ? undefined : at + limit);
+  }
+
+  /** The highest seq wins, never the last write. */
+  putCheckpoint(cp) {
+    const mine = copy(cp), at = this.checkpoints.findIndex(c => c.seq >= mine.seq);
+    if (at < 0) this.checkpoints.push(mine);
+    else if (this.checkpoints[at].seq === mine.seq) this.checkpoints[at] = mine;
+    else this.checkpoints.splice(at, 0, mine);
+  }
+
+  /** The latest checkpoint, or the latest below `beforeSeq` (to step back from a bad one). null if none. */
+  getCheckpoint(beforeSeq = Infinity) {
+    for (let i = this.checkpoints.length - 1; i >= 0; i--) if (this.checkpoints[i].seq < beforeSeq) return copy(this.checkpoints[i]);
+    return null;
+  }
+}
diff --git a/mods/herdr-draw/protocol/presence.js b/mods/herdr-draw/protocol/presence.js
new file mode 100644
index 0000000..93d8200
--- /dev/null
+++ b/mods/herdr-draw/protocol/presence.js
@@ -0,0 +1,95 @@
+// Presence (PROTOCOL.md § Presence): cursors, selections, laser, previews, emotes. Never sequenced, never
+// logged, may drop at any hop. A room never sees it; gateways check, rate-limit, coalesce and relay it.
+// Pure, with the clock passed in.
+
+import { ELEMENT_STREAMS, ROLES, canWrite, deeperThan, MAX_ID_CHARS, MAX_OP_DEPTH } from "./envelope.js";
+
+const WRITERS = ["owner", "editor", "annotator", "commenter"];
+/** Per kind: who may send it, and how many per second per connection. */
+export const PRESENCE = {
+  cursor: { roles: WRITERS, rate: 20 },
+  select: { roles: WRITERS, rate: 5 },
+  laser: { roles: ["owner", "editor"], rate: 30 },
+  preview: { roles: WRITERS, rate: 20 },   // and only by a writer of that stream
+  emote: { roles: ROLES, rate: 4 },
+};
+export const EMOTES = ["👍", "❤️", "😂", "🎉", "👏", "😮", "🙏", "🔥"];
+export const MAX_SELECT_IDS = 500, MAX_LASER_POINTS = 64, MAX_PREVIEW_ELEMENTS = 50, MAX_PREVIEW_CHARS = 64_000;
+export const PREVIEW_TTL_MS = 5000;
+
+const isNum = v => typeof v === "number" && Number.isFinite(v);
+const isId = v => typeof v === "string" && v.length > 0 && v.length <= MAX_ID_CHARS;
+
+/**
+ * What's wrong with a presence message from someone with `role`, or null. A bad one is dropped silently:
+ * presence never gets an error.
+ * @returns {null | string}
+ */
+export function presenceProblem(msg, role) {
+  if (!msg || typeof msg !== "object" || !Object.prototype.hasOwnProperty.call(PRESENCE, msg.k)) return "unknown presence kind";
+  if (!PRESENCE[msg.k].roles.includes(role)) return `${role} can't send ${msg.k}`;
+  if (msg.k === "cursor") return isNum(msg.x) && isNum(msg.y) ? null : "cursor needs x and y";
+  if (msg.k === "select") {
+    if (!ELEMENT_STREAMS.includes(msg.stream)) return "select names a stream";
+    return Array.isArray(msg.ids) && msg.ids.length <= MAX_SELECT_IDS && msg.ids.every(isId) ? null : `select holds at most ${MAX_SELECT_IDS} ids`;
+  }
+  if (msg.k === "laser") {
+    const ok = Array.isArray(msg.pts) && msg.pts.length >= 1 && msg.pts.length <= MAX_LASER_POINTS && msg.pts.every(p => Array.isArray(p) && p.length === 3 && p.every(isNum));
+    return ok ? null : `laser holds 1 to ${MAX_LASER_POINTS} points of [x, y, t]`;
+  }
+  if (msg.k === "preview") {
+    if (!ELEMENT_STREAMS.includes(msg.stream) || !canWrite(role, msg.stream)) return "preview needs a stream you can write";
+    if (!Array.isArray(msg.elements) || !msg.elements.length || msg.elements.length > MAX_PREVIEW_ELEMENTS) return `preview holds 1 to ${MAX_PREVIEW_ELEMENTS} elements`;
+    if (!msg.elements.every(el => el && typeof el === "object" && isId(el.id))) return "every preview element needs an id";
+    if (deeperThan(msg.elements, MAX_OP_DEPTH)) return "preview nests too deep";
+    return JSON.stringify(msg.elements).length <= MAX_PREVIEW_CHARS ? null : "preview is too large";
+  }
+  return EMOTES.includes(msg.e) ? null : "unknown emote";
+}
+
+/**
+ * One connection's presence rates: a bucket per kind, `rate` a second, at most one second's worth saved up.
+ * @param {() => number} now a clock in ms
+ * @returns {{ allow(k: string): boolean }} false = over the rate: drop it, no error
+ */
+export function presenceLimiter(now) {
+  const buckets = {};
+  return {
+    allow(k) {
+      if (!Object.prototype.hasOwnProperty.call(PRESENCE, k)) return false;
+      const rate = PRESENCE[k].rate, t = now();
+      const b = buckets[k] ?? (buckets[k] = { tokens: rate, at: t });
+      b.tokens = Math.min(rate, b.tokens + Math.max(0, t - b.at) * rate / 1000); b.at = t;
+      if (b.tokens < 1) return false;
+      b.tokens -= 1;
+      return true;
+    },
+  };
+}
+
+/**
+ * Gathers presence between two sends and gives back one batch: the latest cursor and selection per
+ * (user, client), the latest preview per element, every laser batch and emote, and `leave`.
+ * @returns {{ add(user: string, client: string, msg: object): void, leave(user: string, client: string): void, flush(): object[], size: number }}
+ */
+export function presenceCoalescer() {
+  let latest = new Map(), each = [];
+  const key = (user, client, rest) => JSON.stringify([user, client, rest]);
+  return {
+    add(user, client, msg) {
+      if (msg.k === "cursor") latest.set(key(user, client, "cursor"), { user, client, k: "cursor", x: msg.x, y: msg.y });
+      else if (msg.k === "select") latest.set(key(user, client, "select"), { user, client, k: "select", stream: msg.stream, ids: msg.ids });
+      else if (msg.k === "preview") for (const el of msg.elements) latest.set(key(user, client, ["preview", msg.stream, el.id]), { user, client, k: "preview", stream: msg.stream, elements: [el] });
+      else if (msg.k === "laser") each.push({ user, client, k: "laser", pts: msg.pts });
+      else if (msg.k === "emote") each.push({ user, client, k: "emote", e: msg.e });
+    },
+    /** The connection is gone: what it had waiting goes with it, and the others are told. */
+    leave(user, client) {
+      for (const [k, m] of latest) if (m.user === user && m.client === client) latest.delete(k);
+      each = each.filter(m => !(m.user === user && m.client === client));
+      each.push({ user, client, k: "leave" });
+    },
+    flush() { const batch = [...latest.values(), ...each]; latest = new Map(); each = []; return batch; },
+    get size() { return latest.size + each.length; },
+  };
+}
diff --git a/mods/herdr-draw/protocol/records.js b/mods/herdr-draw/protocol/records.js
new file mode 100644
index 0000000..248cbd1
--- /dev/null
+++ b/mods/herdr-draw/protocol/records.js
@@ -0,0 +1,156 @@
+// Comment threads and reactions (PROTOCOL.md § Records): the state behind the `records` stream.
+// Records don't merge by version: every copy applies the same actions in seq order. The room checks an
+// action before logging it (`check`), so `apply` never meets a forbidden one; an action on a deleted
+// comment or a hidden thread is accepted and changes nothing (a no-op, the same on every copy).
+// Pure: a room and a replica both use it.
+
+import { CAPS, canModerate } from "./envelope.js";
+
+const bad = message => ({ code: "bad-op", message });
+const limit = message => ({ code: "limit", message });
+const forbidden = message => ({ code: "forbidden", message });
+const copy = v => JSON.parse(JSON.stringify(v));
+
+// Size is a function of the state alone (not of how it was reached), so a rebuilt room counts the same.
+const THREAD_CHARS = 64, COMMENT_CHARS = 64, REACTION_CHARS = 8;
+const threadChars = t => THREAD_CHARS + JSON.stringify(t.anchor).length;
+const reactionChars = (emoji, user) => REACTION_CHARS + emoji.length + String(user).length;
+
+export class Records {
+  /** @param {{ threads: object[] }} [data] the snapshot shape (§ Records, "Shape in snapshots") */
+  constructor(data) { this.load(data); }
+
+  load(data) {
+    this.threads = new Map();    // thread id → { id, anchor, by, at, resolved?, comments: [] }, in creation order
+    this.comments = new Map();   // comment id → { thread, comment }; a thread's first comment has the thread's id
+    this.chars = 0;
+    this.rev = (this.rev ?? 0) + 1;
+    for (const raw of data?.threads ?? []) {
+      const t = { id: raw.id, anchor: copy(raw.anchor), by: raw.by, name: raw.name ?? null, at: raw.at, ...(raw.resolved ? { resolved: copy(raw.resolved) } : {}), comments: [] };
+      this.threads.set(t.id, t); this.chars += threadChars(t);
+      for (const rc of raw.comments ?? []) {
+        const c = { id: rc.id, by: rc.by, name: rc.name ?? null, at: rc.at, text: rc.text, ...(rc.edited !== undefined ? { edited: rc.edited } : {}), ...(rc.deleted !== undefined ? { deleted: rc.deleted } : {}), reactions: new Map() };
+        for (const [emoji, users] of Object.entries(rc.reactions ?? {})) { c.reactions.set(emoji, [...users]); for (const u of users) this.chars += reactionChars(emoji, u); }
+        t.comments.push(c); this.comments.set(c.id, { thread: t, comment: c }); this.chars += COMMENT_CHARS + c.text.length;
+      }
+    }
+  }
+
+  /** The snapshot shape: plain data, tombstones included. */
+  toJSON() {
+    const threads = [];
+    for (const t of this.threads.values()) threads.push({
+      id: t.id, anchor: copy(t.anchor), by: t.by, name: t.name, at: t.at, ...(t.resolved ? { resolved: { ...t.resolved } } : {}),
+      // fromEntries defines own keys, so an emoji named like a prototype key stays plain data.
+      comments: t.comments.map(c => ({ id: c.id, by: c.by, name: c.name, at: c.at, text: c.text, ...(c.edited !== undefined ? { edited: c.edited } : {}), ...(c.deleted !== undefined ? { deleted: c.deleted } : {}), reactions: Object.fromEntries([...c.reactions].map(([e, us]) => [e, [...us]])) })),
+    });
+    return { threads };
+  }
+
+  static hidden(t) { return t.comments[0].deleted !== undefined; }
+  dead(found) { return !found || found.comment.deleted !== undefined || Records.hidden(found.thread); }
+
+  /**
+   * May `by` (with `role`) do this action now? null = yes (also for a no-op on a dead target).
+   * The room calls this before logging; replay never does (a logged action was already accepted).
+   * @returns {null | { code: string, message: string }}
+   */
+  check(op, by, role) {
+    const t = this.threads.get(op.do === "reply" ? op.thread : op.id), found = this.comments.get(op.id);
+    let grows = false;
+    if (op.do === "thread") {
+      if (found) return bad("that record id is in use");
+      if (this.threads.size >= CAPS.records.threads) return limit(`a board holds at most ${CAPS.records.threads} threads`);
+      grows = true;
+    } else if (op.do === "reply") {
+      if (found) return bad("that record id is in use");
+      if (!t) return bad("no such thread");
+      if (Records.hidden(t)) return null;
+      if (t.comments.length >= CAPS.records.comments) return limit(`a thread holds at most ${CAPS.records.comments} comments`);
+      grows = true;
+    } else if (op.do === "edit") {
+      if (!found) return bad("no such comment");
+      if (found.comment.by !== by) return forbidden("only its author edits a comment");
+      if (this.dead(found)) return null;
+      grows = op.text.length > found.comment.text.length;
+    } else if (op.do === "delete") {
+      if (!found) return bad("no such comment");
+      if (found.comment.by !== by && !canModerate(role)) return forbidden("that comment is someone else's");
+    } else if (op.do === "resolve" || op.do === "reopen") {
+      if (!t) return bad("no such thread");
+    } else if (op.do === "move") {
+      if (!t) return bad("no such thread");
+      if (t.by !== by && !canModerate(role)) return forbidden("that thread is someone else's");
+      grows = !Records.hidden(t);
+    } else if (op.do === "react") {
+      if (!found) return bad("no such comment");
+      if (this.dead(found)) return null;
+      const r = found.comment.reactions;
+      if (op.on && !r.has(op.emoji) && r.size >= CAPS.records.emoji) return limit(`a comment holds at most ${CAPS.records.emoji} different emoji`);
+      grows = op.on;
+    } else return bad("unknown record action");
+    if (grows && this.chars + JSON.stringify(op).length > CAPS.records.chars) return limit("the board's comments are full");
+    return null;
+  }
+
+  /**
+   * Apply one accepted action. `by`, `at` and `name` (the author's display name when it was written) come
+   * from the log entry, never the payload. True if anything changed; a no-op is decided from the state
+   * alone, so replay agrees.
+   */
+  apply(op, by, at, name = null) {
+    const changed = this.act(op, by, at, name);
+    if (changed) this.rev++;
+    return changed;
+  }
+
+  act(op, by, at, name) {
+    if (!op || typeof op !== "object") return false;
+    if (op.do === "thread") {
+      if (this.comments.has(op.id) || this.threads.has(op.id)) return false;
+      const t = { id: op.id, anchor: copy(op.anchor), by, name, at, comments: [] };
+      this.threads.set(t.id, t); this.chars += threadChars(t);
+      return this.add(t, op, by, at, name);
+    }
+    if (op.do === "reply") {
+      const t = this.threads.get(op.thread);
+      if (!t || Records.hidden(t) || this.comments.has(op.id)) return false;
+      return this.add(t, op, by, at, name);
+    }
+    if (op.do === "resolve" || op.do === "reopen" || op.do === "move") {
+      const t = this.threads.get(op.id);
+      if (!t || Records.hidden(t)) return false;
+      if (op.do === "move") { this.chars -= threadChars(t); t.anchor = copy(op.anchor); this.chars += threadChars(t); return true; }
+      if ((op.do === "resolve") === !!t.resolved) return false;   // repeating is a no-op
+      if (op.do === "resolve") t.resolved = { by, name, at }; else delete t.resolved;
+      return true;
+    }
+    const found = this.comments.get(op.id);
+    if (!found) return false;
+    const c = found.comment;
+    if (op.do === "delete") {
+      if (c.deleted !== undefined) return false;
+      this.chars -= c.text.length;
+      for (const [emoji, users] of c.reactions) for (const u of users) this.chars -= reactionChars(emoji, u);
+      c.text = ""; c.reactions = new Map(); c.deleted = at;
+      return true;
+    }
+    if (this.dead(found)) return false;
+    if (op.do === "edit") { this.chars += op.text.length - c.text.length; c.text = op.text; c.edited = at; return true; }
+    if (op.do === "react") {
+      // Set, never flip: keyed by (comment, user, emoji), so a resend or a replay lands the same.
+      const users = c.reactions.get(op.emoji) ?? [], has = users.includes(by);
+      if (op.on === has) return false;
+      if (op.on) { users.push(by); c.reactions.set(op.emoji, users); this.chars += reactionChars(op.emoji, by); }
+      else { users.splice(users.indexOf(by), 1); if (!users.length) c.reactions.delete(op.emoji); this.chars -= reactionChars(op.emoji, by); }
+      return true;
+    }
+    return false;
+  }
+
+  add(t, op, by, at, name) {
+    const c = { id: op.id, by, name, at, text: op.text, reactions: new Map() };
+    t.comments.push(c); this.comments.set(c.id, { thread: t, comment: c }); this.chars += COMMENT_CHARS + c.text.length;
+    return true;
+  }
+}
diff --git a/mods/herdr-draw/protocol/replica.js b/mods/herdr-draw/protocol/replica.js
new file mode 100644
index 0000000..dd5604d
--- /dev/null
+++ b/mods/herdr-draw/protocol/replica.js
@@ -0,0 +1,605 @@
+// A client's copy of a board (PROTOCOL.md v1.1): applies the room's entries in seq order, whatever order they
+// arrive in, and shows its own ops at once (optimistic) until the room acknowledges them.
+// Runs in a browser, a phone, Node or a Herdr pane: imports only the core's model and merge rules.
+//
+// How a caller drives it (the Replica never touches a socket or a timer; the clock is passed in):
+//   1. On every new connection: send connectMessages(token, board) (the hello, nothing else).
+//   2. Give every message from the server to receive(msg). It returns what it applied.
+//   3. A local change: local(stream, op). Do NOT send what it returns yourself. A change with both elements
+//      and settings goes out as two ops (elements first). Settings carry `appBase` and are sent one op per
+//      (stream, key) at a time; later changes wait (`held`) and show at once. receive() reports refused
+//      settings in `did.refusedSettings` and, once a refused key's conflict is applied here, `did.retryReady`.
+//   4. After each of 1–3, and when a timer set from wait() fires: send everything outgoing() returns.
+//      outgoing() holds ops back until `welcome`, holds new ops until catch-up is done, sends each op once
+//      per connection and paces them to the published rate (rule 2, § Limits).
+//   5. When `resync` is set: close the connection, wait reconnectWait() ms, open a new one, start again
+//      at 1. It is set by a refused op (the copy was reset: since 0), by `unavailable`, and by the
+//      timeouts of rules 2 and 12 (no welcome, no catch-up progress, or no answer to an op for 10 s).
+//      `stopped` ("version"): the app must update. `needAuth`: sign in again first.
+
+import { Doc } from "../core/doc.js";
+import { emptyScene, clone, randomInt } from "../core/model.js";
+import { ELEMENT_STREAMS, PROTOCOL_VERSION, RULES, OP_RATE, OP_TIMEOUT_MS, CONNECT_TIMEOUT_MS, BACKOFF, mergeAppState, appBaseProblem } from "./envelope.js";
+import { Records } from "./records.js";
+import { PREVIEW_TTL_MS } from "./presence.js";
+
+export class Replica {
+  /** @param {{ client: string, now?: () => number, random?: () => number }} o — a name for this client (each
+   *  Replica adds its own session part, so a reloaded page reusing the name never collides with its old op
+   *  ids), a clock in ms, and a random source in [0, 1) for the backoff's jitter. */
+  constructor({ client, now = Date.now, random = Math.random }) {
+    this.client = `${client}.${Math.floor(Math.random() * 2 ** 31).toString(36)}`; this.counter = 0;
+    this.now = now; this.random = random;
+    this.fails = 0;             // failed connections in a row (rule 12); back to 0 only after a proven connection
+    this.goodAt = null;         // when this connection caught up to welcome.seq (null: not yet)
+    this.helloAt = null; this.progressAt = null;
+    this.pending = new Map();   // op id → { stream, op, msg, ackSeq?, wrote, answered, resend }: kept across resets and connections
+    this.tokens = OP_RATE.burst; this.tokensAt = now();   // the send pace: a bucket of OP_RATE
+    this.unconfirmed = 0;       // ops dropped without knowing whether they landed (the UI says so after the resync)
+    this.user = null; this.role = null;
+    this.stopped = null; this.needAuth = false; this.resync = false;
+    this.welcomed = false; this.target = null; this.horizon = 0; this.staleSeen = false;
+    this.board = null;          // the board of the current hello (welcome.room.board must match)
+    this.early = [];            // entries and snapshots of this connection that arrived before its welcome
+    this.epoch = null;          // the last welcome.room.epoch seen (viewers only record it)
+    this.epochSeen = 0;         // the highest epoch seen in a writer's welcome (rule 12; kept across resets)
+    // § Settings. Kept across resets and connections, like pending ops:
+    this.held = {};             // stream → { key: value }: settings changes waiting for a key's op in flight (or its retry gate)
+    this.floor = {};            // stream → { key: seq }: the seq of my latest acknowledged settings op per key
+    this.gates = [];            // refused (stale-setting) ops: [{ id, stream, appBase }] until a key's confirmed appSeq passes its base
+    this.seen = {};             // stream → { key: appSeq }: the newest confirmed appSeq per key, kept across resets (what the user saw)
+    this.heldBase = {};         // stream → { key: base }: each held key's base, fixed when its latest change was made
+    for (const s of ELEMENT_STREAMS) { this.held[s] = null; this.floor[s] = {}; this.seen[s] = {}; this.heldBase[s] = {}; }
+    this.reset();
+  }
+
+  /** Forget the room's copy (a resync follows). Pending ops are kept, and stay shown on top of the empty copy. */
+  reset() {
+    // § Settings: a resync doesn't lower a key's base. Keep what this copy had confirmed before it goes.
+    if (this.appSeq) for (const s of ELEMENT_STREAMS) for (const [k, v] of Object.entries(this.appSeq[s] ?? {})) if (v > (this.seen[s][k] ?? 0)) this.seen[s][k] = v;
+    this.applied = 0;                    // the highest seq applied; everything up to it is in
+    this.streams = {}; this.confirmed = {}; this.appSeq = {}; this.confirmedVersion = {};
+    for (const s of ELEMENT_STREAMS) {
+      this.confirmedVersion[s] = new Map();   // element id → the version of the room's copy (pending ops not counted)
+      this.streams[s] = new Doc(emptyScene());
+      this.confirmed[s] = { ...this.streams[s].appState.herdr };   // appState as the room ordered it
+      this.appSeq[s] = {};
+    }
+    this.confirmedRecords = new Records();   // comments and reactions as the room ordered them
+    this.noteAuthor = new Map();         // notes element id → who made it (which notes an annotator may change)
+    this.buffer = new Map();             // seq → entry, arrived ahead of a gap
+    this.previewBy = new Map();          // "stream\nid" → { stream, el, user, client, at }: others' in-flight previews (display only)
+    this.previews = new Map();           // element id → element, every stream together (kept for callers that predate previewsOf)
+    this.overlay();
+  }
+
+  // Pending ops on top of the room's copy.
+  overlay() {
+    this.restampAll();
+    for (const s of ELEMENT_STREAMS) this.showAppState(s);
+    this.recordsRev = (this.recordsRev ?? 0) + 1;
+  }
+
+  /** The hello for a new connection. Unacknowledged ops follow through outgoing(), once welcomed. */
+  connectMessages(token, board) {
+    // A stale op was dropped but the copy still shows it (the connection ended before the resync): start from 0.
+    if (this.staleSeen) { this.staleSeen = false; this.reset(); }
+    this.resync = false; this.needAuth = false; this.welcomed = false; this.target = null; this.board = board;
+    this.early = [];   // entries and snapshots of this connection that arrived before its welcome
+    this.proven();
+    this.helloAt = this.now(); this.progressAt = null; this.counted = false;
+    for (const p of this.pending.values()) { p.wrote = null; p.answered = false; p.resend = p.msg.sentAt !== undefined; }
+    return [{ t: "hello", v: PROTOCOL_VERSION, token, board, since: this.applied, client: this.client }];
+  }
+
+  /**
+   * A local change: shown now, queued for the room (send it with outgoing()). On an element stream every
+   * element goes out one version past the highest this replica knows for its id (confirmed or pending),
+   * with a fresh versionNonce, so an editor's per-move version bumps never reach the wire.
+   *
+   * `keepVersions` (an import, drawh's seeding): elements go out with their own version and nonce, and are
+   * never re-stamped, not even on a resync. Deciding which to renumber or hold back is the importer's job
+   * (PROTOCOL.md § The element op, seeding; roomVersion() gives the confirmed copy's version).
+   *
+   * Settings (`appState`) never travel with elements: a mixed change becomes two ops, elements first. A
+   * settings op carries `appBase` (each key's confirmed appSeq now, or my last acknowledged op's seq for it,
+   * whichever is higher); any `appBase` passed in is ignored. While a key has an op in flight (sent or not,
+   * no ack yet) or is waiting on a retry gate, changes to it are held, shown, and sent as one op later.
+   *
+   * Returns the elements op's message when there is one, else the settings op's; a held settings change
+   * returns a stand-in `{ t: "op", id: null, held: true, stream, op }` (nothing to send).
+   */
+  local(stream, op, { keepVersions = false } = {}) {
+    const records = stream === "records";
+    if (!records && !ELEMENT_STREAMS.includes(stream)) throw new Error(`unknown stream ${stream}`);
+    const mine = clone(op);
+    if (records) { const msg = this.push(stream, mine); this.recordsRev++; return msg; }
+    const { appState, appBase, ...rest } = mine;
+    let out = null;
+    if (rest.elements?.length || appState === undefined) {
+      const doc = this.streams[stream];
+      for (const el of rest.elements ?? []) {
+        if (!keepVersions) { el.version = (doc.getAny(el.id)?.version ?? 0) + 1; el.versionNonce = randomInt(); }
+        doc.apply({ elements: [el] });
+      }
+      out = this.push(stream, rest, keepVersions);
+    }
+    if (appState !== undefined) { const m = this.setting(stream, appState); out = out ?? m; }
+    this.showAppState(stream);
+    return out;
+  }
+
+  // A new op with the next counter, pending (outgoing() sends it). Counters rise in the order ops are made
+  // and sent, so a held settings change gets its id only when it is released.
+  push(stream, op, keep = false) {
+    // A settings op always names a base for every key it sets (§ Settings); anything else is a bug here.
+    if (op.appState !== undefined) { const why = appBaseProblem(op.appState, op.appBase); if (why) throw new Error(`replica built a bad settings op: ${why}`); }
+    const msg = { t: "op", id: `${this.client}:${++this.counter}`, stream, op };
+    this.pending.set(msg.id, { stream, op, msg, wrote: null, answered: false, resend: false, keep });
+    return msg;
+  }
+
+  // A settings change: an op now, or held behind a busy key (one op in flight per (stream, key)). One
+  // held patch per stream: a change that touches any busy key waits whole, and so does everything after it.
+  setting(stream, patch) {
+    const keys = Object.keys(patch);
+    if (this.held[stream] || keys.some(k => this.busy(stream, k))) {
+      this.held[stream] = { ...(this.held[stream] ?? {}), ...patch };
+      // Fixed by the key's first held change: while held, the screen shows the held value, so a peer's entry
+      // confirmed meanwhile was never seen and must not raise the base (§ Settings, "One in flight per key").
+      for (const k of keys) if (!Object.prototype.hasOwnProperty.call(this.heldBase[stream], k)) this.heldBase[stream][k] = this.basesOf(stream, [k])[k];
+      return { t: "op", id: null, held: true, stream, op: { appState: { ...patch } } };
+    }
+    return this.push(stream, { appState: patch, appBase: this.basesOf(stream, keys) });
+  }
+
+  /**
+   * The appSeq a new settings op for these keys is based on: the newest this replica confirmed (kept across
+   * resyncs), or my last acknowledged op's seq, whichever is higher.
+   */
+  basesOf(stream, keys) {
+    const out = {};
+    for (const k of keys) out[k] = Math.max(this.appSeq[stream][k] ?? 0, this.seen[stream][k] ?? 0, this.floor[stream][k] ?? 0);
+    return out;
+  }
+
+  /** Is a settings key busy: an op of mine for it not yet acknowledged, or a refusal still waiting for its conflict? */
+  busy(stream, key) {
+    for (const p of this.pending.values()) if (p.stream === stream && p.op.appState && p.ackSeq === undefined && Object.prototype.hasOwnProperty.call(p.op.appState, key)) return true;
+    return this.gates.some(g => g.stream === stream && Object.prototype.hasOwnProperty.call(g.appBase, key));
+  }
+
+  // Forget what this replica knew of the room's settings history (rule 13: another user; or the Store lost
+  // entries). Held changes lose their base with it: they are dropped and reported (the app may retry), never
+  // sent on a base they weren't made on (§ Settings, "Forgetting").
+  forgetSettings(did, code) {
+    for (const s of ELEMENT_STREAMS) {
+      const h = this.held[s];
+      if (h) {
+        did.refusedSettings.push({ id: null, stream: s, code, appState: h, appBase: null, held: { ...h } });
+        did.retryReady.push({ id: null, stream: s, keys: Object.keys(h) });
+        this.held[s] = null; this.showAppState(s);
+      }
+      this.floor[s] = {}; this.seen[s] = {}; this.heldBase[s] = {};
+    }
+  }
+
+  /** Held settings changes, per stream (null when none). */
+  heldSettings() { const out = {}; for (const s of ELEMENT_STREAMS) out[s] = this.held[s] ? { ...this.held[s] } : null; return out; }
+
+  // § Settings, "stale-setting is soft": a refused op's gate opens once the confirmed appSeq of any of its
+  // keys has passed (is greater than) the refused base, so a retry never runs against an entry not yet applied.
+  openGates(did) {
+    for (let i = 0; i < this.gates.length; i++) {
+      const g = this.gates[i], seqs = this.appSeq[g.stream];
+      if (!Object.keys(g.appBase).some(k => (seqs[k] ?? 0) > g.appBase[k])) continue;
+      this.gates.splice(i--, 1);
+      did.retryReady.push({ id: g.id, stream: g.stream, keys: Object.keys(g.appBase) });
+    }
+  }
+
+  // Held changes go out as one op once none of their keys is busy, and only on a connection that has
+  // caught up (after a `stale`, only after the resync), so their base comes from the current copy.
+  release() {
+    if (this.stopped || this.resync || this.staleSeen || !this.welcomed || this.applied < this.target) return;
+    for (const s of ELEMENT_STREAMS) {
+      const h = this.held[s];
+      if (!h || Object.keys(h).some(k => this.busy(s, k))) continue;
+      this.held[s] = null;
+      // The base was fixed when the value was made, raised only by my own preceding op on the key once it
+      // settled (floor). Never the confirmed appSeq now: an entry applied since was hidden by the held value,
+      // so the user never saw it, and overwriting it must be refused (§ Settings, "One in flight per key").
+      const base = {};
+      for (const k of Object.keys(h)) base[k] = Math.max(this.heldBase[s][k], this.floor[s][k] ?? 0);
+      this.heldBase[s] = {};
+      this.push(s, { appState: h, appBase: base });
+      this.showAppState(s);
+    }
+  }
+
+  // Put the pending element ops on top of the copy as it is now, and stamp again every op that has never
+  // been sent: per element, with the room's version r (as this replica has confirmed it; 0 if it has none,
+  // and never below a pending op of mine that was already sent), the unsent ops get r + 1, r + 2, … in send
+  // order, each with a fresh nonce when its version changes. So an edit made while the copy was empty
+  // (mid-resync) or behind never goes out at a version the room already passed, to be acked dead or lose
+  // a tie a live client would win. An op already sent keeps its bytes (a resend is the same op: rule 2).
+  restampAll() {
+    const next = new Map();   // "stream\nid" → the highest version so far: the room's, then my pending ops in order
+    for (const p of this.pending.values()) {
+      if (p.stream === "records" || !p.op.elements) continue;
+      // A kept-version op (an import) is never re-stamped: it is counted like one already sent.
+      const doc = this.streams[p.stream], unsent = p.msg.sentAt === undefined && !p.keep;
+      for (const el of p.op.elements) {
+        const key = `${p.stream}\n${el.id}`, base = next.get(key) ?? this.roomVersion(p.stream, el.id);
+        if (!unsent) { next.set(key, Math.max(base, el.version)); doc.apply({ elements: [el] }); continue; }
+        if (el.version !== base + 1) { el.version = base + 1; el.versionNonce = randomInt(); }
+        next.set(key, el.version);
+        // It leads everything this replica knows; `force` only ever replaces an older stamp of my own.
+        const cur = doc.getAny(el.id);
+        if (!cur || cur.version !== el.version || cur.versionNonce !== el.versionNonce) doc.apply({ elements: [el] }, { force: true });
+      }
+    }
+  }
+
+  /** The version of the room's copy of an element as this replica has confirmed it (no pending ops counted); 0 if none. */
+  roomVersion(stream, id) { return this.confirmedVersion[stream]?.get(id) ?? 0; }
+
+  /** Does this replica hold an unacknowledged op for that element? */
+  hasPending(stream, id) {
+    for (const p of this.pending.values()) if (p.stream === stream && p.op.elements?.some(el => el.id === id)) return true;
+    return false;
+  }
+
+  /**
+   * For an editor that keeps its own copy of a stream: which of its elements must give way to this
+   * replica's? An element whose version is ahead of the replica's with no pending op for it was never
+   * sent (a cancelled drag bumped it), so the replica's copy wins, or peers' edits would stop applying.
+   * Returns, per such element, the replica's copy to put back (a clone), or `{ id, gone: true }` when the
+   * replica has none.
+   */
+  reconcile(stream, elements) {
+    const doc = this.streams[stream], out = [];
+    for (const el of elements) {
+      const mine = doc.getAny(el.id);
+      if ((el.version ?? 0) <= (mine?.version ?? 0) || this.hasPending(stream, el.id)) continue;
+      out.push(mine ? clone(mine) : { id: el.id, gone: true });
+    }
+    return out;
+  }
+
+  /** A drag or resize in flight, for others to see: presence, never an op (no counter used, never logged). */
+  preview(stream, elements) { return { t: "presence", k: "preview", stream, elements: clone(elements) }; }
+
+  refill(t) {
+    if (t > this.tokensAt) this.tokens = Math.min(OP_RATE.burst, this.tokens + (t - this.tokensAt) * OP_RATE.perSecond / 1000);
+    this.tokensAt = t;
+  }
+
+  // The first op not yet written on this connection, if it may go now (a resend, or caught up).
+  nextToSend() {
+    for (const p of this.pending.values()) {
+      if (p.wrote !== null) continue;
+      return p.msg.sentAt !== undefined || this.applied >= this.target ? p : null;
+    }
+    return null;
+  }
+
+  /**
+   * The ops to write to the connection now, oldest first. Resends go right after `welcome`; an op never
+   * sent waits until this copy has applied `welcome.seq` (its `sentAt` is the seq applied when it first
+   * goes). Each op is written once per connection; if one gets no answer for 10 s, `resync` is set.
+   */
+  outgoing() {
+    if (this.stopped || this.resync || this.needAuth || this.helloAt === null) return [];   // after `auth`: nothing until signed in again
+    const t = this.now(), out = [];
+    // A timeout means the server was silent for the last 10 s: that stretch doesn't count as staying up.
+    if (this.overdue(t)) { this.failed(t - CONNECT_TIMEOUT_MS); return []; }
+    if (!this.welcomed) return [];
+    this.refill(t);
+    let stamped = false;
+    for (let p; this.tokens >= 1 && (p = this.nextToSend());) {
+      this.tokens -= 1;
+      if (p.msg.sentAt === undefined) { if (!stamped) { this.restampAll(); stamped = true; } p.msg.sentAt = this.applied; }
+      p.wrote = t; out.push(p.msg);
+    }
+    return out;
+  }
+
+  // Rules 2 and 12: no welcome, no catch-up progress, or no answer to a written op, for 10 s.
+  overdue(t) { const left = this.timeLeft(t); return left !== null && left <= 0; }
+  timeLeft(t) {
+    if (!this.welcomed) return this.helloAt + CONNECT_TIMEOUT_MS - t;
+    let left = this.applied < this.target ? this.progressAt + CONNECT_TIMEOUT_MS - t : null;
+    for (const p of this.pending.values()) if (p.wrote !== null && !p.answered) { const mine = p.wrote + OP_TIMEOUT_MS - t; left = left === null ? mine : Math.min(left, mine); }
+    return left;
+  }
+
+  // This connection failed: one more toward the backoff (once per connection), and a new one is wanted.
+  failed(upTo = this.now()) { if (!this.counted) { this.proven(upTo); this.counted = true; this.fails++; } this.resync = true; }
+
+  // Rule 12: the count goes back to 0 only for a connection that proved itself: caught up to welcome.seq
+  // and still connected 10 s later (`upTo`: when it stopped being good). Looked at when the next wait is
+  // worked out, once per connection.
+  proven(upTo = this.now()) {
+    if (this.goodAt !== null && upTo - this.goodAt >= CONNECT_TIMEOUT_MS) this.fails = 0;
+    this.goodAt = null;
+  }
+
+  /**
+   * The caller's socket closed or errored without the replica asking for it (`resync` was not set): a drop
+   * before `welcome`, mid catch-up, or later. Counts toward the rule-12 backoff like a timeout does, once
+   * per connection, and sets `resync`. Pending ops and the copy are kept. A close never resets the count,
+   * clean or not, and neither does a welcome: only a connection that caught up and then stayed up 10 s
+   * does, so a server that welcomes and then drops still meets growing waits. Don't call it for a close
+   * the caller started itself.
+   */
+  connectionFailed() { if (this.helloAt !== null && !this.resync) this.failed(); this.helloAt = null; }
+
+  /** ms to wait before opening the next connection (rule 12): min(30 s, 0.5 s × 2^k) × a random factor in [0.5, 1). */
+  reconnectWait() { this.proven(); return Math.min(BACKOFF.maxMs, BACKOFF.baseMs * 2 ** Math.min(this.fails, 16)) * (0.5 + this.random() / 2); }
+
+  /** ms until the pace lets the next waiting op go (0 = now), or null if none is waiting on the pace. */
+  paceWait() {
+    if (this.stopped || !this.welcomed || this.resync || this.needAuth || !this.nextToSend()) return null;
+    this.refill(this.now());
+    return this.tokens >= 1 ? 0 : Math.ceil((1 - this.tokens) * 1000 / OP_RATE.perSecond);
+  }
+
+  /** ms until outgoing() is worth calling again (the pace, or the 10 s answer timeout), or null. */
+  wait() {
+    if (this.stopped || this.resync || this.needAuth || this.helloAt === null) return null;
+    const pace = this.paceWait(), left = this.timeLeft(this.now());
+    if (left === null) return pace;
+    return pace === null ? Math.max(0, left) : Math.min(pace, Math.max(0, left));
+  }
+
+  /**
+   * A message from the server. Returns what it did to this copy:
+   * `entries` applied (in seq order), `snapshot` loaded, `reset` (the copy was discarded: reconnect),
+   * `settled` op ids (confirmed) and `dropped` op ids (refused, stale or unconfirmable).
+   */
+  receive(msg) {
+    const did = { entries: [], snapshot: false, reset: false, settled: [], dropped: [], refusedSettings: [], retryReady: [] };
+    if (!msg || this.stopped) return did;
+    if (msg.t === "snapshot" || msg.t === "entries") this.progressAt = this.now();
+    if ((msg.t === "snapshot" || msg.t === "entries") && !this.welcomed && this.helloAt !== null) { this.early.push(msg); return did; }
+    if (msg.t === "welcome") {
+      this.welcome(msg, did);
+      // Entries that beat the welcome here (§ Recovery, Room identity) apply only now, after its checks.
+      const early = this.early; this.early = [];
+      if (this.welcomed && !this.resync && !this.stopped) for (const m of early) {
+        if (m.t === "snapshot") this.snapshot(m, did);
+        else { for (const e of m.entries ?? []) if (e.seq > this.applied && !this.buffer.has(e.seq)) this.buffer.set(e.seq, e); this.drain(did); }
+      }
+    }
+    else if (msg.t === "snapshot") this.snapshot(msg, did);
+    else if (msg.t === "entries") {
+      for (const e of msg.entries ?? []) if (e.seq > this.applied && !this.buffer.has(e.seq)) this.buffer.set(e.seq, e);
+      this.drain(did);
+    } else if (msg.t === "ack") {
+      const p = this.pending.get(msg.id);
+      if (p) {
+        p.ackSeq = msg.seq; p.answered = true;
+        // The next op for these keys is based on this one (§ Settings, "One in flight per key").
+        if (p.op.appState) for (const k of Object.keys(p.op.appState)) this.floor[p.stream][k] = Math.max(this.floor[p.stream][k] ?? 0, msg.seq);
+        this.settle(did); this.afterAnswers(did); this.release();
+      }
+    } else if (msg.t === "presence") this.presence(msg);
+    else if (msg.t === "error") this.error(msg, did);
+    return did;
+  }
+
+  welcome(msg, did) {
+    if (this.welcomed) return;   // one welcome per connection; a repeat changes nothing
+    if (msg.rv !== undefined && !RULES[msg.rv]) { this.stopped = "version"; return; }
+    // Rule 12 and § Recovery, Room identity. (A welcome with no `room` is from a pre-v1.1 server: not checked.)
+    const room = msg.room;
+    if (room && typeof room === "object") {
+      if (room.board !== this.board) { this.failed(); return; }          // another board: close, reconnect
+      if (msg.high !== undefined && Number.isSafeInteger(room.epoch)) {  // a writer's welcome, built by the room
+        if (room.epoch < this.epochSeen) { this.failed(); return; }      // a stale host: close, reconnect
+        const lost = room.epoch > this.epochSeen && msg.seq < this.applied;
+        this.epochSeen = room.epoch;
+        if (lost) {                                                     // the Store lost acked entries: resync from 0
+          // My acked seqs, the appSeqs I saw and refused bases may name entries the room no longer has: forget
+          // them, or a base could stay above the room's appSeq (always refused) and a gate never open. A
+          // settings op stamped before the loss opens no gate if it is refused (§ Settings, "After a Store loss").
+          for (const p of this.pending.values()) if (p.op.appState) p.lost = true;
+          this.gates = [];
+          this.epoch = room.epoch; this.discard(did);
+          this.forgetSettings(did, "store-lost");
+          return;
+        }
+      }
+      this.epoch = room.epoch;   // a viewer's (gateway-built) welcome may lag: only recorded
+    }
+    // Rule 13: pending ops belong to the user who made them. Someone else signed in: drop them, say how many.
+    const other = this.user !== null && this.user !== msg.user;
+    if (other) {
+      for (const id of [...this.pending.keys()]) { this.pending.delete(id); did.dropped.push(id); }
+      this.gates = [];   // held changes are dropped and reported by forgetSettings() below
+    }
+    this.welcomed = true; this.role = msg.role; this.user = msg.user; this.target = msg.seq; this.horizon = msg.horizon ?? 0;
+    this.progressAt = this.now();
+    if (this.applied >= this.target) this.goodAt = this.now();
+    if (other) { if (did.dropped.length) { this.discarded = (this.discarded ?? 0) + did.dropped.length; this.discard(did); } this.forgetSettings(did, "user-changed"); return; }
+    // The room has forgotten this client (§ Op ids): ops sent before its horizon may or may not have been
+    // logged, and the room would answer `stale`. Drop them now, and start over from the room's copy.
+    if (msg.high === 0) for (const [id, p] of this.pending) if (p.msg.sentAt !== undefined && p.msg.sentAt < this.horizon) { this.pending.delete(id); did.dropped.push(id); }
+    if (did.dropped.length) this.discard(did, did.dropped.length);
+    this.release();
+  }
+
+  // Rule 5: throw the copy away and ask for a fresh connection with since 0.
+  discard(did, unconfirmed = 0) { this.unconfirmed += unconfirmed; this.reset(); did.reset = true; this.resync = true; }
+
+  snapshot(msg, did) {
+    if (msg.seq <= this.applied) return;
+    for (const s of ELEMENT_STREAMS) {
+      const sc = msg.streams[s], doc = this.streams[s];
+      doc.load({ elements: clone(sc.elements), appState: clone(sc.appState) });
+      this.confirmedVersion[s] = new Map(sc.elements.map(el => [el.id, el.version ?? 0]));
+      this.confirmed[s] = { ...doc.appState.herdr };
+      this.appSeq[s] = { ...(msg.appSeq?.[s] ?? {}) };
+    }
+    this.confirmedRecords = new Records(msg.records);
+    this.noteAuthor = new Map(msg.noteAuthor ?? []);
+    this.applied = msg.seq; did.snapshot = true;
+    for (const k of [...this.buffer.keys()]) if (k <= this.applied) this.buffer.delete(k);
+    this.overlay();
+    this.drain(did);
+  }
+
+  drain(did) {
+    while (this.buffer.has(this.applied + 1)) {
+      const e = this.buffer.get(this.applied + 1); this.buffer.delete(e.seq);
+      if (e.rv !== undefined && !RULES[e.rv]) { this.stopped = "version"; return; }   // rules this app doesn't know
+      if (e.stream === "records") { this.confirmedRecords.apply(e.op, e.by, e.at, e.name ?? null); this.recordsRev++; }
+      else if (this.streams[e.stream]) {
+        for (const el of e.op.elements ?? []) {
+          this.dropPreview(e.stream, el.id);
+          if (e.stream === "notes" && !this.noteAuthor.has(el.id)) this.noteAuthor.set(el.id, e.by);
+          const seen = this.confirmedVersion[e.stream];
+          if ((el.version ?? 0) > (seen.get(el.id) ?? 0)) seen.set(el.id, el.version);
+        }
+        if (e.op.elements) this.streams[e.stream].apply({ elements: e.op.elements });
+        if (e.op.appState) mergeAppState(this.confirmed[e.stream], this.appSeq[e.stream], e.op.appState, e.seq);
+      }
+      this.applied = e.seq;
+      // Rule 4: an applied entry with one of my pending ids, made by me, settles that op, ack or not.
+      if (e.by === this.user && this.pending.has(e.id)) {
+        const p = this.pending.get(e.id); this.pending.delete(e.id);
+        // Settled by its entry, ack or not: the next held change to these keys is based on it (§ Settings).
+        if (p.op.appState) for (const k of Object.keys(p.op.appState)) this.floor[p.stream][k] = Math.max(this.floor[p.stream][k] ?? 0, e.seq);
+        did.settled.push(e.id); this.recordsRev++;
+      }
+      if (this.streams[e.stream]) this.showAppState(e.stream);
+      did.entries.push(e);
+    }
+    if (did.entries.length && this.pending.size) this.restampAll();
+    if (this.welcomed && this.applied >= this.target && this.goodAt === null) this.goodAt = this.now();   // caught up; proven 10 s from now
+    this.settle(did);
+    this.afterAnswers(did);   // an applied entry answers a resend as well as an ack does
+    this.openGates(did);
+    this.release();
+  }
+
+  // An acknowledged op whose entry is applied (or covered by a snapshot) is no longer pending.
+  settle(did) {
+    let any = false;
+    for (const [id, p] of this.pending) if (p.ackSeq && p.ackSeq <= this.applied) { this.pending.delete(id); did.settled.push(id); any = true; }
+    if (any) { for (const s of ELEMENT_STREAMS) this.showAppState(s); this.recordsRev++; }
+  }
+
+  error(msg, did) {
+    if (msg.code === "version") { this.stopped = "version"; return; }
+    if (msg.code === "unavailable") { this.failed(); return; }   // not a refusal: every pending op is kept
+    if (msg.code === "auth") { this.needAuth = true; return; }        // kept too; sign in again, then reconnect
+    const p = msg.id !== undefined ? this.pending.get(msg.id) : null;
+    if (!p) return;
+    this.pending.delete(msg.id); did.dropped.push(msg.id);
+    if (p.op.appState && msg.code !== "stale") {
+      // A refused settings op takes the held changes to its keys with it: they were built on its value.
+      const keys = Object.keys(p.op.appState), h = this.held[p.stream];
+      let held = null;
+      if (h) for (const k of keys) if (Object.prototype.hasOwnProperty.call(h, k)) { (held = held ?? {})[k] = h[k]; delete h[k]; delete this.heldBase[p.stream][k]; }
