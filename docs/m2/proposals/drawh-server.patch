+      this.tip = t ? { seq: r.applied, id: t.id, by: t.by } : null;   // null after a snapshot: no entry to show next time
+      for (const k of [...this.seenEntries.keys()]) if (k <= r.applied) this.seenEntries.delete(k);
+    }
+    this.settingsAnswers(did);
+    if (r.resync) { this.reconnect = true; if (msg.t !== "error" || msg.code === "unavailable") this.later = true; }
+  }
+
+  // § Settings: stale-setting is soft. The board's value wins, is written back here (pull), and is said; the
+  // key waits for retryReady before a change to it is judged again. Other codes with no op id (another user
+  // signed in) drop held changes: said, and the file's value is judged again on the next pass.
+  settingsAnswers(did) {
+    for (const x of did.refusedSettings) {
+      if (x.stream !== STREAM) continue;
+      const keys = [...new Set([...Object.keys(x.appState ?? {}), ...Object.keys(x.held ?? {})])].filter(k => SETTINGS.includes(k));
+      if (!keys.length) continue;
+      if (x.code === "stale-setting") {
+        const dropped = [];
+        for (const k of keys) {
+          this.gates.set(k, "writeback");
+          if (!this.refusedVals.has(k)) this.refusedAt.set(k, this.lastStamp);
+          const vals = this.refusedVals.get(k) ?? new Set();
+          for (const src of [x.appState, x.held]) if (isObj(src) && own(src, k) && !vals.has(canon(src[k]))) { vals.add(canon(src[k])); dropped.push(`${k} ${short(canon(src[k]))}`); }
+          this.refusedVals.set(k, vals);
+        }
+        if (x.id) this.refusedOps.add(x.id);
+        this.lost++;
+        this.warn(`board settings: someone else changed ${list(keys)} on the board just before this change reached it; the board's value is kept and written back here (dropped from this file: ${dropped.join(", ")}). To change it, set it again`);
+      } else if (x.id === null) {
+        this.warn(`board settings: a change to ${list(keys)} was not sent (${x.code === "user-changed" ? "signed in as someone else" : "the server lost recent changes"}); it is tried again from this file`);
+      }
+    }
+    for (const x of did.retryReady) if (x.stream === STREAM) for (const k of x.keys) { this.gates.delete(k); this.refusedVals.delete(k); this.refusedAt.delete(k); }
+  }
+
+  // The room refused an op of ours (not stale-setting: that is soft). The replica drops it and starts over
+  // from the room's copy; the file still has the change, so it must be remembered or it would be sent, and
+  // refused, forever. An op that carried several elements is taken apart first (halves, then halves of
+  // those), so one bad element doesn't keep its neighbours from the board and the warning can name it.
+  refusal(p, msg) {
