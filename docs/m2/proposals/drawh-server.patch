+test("what the file has goes to the room once; what the room has is written to the file", () => {
+  const room = newRoom(), bob = peer(room);
+  bob.send("board", { elements: [rect("theirs")] });
+  const { b, f, sent, els } = rig(room, { text: sceneText([rect("mine")]) });
+  expect(b.sync()).toBe(true);
+  expect(room.streams.board.get("mine")).toBeTruthy();
+  expect(els().map(e => e.id).sort()).toEqual(["mine", "theirs"]);
