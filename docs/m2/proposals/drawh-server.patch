+test("drawh --server: a refused token ends it, without printing the token; flags, URL and path are checked before anything connects", async () => {
+  const s = standIn(), dir = scratch(), f = `${dir}/b.excalidraw`;
+  try {
+    const bad = "wrong-token-also-secret";
+    const r = await drawh(["--server", s.url, "--board", "b1", "--once", "--token", bad, f], { DRAWH_STATE_DIR: `${dir}/state` });
+    expect(r.code).toBe(1);
+    expect(r.err).toContain("auth");
+    expect(r.out + r.err).not.toContain(bad);
+    expect(existsSync(f)).toBe(false);                                         // nothing written for a board we may not see
+    const n = s.headers.length;
+    const noToken = await drawh(["--server", s.url, "--board", "b1", f]);
+    expect([noToken.code, noToken.err.includes("PLENARY_TOKEN")]).toEqual([1, true]);
+    const noBoard = await drawh(["--server", s.url, "--token", "x", f]);
+    expect([noBoard.code, noBoard.err.includes("--board")]).toEqual([1, true]);
+    const far = await drawh(["--server", "ws://example.invalid/x", "--board", "b1", "--once", f], { PLENARY_TOKEN: TOKEN });
+    expect([far.code, far.err.includes("wss://")]).toEqual([1, true]);         // no token over plain ws to another machine
+    const creds = await drawh(["--server", s.url.replace("ws://", `ws://u:${TOKEN}@`), "--board", "b1", "--once", f], { PLENARY_TOKEN: TOKEN });
+    expect(creds.code).toBe(1);
+    expect(creds.out + creds.err).not.toContain(TOKEN);
+    for (const q of [`?token=${TOKEN}`, `?access_token=abc`, `?x=${TOKEN}`, `?api_key=1`]) {    // nor in a query, whatever it is called
+      const inUrl = await drawh(["--server", s.url + q, "--board", "b1", "--once", f], { PLENARY_TOKEN: TOKEN });
+      expect([q, inUrl.code, inUrl.err.includes("no token in the URL"), (inUrl.out + inUrl.err).includes(TOKEN)]).toEqual([q, 1, true, false]);
+    }
+    // ...however it is percent-encoded (Python's quote() encodes *()! where JavaScript's encodeURIComponent doesn't)
+    const odd = "se*cret(tok)en!x";
+    for (const q of ["?x=se%2Acret%28tok%29en%21x", "?x=se%252Acret%2528tok%2529en%2521x", `?x=${encodeURIComponent(odd)}`]) {
+      const enc = await drawh(["--server", s.url + q, "--board", "b1", "--once", f], { PLENARY_TOKEN: odd });
+      expect([q, enc.code, enc.err.includes("no token in the URL")]).toEqual([q, 1, true]);
+    }
+    // ...and a token with `+` (base64), which a URL parser may also read as a space: every form is refused
+    const plus = "dG9rZW4+with/plus==", q1 = encodeURIComponent(plus);
+    for (const u of [`${s.url}?x=${q1}`, `${s.url}?x=${encodeURIComponent(q1)}`, `${s.url}?x=${plus}`, `${s.url}/${q1}`, `${s.url}?x=${q1.replace("%2B", "+")}`]) {
+      const enc = await drawh(["--server", u, "--board", "b1", "--once", f], { PLENARY_TOKEN: plus });
+      expect([u, enc.code, enc.err.includes("no token in the URL"), (enc.out + enc.err).includes(q1)]).toEqual([u, 1, true, false]);
+    }
+    const t0 = Date.now();
+    const folder = await drawh(["--server", s.url, "--board", "b1", "--once", dir], { PLENARY_TOKEN: TOKEN });
+    expect([folder.code, folder.err.includes("is a folder"), Date.now() - t0 < 5000]).toEqual([1, true, true]);   // at once, not after 30 s
+    const nowhere = await drawh(["--server", s.url, "--board", "b1", "--once", `${dir}/none/b.excalidraw`], { PLENARY_TOKEN: TOKEN });
+    expect([nowhere.code, nowhere.err.includes("no such folder")]).toEqual([1, true]);
+    expect(s.headers.length).toBe(n);                                          // none of these reached the server
+    // a short dev token that happens to be part of the URL (the board's name) is not a token in the URL
+    const short = await drawh(["--server", s.url, "--board", "b1", "--once", f], { PLENARY_TOKEN: "b1" });
+    expect([short.code, short.err.includes("no token in the URL"), short.err.includes("auth")]).toEqual([1, false, true]);
+  } finally { s.stop(); done(dir); }
+}, 30000);
