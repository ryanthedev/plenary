+test("on a disk that refuses writes (no marker): my own sent change isn't taken for an old copy when a peer moves on; an old copy changed is said", () => {
+  const room = newRoom(), bob = peer(room), { b, f, warned } = rig(room, { text: sceneText([], { grid: 10 }) });
+  b.sync(); b.sync();
+  f.fail = Infinity;
+  const base = f.text;
+  f.text = built(base, s => { s.appState.herdr.grid = 20; }); b.sync();          // sent; the marker couldn't be written
+  expect(grid(room)).toBe(20);
+  bob.send("board", { appState: { grid: 30 } });
+  try { b.sync(); } catch {}                                                     // the board's 30 can't be written here
+  expect(said(warned, OLD)).toBe(0);                                             // the file is just behind, not changed
+  f.text = built(base, s => { s.appState.herdr.grid = 25; });                     // an old copy (from before my change) changed
+  try { b.sync(); } catch {}   // (an old copy set to 20 would be this file byte for byte: no rule can tell them apart; a limit)
+  expect([grid(room), said(warned, OLD)]).toEqual([30, 1]);
+});
