+test("drawh --server --once tells a script when something didn't land: exit 2 for a refusal or a read-only role, 0 when all is in step", async () => {
+  const s = standIn(), dir = scratch(), f = `${dir}/b.excalidraw`, env = { PLENARY_TOKEN: TOKEN, DRAWH_STATE_DIR: `${dir}/state` };
+  try {
+    local("add", f, "rect", "--at", "0,0", "--id", "r1");
+    s.mode = "refuse";
+    const refused = await drawh(["--server", s.url, "--board", "b1", "--once", f], env);
+    expect(refused.code).toBe(2);
+    expect(refused.err).toContain("element r1");
+    expect(refused.err).toContain("1 change in this file did not reach the board");
+    s.mode = "normal";
+    const ok = await drawh(["--server", s.url, "--board", "b1", "--once", f], env);                 // a new run tries again
+    expect([ok.code, !!s.room.streams.board.get("r1")]).toEqual([0, true]);
+    local("add", f, "rect", "--at", "200,0", "--id", "r2");
+    const viewer = await drawh(["--server", s.url, "--board", "b1", "--once", f], { ...env, PLENARY_TOKEN: "tok-view" });
+    expect(viewer.code).toBe(2);
+    expect(viewer.err).toContain("viewer");
+    expect(s.room.streams.board.get("r2")).toBe(null);
+    const reader = await drawh(["--server", s.url, "--board", "b1", "--once", `${dir}/copy.excalidraw`], { ...env, PLENARY_TOKEN: "tok-view" });
+    expect(reader.code).toBe(0);                                               // a viewer with nothing of its own: a clean copy
+  } finally { s.stop(); done(dir); }
+}, 30000);
