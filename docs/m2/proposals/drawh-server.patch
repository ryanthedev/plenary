+// ---- the real thing: drawh → node/bun → a WebSocket → the reference Room ----
+
+// The Room behind a WebSocket on a free port (port 0), stopped by its own handle. `mode` makes it misbehave.
+function standIn() {
+  const room = newRoom(), hellos = [], headers = [], s = { mode: "normal" };
+  const server = Bun.serve({
+    port: 0, hostname: "127.0.0.1",
+    fetch(req, srv) { headers.push({ ...Object.fromEntries(req.headers), ":url": req.url }); return srv.upgrade(req, { data: {} }) ? undefined : new Response("ws only", { status: 400 }); },
+    websocket: {
+      open(ws) { ws.data.conn = room.connect(m => { if (s.mode !== "silent") ws.send(jsonCodec.encode(m)); }); },
+      message(ws, data) {
+        const m = jsonCodec.decode(String(data)); if (m.t === "hello") hellos.push(m);
+        if (m.t === "op" && s.mode === "unavailable") return void ws.send(jsonCodec.encode({ t: "error", code: "unavailable", message: "busy" }));
+        if (m.t === "op" && s.mode === "refuse") return void ws.send(jsonCodec.encode({ t: "error", id: m.id, code: "bad-op", message: "no thanks" }));
+        room.receive(ws.data.conn, m);
+      },
+      close(ws) { room.disconnect(ws.data.conn); },
+    },
+  });
+  return Object.assign(s, { room, hellos, headers, url: `ws://127.0.0.1:${server.port}/boards/b1`, stop: () => server.stop(true) });
+}
+const DRAWH = `${ROOT}cli/drawh`;
+const spawn = (args, env = {}) => Bun.spawn([DRAWH, ...args], { env: { ...process.env, PLENARY_TOKEN: "", ...env }, stdout: "pipe", stderr: "pipe" });
+async function drawh(args, env = {}) {
+  const p = spawn(args, env);
+  const [out, err, code] = await Promise.all([new Response(p.stdout).text(), new Response(p.stderr).text(), p.exited]);
+  return { out, err, code };
+}
+const local = (...a) => { const r = Bun.spawnSync([DRAWH, ...a]); return { out: r.stdout.toString(), err: r.stderr.toString(), code: r.exitCode }; };
+// A long-running bridge: its stderr as it grows, and a stop that ends this process and no other.
+function running(args, env) {
+  const p = spawn(args, env), s = { err: "" };
+  (async () => { const d = new TextDecoder(); for await (const chunk of p.stderr) s.err += d.decode(chunk); })();
+  s.until = async (what, fn, limit = 8000) => { for (const t0 = Date.now(); Date.now() - t0 < limit; await Bun.sleep(25)) if (await fn()) return true; throw new Error(`never: ${what}\n${s.err}`); };
+  s.stop = async () => { p.kill("SIGTERM"); return p.exited; };
+  return s;
+}
