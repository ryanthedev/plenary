+for (const mode of ["swap", "link"]) test(`the board file on a real disk (${mode}): replaced in place, and whatever it held instead of the expected text comes back`, () => {
+  const dir = scratch(), path = `${dir}/b.excalidraw`, warned = [];
+  try {
+    const disk = new BoardFile(path, { mode, python: Bun.which("python3"), warn: l => warned.push(l) });
+    expect(disk.read()).toBe(null);
+    expect(disk.replace("{\"n\":1}", null)).toBe(undefined);                   // no file: created
+    expect(disk.read()).toBe("{\"n\":1}");
+    expect(disk.replace("{\"n\":2}", "{\"n\":1}")).toBe(undefined);            // held what we expected
+    writeFileSync(path, "{\"theirs\":true}");                                    // someone saved since we read
+    expect(disk.replace("{\"n\":3}", "{\"n\":2}")).toEqual({ replaced: "{\"theirs\":true}" });
+    expect(disk.read()).toBe("{\"n\":3}");                                      // ours is in place all the same
+    writeFileSync(path, "{\"half\":");                                           // someone's save that can't be read
+    expect(disk.replace("{\"n\":4}", "{\"n\":3}")).toBe(undefined);
