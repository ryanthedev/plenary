+test("a reconnect doesn't call for another: after closed(), a pass leaves reconnect alone (a file change while the socket opens)", () => {
+  const room = newRoom(), { b, f, connect } = rig(room, { text: sceneText([rect("a")], { grid: 10 }) });
+  b.sync();
+  b.closed();
+  edit(f, s => { s.appState.herdr.grid = 12; }); b.sync();
+  expect([b.reconnect, b.later]).toEqual([false, false]);
+  connect(); b.sync(); b.sync();
+  expect(grid(room)).toBe(12);
+});
