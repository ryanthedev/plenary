+// A disk where the swap call says yes and only renames (FAT: one of the two files is simply gone), and a disk
+// with no hard links either (exFAT). Stood in for by a python that renames, and a link that refuses.
+test("a disk that doesn't really swap is found out on two scratch files before the board is touched; one that can't link either is refused, loudly", () => {
+  const dir = scratch(), path = `${dir}/b.excalidraw`, fat = `${dir}/fake-python`, warned = [];
+  try {
+    writeFileSync(fat, "#!/bin/sh\nmv \"$3\" \"$4\"\n"); chmodSync(fat, 0o755);      // "swapped": exit 0, and the other file is gone
+    writeFileSync(path, "{\"n\":1}");
+    const disk = new BoardFile(path, { python: fat, warn: l => warned.push(l) });
+    writeFileSync(path, "{\"theirs\":true}");                                    // a save since the bridge read {"n":1}
+    expect(disk.replace("{\"n\":2}", "{\"n\":1}")).toEqual({ replaced: "{\"theirs\":true}" });   // not lost: it went the link way
+    expect([disk.mode, warned, disk.read()]).toEqual(["link", [LINK_WARNING], "{\"n\":2}"]);
