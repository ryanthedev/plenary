+    this.warn(`the server refused ${what} (${why}); ${els.length ? `${els.length > 1 ? "they stay" : "it stays"} in this file only` : "the board's value is written back to this file"}`);
+  }
+
+  caughtUp() { return this.welcome !== null && !this.reconnect && !this.check && this.replica.applied >= this.welcome; }
+  /** Caught up, and every change sent has been acknowledged and come back (held settings and gates too). */
+  settled() { return this.caughtUp() && this.replica.pending.size === 0 && this.replica.heldSettings()[STREAM] === null && this.gates.size === 0; }
+
+  /**
+   * One pass: what the file has that the room hasn't goes out as ops; what the room has that the file
+   * hasn't is written to the file. Returns true when the file and the replica agree afterwards.
+   * Waits for catch-up, so a change is never sent against a board this client hasn't seen yet.
+   */
+  sync() {
+    try { return this.pass(); }
+    finally { this.flush(); }   // what push() queued goes out even when the write threw (a disk that says no)
+  }
+
+  pass() {
+    this.again = false;
+    if (!this.caughtUp() || this.fatal) return false;
+    const stamp = this.stamp();          // before the read: a save landing between the two reads as a newer one (loud, never quiet)
+    const text = this.read();
+    this.lastStamp = stamp;
+    let scene;
+    try { scene = text === null ? EMPTY() : JSON.parse(text); }
+    catch { this.once("json", "the file isn't valid JSON right now; waiting for the next change"); return false; }
+    if (!isObj(scene)) return false;
+    this.said.delete("json");
+    let onDisk = text, must = text === null;
+    if (this.carry) { scene = union(scene, this.carry); this.carry = null; must = true; }
+    for (let n = 0; ; n++) {
+      const els = Array.isArray(scene.elements) ? scene.elements.slice() : [];
+      const herdr = { ...(isObj(scene.appState?.herdr) ? scene.appState.herdr : {}) };
+      const { renumbered, settings } = this.push(els, herdr);
+      const pulled = this.pull(els, herdr);
+      // A settings change sent from the file: write it back with a fresh marker, so an older copy of the file (an
+      // agent's read from before) can be told from this one. (A disk that refuses the write: the file stays as it is.)
+      if (!must && !renumbered && !pulled && !settings) {
+        // Nothing to write: the file is in step with the board. An unmarked one gets an implied marker (its bases
+        // now), so a change made on it later is judged against what it showed; a marked one keeps its own. Unmarked
+        // copies can't be told apart, so a key's implied base is taken once (the oldest: an older copy is never
+        // mistaken for a newer one) until the bridge writes a marker.
+        if (!this.marked(herdr)) this.unmarked = { ...this.marks(herdr, {}), ...this.unmarked };
+        this.looked = this.deferred.size ? null : this.lookOf(herdr);   // (a change waiting on its gate is judged once it opens)
+        break;
+      }
+      herdr[MARK] = { room: this.lineage, keys: this.marks(herdr, herdr) };
+      scene = { ...scene, elements: els, appState: { ...(isObj(scene.appState) ? scene.appState : {}), herdr } };
+      const next = JSON.stringify(scene, null, 2);
+      if (next === onDisk) break;
+      let r;
+      try { r = this.write(next, onDisk); }
+      catch (e) {
+        // Only a settings change sent from the file wanted this write (its fresh marker): the change went out, so a
+        // disk that says no costs the marker, not the change. Anything else the file needs: the caller hears of it.
+        if (must || renumbered || pulled) throw e;
+        break;
+      }
+      // (Not while a change waits on its gate: a file read later that is this one byte for byte still holds that
+      // change, and taking it as "already looked at" would let pull() write the board's value over it unsaid.)
+      this.looked = this.deferred.size ? null : this.lookOf(herdr);
+      this.lastStamp = this.stamp();
+      for (const k of this.gates.keys()) if (this.gates.get(k) === "writeback") this.gates.set(k, "wait");
+      for (const k of [...this.said]) if (k.startsWith("kept ") || k.startsWith("invalid ")) this.said.delete(k);   // the board's value is back: a new change is said again
+      if (!isObj(r) || typeof r.replaced !== "string") break;
+      // Someone (the pane, an agent) saved while we worked. Their save is off the disk now (ours replaced
+      // it), and here in our hands: fold it into what we wrote, send what it had, write the two together.
+      let theirs = null;
+      try { theirs = JSON.parse(r.replaced); } catch { this.warn("a save by someone else was half-written when the bridge replaced it, and could not be read"); }
+      if (isObj(theirs)) scene = union(scene, theirs);
+      onDisk = next; must = true;
+      if (n >= MAX_MERGES) { this.carry = scene; this.again = true; return false; }
+    }
+    this.said.delete("frame");
+    return true;
+  }
+
+  // The marker for the settings in `herdr`: per key, the replica's base now (the appSeq this value stands on).
+  // A key held back for its gate keeps the base it was changed on (from `was`, the file's marker).
+  marks(herdr, was) {
+    const r = this.replica, keys = {};
+    for (const k of SETTINGS) {
+      if (!own(herdr, k)) continue;
+      if (this.deferred.has(k) && was) { keys[k] = this.markOf(was, k); continue; }
+      let mine = null;
+      for (const p of r.pending.values()) if (p.stream === STREAM && p.op.appState && own(p.op.appState, k) && same(p.op.appState[k], herdr[k])) mine = p.msg.id;
+      keys[k] = [r.basesOf(STREAM, [k])[k], printOf(herdr[k]), ...(mine ? [mine] : [])];
+    }
+    return keys;
+  }
+
+  // File → room. `renumbered`: it changed `els` (the seeding rule gave elements new versions).
+  push(els, herdr) {
+    const r = this.replica, doc = r.streams[STREAM], out = [], may = canWrite(this.role, STREAM);
+    let held = 0, renumbered = false;
+    const renumberedIds = [];
+    // The room's copy as it will judge an op: its confirmed version, or one of my pending ops for the element.
+    const pendingV = new Map();
+    for (const p of r.pending.values()) if (p.stream === STREAM) for (const el of p.op.elements ?? []) pendingV.set(el.id, Math.max(pendingV.get(el.id) ?? 0, el.version));
+    for (let i = 0; i < els.length; i++) {
+      let el = els[i];
+      if (!isObj(el) || typeof el.id !== "string") continue;
+      const cur = doc.getAny(el.id);
+      if (!wins(el, cur)) continue;
+      if (!may || this.refused.get(el.id) === vn(el)) { held++; continue; }
+      const roomV = Math.max(r.roomVersion(STREAM, el.id), pendingV.get(el.id) ?? 0), isNew = roomV === 0 && !pendingV.has(el.id);
+      // Seeding: the room refuses a version more than MAX_VERSION_JUMP past its own copy, and an element it
+      // has never had counts as version 0. So a shape new to the board whose version is above that (an old,
+      // much-edited board) goes out as version 1 with a new nonce, same id, and the file gets the same
+      // numbers, or its old ones would win the next diff. Every other shape keeps its version: lowering a
+      // version under an open pane is how a stale copy comes to outrank someone's later edit.
+      if (isNew && el.version > MAX_VERSION_JUMP && el.id.length <= 64) { el = els[i] = { ...el, version: 1, versionNonce: nonce() }; renumbered = true; renumberedIds.push(el.id); }
+      const why = el.id.length > 64 ? "its id is longer than 64 characters"
+        : !Number.isSafeInteger(el.version) || el.version < 0 || !Number.isSafeInteger(el.versionNonce) ? "it has no integer version and versionNonce"
+        : !isNew && el.version > roomV + MAX_VERSION_JUMP ? `its version (${el.version}) is more than ${MAX_VERSION_JUMP} past the board's (${roomV}), so the board would refuse it; it stays in this file only (a pane that had the file open while its shapes were first sent writes their old version numbers back)`
+        : utf8Bytes(JSON.stringify(el)) > CHUNK ? "it is too large for one op" : null;
+      if (why) { held++; this.once(`skip ${el.id} ${vn(el)}`, `element ${el.id} isn't sent: ${why}`); continue; }
+      out.push(el);
+    }
+    if (renumberedIds.length) this.warn(`${renumberedIds.length} shape${renumberedIds.length === 1 ? " was" : "s were"} past version ${MAX_VERSION_JUMP} and new to the board, so ${renumberedIds.length === 1 ? "it was" : "they were"} renumbered to version 1 to be sent (${renumberedIds.slice(0, 5).join(", ")}${renumberedIds.length > 5 ? ", …" : ""}): reopen any pane that has this file open, or its next save can bring the old numbers back and undo other people's edits to ${renumberedIds.length === 1 ? "it" : "them"}`);
+    // Board settings (layers, grid, snap, timeline): judged by the base the file was built on (settingsFrom).
+    const { patch, kept } = this.settingsFrom(herdr);
+    held += kept.length;
+    const settings = Object.keys(patch).length > 0;
+    if (settings && !may) held++;
+    this.held = held + this.lost;
+    if (held && !may) this.once("role", `signed in as ${this.role}: changes made in this file are not sent`);
+    if (may) this.said.delete("role");
+    if (!may) return { renumbered, settings: false };
+    // Elements keep the file's versions (keepVersions: an import, never re-stamped); settings go alone and the
+    // Replica stamps their base. Nothing returned by local() is sent here: flush() sends what is ready.
+    let batch = [], size = 0, room = Infinity;
+    const flush = () => { if (!batch.length) return; r.local(STREAM, { elements: batch }, { keepVersions: true }); batch = []; size = 0; room = Infinity; };
+    for (const el of out) {
+      const n = utf8Bytes(JSON.stringify(el)), cap = this.limit.get(el.id) ?? Infinity;
+      if (batch.length && (size + n > CHUNK || batch.length >= Math.min(room, cap))) flush();
+      batch.push(el); size += n; room = Math.min(room, cap);
+    }
+    flush();
+    if (settings) r.local(STREAM, { appState: patch });
+    return { renumbered, settings };
+  }
+
+  // Room → file. Returns true when `els` or `herdr` changed.
+  pull(els, herdr) {
+    const r = this.replica, doc = r.streams[STREAM];
+    const at = new Map(els.map((e, i) => [e?.id, i]));
+    let dirty = false;
+    for (const el of doc.toScene().elements) {
+      const i = at.get(el.id);
+      if (i === undefined) { els.push(copy(el)); dirty = true; }
+      else if (wins(el, els[i])) { els[i] = copy(el); dirty = true; }
+    }
+    // Only keys the room has ordered or this bridge is sending (a board whose settings no one has set keeps the
+    // file's), and only keys and values the protocol knows: nothing else a server sends becomes a key in the file.
+    // A key waiting on its gate keeps the file's value (a change made after the refusal, judged once it opens).
+    const shown = doc.appState.herdr;
+    for (const k of SETTINGS) {
+      if (!own(r.appSeq[STREAM], k) || this.deferred.has(k)) continue;
+      if (!own(shown, k) || appStateProblem({ [k]: shown[k] }) !== null || same(shown[k], herdr[k])) continue;
+      herdr[k] = copy(shown[k]); dirty = true;
+    }
+    return dirty;
+  }
+}
