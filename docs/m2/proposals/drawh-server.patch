+test("drawh --server keeps trying a server that is unavailable or silent, more slowly each time, and gets the edit through when it is back", async () => {
+  const s = standIn(), dir = scratch(), f = `${dir}/b.excalidraw`;
+  const env = { PLENARY_TOKEN: TOKEN, DRAWH_STATE_DIR: `${dir}/state`, DRAWH_RETRY_MS: "40", DRAWH_STALL_MS: "300" };
+  let b;
+  try {
+    local("add", f, "rect", "--at", "0,0", "--id", "r1");
+    s.mode = "unavailable";                                                    // welcomes, catches up, then answers every op "unavailable"
+    b = running(["--server", s.url, "--board", "b1", f], env);
+    await b.until("the delay doubles", () => ["in 0.04 s", "in 0.08 s", "in 0.16 s", "in 0.32 s"].every(x => b.err.includes(x)));
+    expect(s.room.streams.board.get("r1")).toBe(null);
+    s.mode = "normal";
+    await b.until("the edit arrives once the server is back", () => !!s.room.streams.board.get("r1"));
+    // then a server that accepts the socket and says nothing
+    const hellos = s.hellos.length;
+    for (const c of [...s.room.conns]) c.send({ t: "error", code: "unavailable", message: "going quiet" });   // makes the bridge reconnect...
+    s.mode = "silent";                                                         // ...into silence
+    await b.until("it gives up on a connection that never catches up", () => b.err.includes("didn't bring this board up to date within 0.3 s") && s.hellos.length > hellos, 15000);
+    local("add", f, "rect", "--at", "200,0", "--id", "r2");
+    s.mode = "normal";
+    await b.until("and gets through when the server answers again", () => !!s.room.streams.board.get("r2"), 15000);
+    // the same deadline in mid-session: a second welcome naming a seq that never comes
+    const count = () => b.err.split("didn't bring this board up to date").length - 1, n0 = count();
+    for (const c of [...s.room.conns]) c.send({ t: "welcome", seq: 1e9, role: "editor", user: "ada" });
+    await b.until("it gives up on a session that falls behind for good", () => count() > n0, 15000);
+    local("add", f, "rect", "--at", "400,0", "--id", "r3");
+    await b.until("and is back afterwards", () => !!s.room.streams.board.get("r3"), 15000);
+    expect(b.err).not.toContain(TOKEN);
+  } finally { await b?.stop(); s.stop(); done(dir); }
+}, 60000);
