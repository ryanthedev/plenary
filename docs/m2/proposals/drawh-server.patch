+test("--server is the switch only where drawh's own options go: after a command word or `--` it is text, as before", () => {
+  const dir = scratch(), f = `${dir}/b.excalidraw`;
+  try {
+    local("add", f, "rect", "--at", "0,0", "--id", "r1");
+    const texts = () => JSON.parse(readFileSync(f, "utf8")).elements.filter(e => e.type === "text" && !e.isDeleted).map(e => e.text).sort();
+    expect(local("text", f, "--at", "0,200", "--", "--server").code).toBe(0);
+    expect(local("text", f, "--at", "0,400", "--", "--server=prod").code).toBe(0);
+    expect(local("label", f, "r1", "--", "--server").code).toBe(0);
+    expect(texts()).toEqual(["--server", "--server", "--server=prod"]);
+    // a mistake stays the same mistake: the usual parser's error, not the bridge's
+    const typo = local("text", f, "--server", "--at", "0,0");
+    expect([typo.code, typo.err.includes("drawh --server"), typo.err.includes("usage: drawh ")]).toEqual([2, false, true]);
+    // the command words the switch looks for are drawh's commands, all of them
+    const listed = readFileSync(DRAWH, "utf8").match(/^COMMANDS = \(([^)]*)\)/m)[1].match(/[a-z]+/g).sort();
+    const real = local("-h").out.match(/\{([a-z,]+)\}/)[1].split(",").sort();
+    expect(listed).toEqual(real);
+  } finally { done(dir); }
