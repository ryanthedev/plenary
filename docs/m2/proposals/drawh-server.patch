+// drawh --server: the process that holds the socket. Started by drawh (node 22+ or bun: both have a
+// WebSocket built in), never by the pane. The deciding is in bridge.js, the file writing in files.js;
+// this file is the socket, the timers and the exit codes.
+//
+//   PLENARY_TOKEN=... node plenary.js URL BOARD FILE [--once] [--insecure]
+//
+// The token comes in through the environment only (not argv), goes out only inside the hello message, and
+// is never printed or written to disk. Exit codes with --once: 0 file and board agree; 2 they agree except
+// for changes in the file that could not be sent (refused, or a read-only role); 1 anything else.
+//
+// For tests: DRAWH_STATE_DIR (where sync state goes), DRAWH_RETRY_MS (first reconnect delay, default 1000),
+// DRAWH_STALL_MS (how long a server may take to welcome and catch us up, default 20000),
+// DRAWH_WRITE=link (replace the file the two-step way, see files.js), DRAWH_PYTHON (set by drawh).
+
+import { readFileSync, writeFileSync, renameSync, mkdirSync, statSync, watchFile } from "node:fs";
+import { createHash } from "node:crypto";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import { Bridge } from "./bridge.js";
+import { BoardFile, LINK_WARNING, NO_SAFE_WRITE } from "./files.js";
+import { jsonCodec } from "../protocol/codec.js";
+
+const token = process.env.PLENARY_TOKEN ?? "";
+delete process.env.PLENARY_TOKEN;
+const [server, board, file, ...flags] = process.argv.slice(2);
+const once = flags.includes("--once"), insecure = flags.includes("--insecure");
+const ms = (name, fallback) => { const n = Number(process.env[name]); return Number.isFinite(n) && n > 0 ? n : fallback; };
+const RETRY = ms("DRAWH_RETRY_MS", 1000), RETRY_MAX = RETRY * 30, STALL = ms("DRAWH_STALL_MS", 20000);
+
+const say = line => process.stderr.write(`drawh: ${token ? String(line).split(token).join("***") : line}\n`);
+const die = (line, code = 1) => { say(line); process.exit(code); };
+
+if (!server || !board || !file) die("usage: drawh --server URL --board ID [--token T] [--once] FILE");
+if (!token) die("--server needs a token: --token T, or PLENARY_TOKEN in the environment");
+if (typeof WebSocket !== "function") die("--server needs node 22 or later, or bun (a built-in WebSocket)");
+
+let url;
+try { url = new URL(server); } catch { die("--server must be a URL (wss://host/path)"); }
+if (url.protocol === "http:") url.protocol = "ws:";
+if (url.protocol === "https:") url.protocol = "wss:";
+if (url.protocol !== "ws:" && url.protocol !== "wss:") die("--server must be a ws://, wss://, http:// or https:// URL");
+// The token never rides in the URL: not as user:password, not as a query (URLs end up in logs and proxies).
+if (url.username || url.password) die("no credentials in the URL: the token goes in --token or PLENARY_TOKEN");
+// (Its text is looked for raw and under every decoding a URL parser could give it, up to three layers deep,
+// each layer with `+` kept and with `+` read as a space (a base64 token has `+`); only for a token long
+// enough that finding it isn't chance: a two-letter dev token that happens to be the board's name is not a leak.)
+const decodings = s => {
+  let all = new Set([s]), layer = [s];
+  for (let i = 0; i < 3; i++) {
+    const next = [];
+    for (const t of layer) for (const u of [t, t.replace(/\+/g, " ")]) { try { const d = decodeURIComponent(u); if (!all.has(d)) { all.add(d); next.push(d); } } catch {} }
+    layer = next;
+  }
+  return [...all];
+};
+const inUrl = token.length >= 8 && [server, url.href].flatMap(decodings).some(s => s.includes(token));
+if ([...url.searchParams.keys()].some(k => /token|secret|passw|auth|key|credential/i.test(k)) || inUrl)
+  die("no token in the URL: it goes in --token or PLENARY_TOKEN, and travels in the first message only");
+const local = ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
+if (url.protocol === "ws:" && !local && !insecure) die("refusing to send a token over ws:// to another machine: use wss://, or --insecure");
+const where = `${url.host}${url.pathname === "/" ? "" : url.pathname}`;
+try { if (statSync(file).isDirectory()) die(`${file} is a folder, not a board file`); } catch (e) { if (e.code !== "ENOENT") die(`can't use ${file}: ${e.message}`); }
+
+// Where the file and the board last agreed, so the next run asks only for what came after. Kept out of the
+// board's folder (the pane watches it), named by a hash of server, board and file.
+const stateDir = process.env.DRAWH_STATE_DIR || join(homedir(), ".cache", "herdr-draw", "plenary");
+const statePath = join(stateDir, createHash("sha1").update(`${url.href}\n${board}\n${file}`).digest("hex").slice(0, 20) + ".json");
+const readState = () => { try { return JSON.parse(readFileSync(statePath, "utf8")); } catch { return null; } };
+
+const disk = new BoardFile(file, { python: process.env.DRAWH_PYTHON || "python3", mode: process.env.DRAWH_WRITE === "link" ? "link" : "swap", warn: say });
+if (disk.mode === "link") say(LINK_WARNING);          // asked for by DRAWH_WRITE; a disk that can't swap says so at the first write
+const bridge = new Bridge({ board, saved: readState(), warn: say, read: () => disk.read(), write: (text, expected) => disk.replace(text, expected) });
+
+let saved = null;
+function saveState() {
+  const at = bridge.replica.applied;
+  if (!bridge.caughtUp() || at === saved) return;
+  try {
+    mkdirSync(stateDir, { recursive: true });
+    const tmp = `${statePath}.${process.pid}.tmp`; writeFileSync(tmp, JSON.stringify(bridge.state())); renameSync(tmp, statePath);
+    saved = at;
+  } catch (e) { say(`couldn't save sync state: ${e.message}`); }
+}
+
+let ws = null, delay = RETRY, timer = null, stall = null, behind = null, lastErr = null, lastSave = 0, over = false;
+function finish(code) { over = true; saveState(); try { ws?.close(); } catch {} process.exit(code); }
+
+function pass() {
+  timer = null;
+  let ok = false;
+  try { ok = bridge.sync(); lastErr = null; }
+  // (NO_SAFE_WRITE was said already, by files.js, once: not again behind "can't write")
+  catch (e) { if (e.message !== lastErr && e.message !== NO_SAFE_WRITE) say(`can't write ${file}: ${e.message}`); lastErr = e.message; if (once) finish(1); }
+  if (!ok) { if (bridge.again) soon(); return; }
+  if (bridge.settled()) {
+    delay = RETRY;                                   // a connection that got everything through is a healthy one
+    if (once) {
+      if (bridge.held) { say(`${bridge.held} change${bridge.held === 1 ? "" : "s"} in this file did not reach the board`); finish(2); }
+      finish(0);
+    }
+  }
+  if (Date.now() - lastSave > 1000) { lastSave = Date.now(); saveState(); }
+}
+const soon = () => { if (!timer && !over) timer = setTimeout(pass, 20); };
+
+// Drop this socket and try again after the current delay, which doubles until something gets through.
+function retry(why) {
+  const old = ws; ws = null; behind = null;
+  try { old?.close(); } catch {}
+  bridge.closed();
+  if (over) return;
+  if (once) die(why);
+  say(`${why}; trying again in ${delay / 1000} s`);
+  setTimeout(connect, delay); delay = Math.min(delay * 2, RETRY_MAX);
+}
+
+function connect() {
+  const mine = ws = new WebSocket(url.href);   // no headers, no subprotocol: nothing but the URL leaves before hello
+  // One deadline for being behind, at any time: from the socket opening to caught up, and again whenever a
+  // later message (a second welcome with a seq that never comes) leaves the bridge waiting. A server that
+  // accepts and says nothing, or names a seq it never delivers, doesn't get to hold the bridge silent forever.
+  behind = Date.now();
+  mine.onopen = () => { bridge.open(token, m => { if (mine === ws && mine.readyState === 1) mine.send(jsonCodec.encode(m)); }); };
+  mine.onmessage = ev => {
+    if (mine !== ws) return;
+    let msg;
+    try { msg = jsonCodec.decode(ev.data); } catch { msg = undefined; }   // not JSON text: the bridge calls it nonsense
+    bridge.receive(msg);
+    if (bridge.fatal) die(bridge.fatal);
+    if (bridge.reconnect) {
+      // Start over from the room's copy: at once after a refused op or the wrong room, after a wait when
+      // the room said it is unavailable or sent something that can't be read.
+      if (bridge.later) return retry(`${where} is unavailable or sent something unreadable`);
+      ws = null; behind = null; try { mine.close(); } catch {} bridge.closed(); connect(); return;
+    }
+    if (msg?.t === "welcome") say(`connected to ${where}, board ${board}, as ${bridge.user} (${bridge.role}), at ${msg.seq}`);
+    if (bridge.caughtUp()) behind = null; else behind ??= Date.now();
+    soon();
+  };
+  mine.onerror = () => {};
+  mine.onclose = () => { if (mine === ws && !over) retry(once ? `lost the connection to ${where}` : `not connected to ${where}`); };
+}
+
+stall = setInterval(() => { if (ws && behind !== null && Date.now() - behind > STALL) retry(`${where} didn't bring this board up to date within ${STALL / 1000} s`); }, Math.max(20, Math.min(1000, STALL / 4)));
+watchFile(file, { interval: 250 }, soon);   // by stat: the pane and drawh replace the file by rename
+process.on("SIGINT", () => finish(0));
+process.on("SIGTERM", () => finish(0));
+if (once) setTimeout(() => die(`gave up after 30 s: ${where} never caught up`), 30000);
+connect();
